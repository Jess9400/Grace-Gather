{"book":{"code":"2JN","name":"\u0412\u0442\u043e\u0440\u043e\u0435 \u043f\u043e\u0441\u043b\u0430\u043d\u0438\u0435 \u0418\u043e\u0430\u043d\u043d\u0430","chapters":1,"verses":13,"sourceBaseUrl":"https://ebible.org/russyn/","sourceChapterDigits":2,"sourceEdition":"\u0421\u0438\u043d\u043e\u0434\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u0435\u0440\u0435\u0432\u043e\u0434","sourceAttribution":"\u0421\u0438\u043d\u043e\u0434\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u0435\u0440\u0435\u0432\u043e\u0434 (Russian Synodal translation). Public domain. Text supplied by eBible.org. Six New Testament selections only.","sourceLicenseUrl":"https://ebible.org/russyn/copyright.htm"},"chapters":{"1":[{"id":"2JN.1.1","number":"1","text":"\u0421\u0442\u0430\u0440\u0435\u0446 \u0438\u0437\u0431\u0440\u0430\u043d\u043d\u043e\u0439 \u0433\u043e\u0441\u043f\u043e\u0436\u0435 \u0438 \u0434\u0435\u0442\u044f\u043c \u0435\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u044f \u043b\u044e\u0431\u043b\u044e \u043f\u043e \u0438\u0441\u0442\u0438\u043d\u0435, \u0438 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u044f, \u043d\u043e \u0438 \u0432\u0441\u0435, \u043f\u043e\u0437\u043d\u0430\u0432\u0448\u0438\u0435 \u0438\u0441\u0442\u0438\u043d\u0443,","notes":[]},{"id":"2JN.1.2","number":"2","text":"\u0440\u0430\u0434\u0438 \u0438\u0441\u0442\u0438\u043d\u044b, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u0440\u0435\u0431\u044b\u0432\u0430\u0435\u0442 \u0432 \u043d\u0430\u0441 \u0438 \u0431\u0443\u0434\u0435\u0442 \u0441 \u043d\u0430\u043c\u0438 \u0432\u043e\u0432\u0435\u043a.","notes":[]},{"id":"2JN.1.3","number":"3","text":"\u0414\u0430 \u0431\u0443\u0434\u0435\u0442 \u0441 \u0432\u0430\u043c\u0438 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0442\u044c, \u043c\u0438\u043b\u043e\u0441\u0442\u044c, \u043c\u0438\u0440 \u043e\u0442 \u0411\u043e\u0433\u0430 \u041e\u0442\u0446\u0430 \u0438 \u043e\u0442 \u0413\u043e\u0441\u043f\u043e\u0434\u0430 \u0418\u0438\u0441\u0443\u0441\u0430 \u0425\u0440\u0438\u0441\u0442\u0430, \u0421\u044b\u043d\u0430 \u041e\u0442\u0447\u0435\u0433\u043e, \u0432 \u0438\u0441\u0442\u0438\u043d\u0435 \u0438 \u043b\u044e\u0431\u0432\u0438.","notes":[]},{"id":"2JN.1.4","number":"4","text":"\u042f \u0432\u0435\u0441\u044c\u043c\u0430 \u043e\u0431\u0440\u0430\u0434\u043e\u0432\u0430\u043b\u0441\u044f, \u0447\u0442\u043e \u043d\u0430\u0448\u0435\u043b \u0438\u0437 \u0434\u0435\u0442\u0435\u0439 \u0442\u0432\u043e\u0438\u0445, \u0445\u043e\u0434\u044f\u0449\u0438\u0445 \u0432 \u0438\u0441\u0442\u0438\u043d\u0435, \u043a\u0430\u043a \u043c\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0438 \u0437\u0430\u043f\u043e\u0432\u0435\u0434\u044c \u043e\u0442 \u041e\u0442\u0446\u0430.","notes":[]},{"id":"2JN.1.5","number":"5","text":"\u0418 \u043d\u044b\u043d\u0435 \u043f\u0440\u043e\u0448\u0443 \u0442\u0435\u0431\u044f, \u0433\u043e\u0441\u043f\u043e\u0436\u0430, \u043d\u0435 \u043a\u0430\u043a \u043d\u043e\u0432\u0443\u044e \u0437\u0430\u043f\u043e\u0432\u0435\u0434\u044c \u043f\u0440\u0435\u0434\u043f\u0438\u0441\u044b\u0432\u0430\u044f \u0442\u0435\u0431\u0435, \u043d\u043e \u0442\u0443, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0438\u043c\u0435\u0435\u043c \u043e\u0442 \u043d\u0430\u0447\u0430\u043b\u0430, \u0447\u0442\u043e\u0431\u044b \u043c\u044b \u043b\u044e\u0431\u0438\u043b\u0438 \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430.","notes":[]},{"id":"2JN.1.6","number":"6","text":"\u041b\u044e\u0431\u043e\u0432\u044c \u0436\u0435 \u0441\u043e\u0441\u0442\u043e\u0438\u0442 \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e\u0431\u044b \u043c\u044b \u043f\u043e\u0441\u0442\u0443\u043f\u0430\u043b\u0438 \u043f\u043e \u0437\u0430\u043f\u043e\u0432\u0435\u0434\u044f\u043c \u0415\u0433\u043e. \u042d\u0442\u043e \u0442\u0430 \u0437\u0430\u043f\u043e\u0432\u0435\u0434\u044c, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0432\u044b \u0441\u043b\u044b\u0448\u0430\u043b\u0438 \u043e\u0442 \u043d\u0430\u0447\u0430\u043b\u0430, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0441\u0442\u0443\u043f\u0430\u043b\u0438 \u043f\u043e \u043d\u0435\u0439.","notes":[]},{"id":"2JN.1.7","number":"7","text":"\u0418\u0431\u043e \u043c\u043d\u043e\u0433\u0438\u0435 \u043e\u0431\u043e\u043b\u044c\u0441\u0442\u0438\u0442\u0435\u043b\u0438 \u0432\u043e\u0448\u043b\u0438 \u0432 \u043c\u0438\u0440, \u043d\u0435 \u0438\u0441\u043f\u043e\u0432\u0435\u0434\u0443\u044e\u0449\u0438\u0435 \u0418\u0438\u0441\u0443\u0441\u0430 \u0425\u0440\u0438\u0441\u0442\u0430, \u043f\u0440\u0438\u0448\u0435\u0434\u0448\u0435\u0433\u043e \u0432\u043e \u043f\u043b\u043e\u0442\u0438: \u0442\u0430\u043a\u043e\u0439 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0435\u0441\u0442\u044c \u043e\u0431\u043e\u043b\u044c\u0441\u0442\u0438\u0442\u0435\u043b\u044c \u0438 \u0430\u043d\u0442\u0438\u0445\u0440\u0438\u0441\u0442.","notes":[]},{"id":"2JN.1.8","number":"8","text":"\u041d\u0430\u0431\u043b\u044e\u0434\u0430\u0439\u0442\u0435 \u0437\u0430 \u0441\u043e\u0431\u043e\u044e, \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u043c \u043d\u0435 \u043f\u043e\u0442\u0435\u0440\u044f\u0442\u044c \u0442\u043e\u0433\u043e, \u043d\u0430\u0434 \u0447\u0435\u043c \u043c\u044b \u0442\u0440\u0443\u0434\u0438\u043b\u0438\u0441\u044c, \u043d\u043e \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u043f\u043e\u043b\u043d\u0443\u044e \u043d\u0430\u0433\u0440\u0430\u0434\u0443.","notes":[]},{"id":"2JN.1.9","number":"9","text":"\u0412\u0441\u044f\u043a\u0438\u0439, \u043f\u0440\u0435\u0441\u0442\u0443\u043f\u0430\u044e\u0449\u0438\u0439 \u0443\u0447\u0435\u043d\u0438\u0435 \u0425\u0440\u0438\u0441\u0442\u043e\u0432\u043e \u0438 \u043d\u0435 \u043f\u0440\u0435\u0431\u044b\u0432\u0430\u044e\u0449\u0438\u0439 \u0432 \u043d\u0435\u043c, \u043d\u0435 \u0438\u043c\u0435\u0435\u0442 \u0411\u043e\u0433\u0430; \u043f\u0440\u0435\u0431\u044b\u0432\u0430\u044e\u0449\u0438\u0439 \u0432 \u0443\u0447\u0435\u043d\u0438\u0438 \u0425\u0440\u0438\u0441\u0442\u043e\u0432\u043e\u043c \u0438\u043c\u0435\u0435\u0442 \u0438 \u041e\u0442\u0446\u0430 \u0438 \u0421\u044b\u043d\u0430.","notes":[]},{"id":"2JN.1.10","number":"10","text":"\u041a\u0442\u043e \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u0442 \u043a \u0432\u0430\u043c \u0438 \u043d\u0435 \u043f\u0440\u0438\u043d\u043e\u0441\u0438\u0442 \u0441\u0435\u0433\u043e \u0443\u0447\u0435\u043d\u0438\u044f, \u0442\u043e\u0433\u043e \u043d\u0435 \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0439\u0442\u0435 \u0432 \u0434\u043e\u043c \u0438 \u043d\u0435 \u043f\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0439\u0442\u0435 \u0435\u0433\u043e.","notes":[]},{"id":"2JN.1.11","number":"11","text":"\u0418\u0431\u043e \u043f\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0439 \u0435\u0433\u043e \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u0435\u0442 \u0432 \u0437\u043b\u044b\u0445 \u0434\u0435\u043b\u0430\u0445 \u0435\u0433\u043e.","notes":[]},{"id":"2JN.1.12","number":"12","text":"\u041c\u043d\u043e\u0433\u043e\u0435 \u0438\u043c\u0435\u044e \u043f\u0438\u0441\u0430\u0442\u044c \u0432\u0430\u043c, \u043d\u043e \u043d\u0435 \u0445\u043e\u0447\u0443 \u043d\u0430 \u0431\u0443\u043c\u0430\u0433\u0435 \u0447\u0435\u0440\u043d\u0438\u043b\u0430\u043c\u0438, \u0430 \u043d\u0430\u0434\u0435\u044e\u0441\u044c \u043f\u0440\u0438\u0434\u0442\u0438 \u043a \u0432\u0430\u043c \u0438 \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c \u0443\u0441\u0442\u0430\u043c\u0438 \u043a \u0443\u0441\u0442\u0430\u043c, \u0447\u0442\u043e\u0431\u044b \u0440\u0430\u0434\u043e\u0441\u0442\u044c \u0432\u0430\u0448\u0430 \u0431\u044b\u043b\u0430 \u043f\u043e\u043b\u043d\u0430.","notes":[]},{"id":"2JN.1.13","number":"13","text":"\u041f\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0442 \u0442\u0435\u0431\u044f \u0434\u0435\u0442\u0438 \u0441\u0435\u0441\u0442\u0440\u044b \u0442\u0432\u043e\u0435\u0439 \u0438\u0437\u0431\u0440\u0430\u043d\u043d\u043e\u0439. \u0410\u043c\u0438\u043d\u044c.","notes":[]}]}}
