{"book":{"code":"JOL","name":"\u041a\u043d\u0438\u0433\u0430 \u043f\u0440\u043e\u0440\u043e\u043a\u0430 \u0418\u043e\u0438\u043b\u044f","chapters":3,"verses":73,"sourceBaseUrl":"https://ebible.org/russyn/","sourceChapterDigits":2,"sourceEdition":"\u0421\u0438\u043d\u043e\u0434\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u0435\u0440\u0435\u0432\u043e\u0434","sourceAttribution":"\u0421\u0438\u043d\u043e\u0434\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u0435\u0440\u0435\u0432\u043e\u0434 (Russian Synodal translation). Public domain. Text supplied by eBible.org. Six New Testament selections only.","sourceLicenseUrl":"https://ebible.org/russyn/copyright.htm"},"chapters":{"1":[{"id":"JOL.1.1","number":"1","text":"\u0421\u043b\u043e\u0432\u043e \u0413\u043e\u0441\u043f\u043e\u0434\u043d\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0431\u044b\u043b\u043e \u043a \u0418\u043e\u0438\u043b\u044e, \u0441\u044b\u043d\u0443 \u0412\u0430\u0444\u0443\u0438\u043b\u0430.","notes":[]},{"id":"JOL.1.2","number":"2","text":"\u0421\u043b\u0443\u0448\u0430\u0439\u0442\u0435 \u044d\u0442\u043e, \u0441\u0442\u0430\u0440\u0446\u044b, \u0438 \u0432\u043d\u0438\u043c\u0430\u0439\u0442\u0435, \u0432\u0441\u0435 \u0436\u0438\u0442\u0435\u043b\u0438 \u0437\u0435\u043c\u043b\u0438 \u0441\u0435\u0439: \u0431\u044b\u0432\u0430\u043b\u043e \u043b\u0438 \u0442\u0430\u043a\u043e\u0435 \u0432\u043e \u0434\u043d\u0438 \u0432\u0430\u0448\u0438 \u0438\u043b\u0438 \u0432\u043e \u0434\u043d\u0438 \u043e\u0442\u0446\u043e\u0432 \u0432\u0430\u0448\u0438\u0445?","notes":[]},{"id":"JOL.1.3","number":"3","text":"\u041f\u0435\u0440\u0435\u0434\u0430\u0439\u0442\u0435 \u043e\u0431 \u044d\u0442\u043e\u043c \u0434\u0435\u0442\u044f\u043c \u0432\u0430\u0448\u0438\u043c; \u0430 \u0434\u0435\u0442\u0438 \u0432\u0430\u0448\u0438 \u043f\u0443\u0441\u0442\u044c \u0441\u043a\u0430\u0436\u0443\u0442 \u0441\u0432\u043e\u0438\u043c \u0434\u0435\u0442\u044f\u043c, \u0430 \u0438\u0445 \u0434\u0435\u0442\u0438 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u043c\u0443 \u0440\u043e\u0434\u0443:","notes":[]},{"id":"JOL.1.4","number":"4","text":"\u043e\u0441\u0442\u0430\u0432\u0448\u0435\u0435\u0441\u044f \u043e\u0442 \u0433\u0443\u0441\u0435\u043d\u0438\u0446\u044b \u0435\u043b\u0430 \u0441\u0430\u0440\u0430\u043d\u0447\u0430, \u043e\u0441\u0442\u0430\u0432\u0448\u0435\u0435\u0441\u044f \u043e\u0442 \u0441\u0430\u0440\u0430\u043d\u0447\u0438 \u0435\u043b\u0438 \u0447\u0435\u0440\u0432\u0438, \u0430 \u043e\u0441\u0442\u0430\u0432\u0448\u0435\u0435\u0441\u044f \u043e\u0442 \u0447\u0435\u0440\u0432\u0435\u0439 \u0434\u043e\u0435\u043b\u0438 \u0436\u0443\u043a\u0438.","notes":[]},{"id":"JOL.1.5","number":"5","text":"\u041f\u0440\u043e\u0431\u0443\u0434\u0438\u0442\u0435\u0441\u044c, \u043f\u044c\u044f\u043d\u0438\u0446\u044b, \u0438 \u043f\u043b\u0430\u0447\u044c\u0442\u0435 \u0438 \u0440\u044b\u0434\u0430\u0439\u0442\u0435, \u0432\u0441\u0435 \u043f\u044c\u044e\u0449\u0438\u0435 \u0432\u0438\u043d\u043e, \u043e \u0432\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043d\u043e\u043c \u0441\u043e\u043a\u0435, \u0438\u0431\u043e \u043e\u043d \u043e\u0442\u043d\u044f\u0442 \u043e\u0442 \u0443\u0441\u0442 \u0432\u0430\u0448\u0438\u0445!","notes":[]},{"id":"JOL.1.6","number":"6","text":"\u0418\u0431\u043e \u043f\u0440\u0438\u0448\u0435\u043b \u043d\u0430 \u0437\u0435\u043c\u043b\u044e \u041c\u043e\u044e \u043d\u0430\u0440\u043e\u0434 \u0441\u0438\u043b\u044c\u043d\u044b\u0439 \u0438 \u0431\u0435\u0441\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0439; \u0437\u0443\u0431\u044b \u0443 \u043d\u0435\u0433\u043e - \u0437\u0443\u0431\u044b \u043b\u044c\u0432\u0438\u043d\u044b\u0435, \u0438 \u0447\u0435\u043b\u044e\u0441\u0442\u0438 \u0443 \u043d\u0435\u0433\u043e - \u043a\u0430\u043a \u0443 \u043b\u044c\u0432\u0438\u0446\u044b.","notes":[]},{"id":"JOL.1.7","number":"7","text":"\u041e\u043f\u0443\u0441\u0442\u043e\u0448\u0438\u043b \u043e\u043d \u0432\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043d\u0443\u044e \u043b\u043e\u0437\u0443 \u041c\u043e\u044e, \u0438 \u0441\u043c\u043e\u043a\u043e\u0432\u043d\u0438\u0446\u0443 \u041c\u043e\u044e \u043e\u0431\u043b\u043e\u043c\u0430\u043b, \u043e\u0431\u043e\u0434\u0440\u0430\u043b \u0435\u0435 \u0434\u043e\u0433\u043e\u043b\u0430, \u0438 \u0431\u0440\u043e\u0441\u0438\u043b; \u0441\u0434\u0435\u043b\u0430\u043b\u0438\u0441\u044c \u0431\u0435\u043b\u044b\u043c\u0438 \u0432\u0435\u0442\u0432\u0438 \u0435\u0435.","notes":[]},{"id":"JOL.1.8","number":"8","text":"\u0420\u044b\u0434\u0430\u0439, \u043a\u0430\u043a \u043c\u043e\u043b\u043e\u0434\u0430\u044f \u0436\u0435\u043d\u0430, \u043f\u0440\u0435\u043f\u043e\u044f\u0441\u0430\u0432\u0448\u0438\u0441\u044c \u0432\u0440\u0435\u0442\u0438\u0449\u0435\u043c, \u043e \u043c\u0443\u0436\u0435 \u044e\u043d\u043e\u0441\u0442\u0438 \u0441\u0432\u043e\u0435\u0439!","notes":[]},{"id":"JOL.1.9","number":"9","text":"\u041f\u0440\u0435\u043a\u0440\u0430\u0442\u0438\u043b\u043e\u0441\u044c \u0445\u043b\u0435\u0431\u043d\u043e\u0435 \u043f\u0440\u0438\u043d\u043e\u0448\u0435\u043d\u0438\u0435 \u0438 \u0432\u043e\u0437\u043b\u0438\u044f\u043d\u0438\u0435 \u0432 \u0434\u043e\u043c\u0435 \u0413\u043e\u0441\u043f\u043e\u0434\u043d\u0435\u043c; \u043f\u043b\u0430\u0447\u0443\u0442 \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u043a\u0438, \u0441\u043b\u0443\u0436\u0438\u0442\u0435\u043b\u0438 \u0413\u043e\u0441\u043f\u043e\u0434\u043d\u0438.","notes":[]},{"id":"JOL.1.10","number":"10","text":"\u041e\u043f\u0443\u0441\u0442\u043e\u0448\u0435\u043d\u043e \u043f\u043e\u043b\u0435, \u0441\u0435\u0442\u0443\u0435\u0442 \u0437\u0435\u043c\u043b\u044f; \u0438\u0431\u043e \u0438\u0441\u0442\u0440\u0435\u0431\u043b\u0435\u043d \u0445\u043b\u0435\u0431, \u0432\u044b\u0441\u043e\u0445 \u0432\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043d\u044b\u0439 \u0441\u043e\u043a, \u0437\u0430\u0432\u044f\u043b\u0430 \u043c\u0430\u0441\u043b\u0438\u043d\u0430.","notes":[]},{"id":"JOL.1.11","number":"11","text":"\u041a\u0440\u0430\u0441\u043d\u0435\u0439\u0442\u0435 \u043e\u0442 \u0441\u0442\u044b\u0434\u0430, \u0437\u0435\u043c\u043b\u0435\u0434\u0435\u043b\u044c\u0446\u044b, \u0440\u044b\u0434\u0430\u0439\u0442\u0435, \u0432\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u0430\u0440\u0438, \u043e \u043f\u0448\u0435\u043d\u0438\u0446\u0435 \u0438 \u044f\u0447\u043c\u0435\u043d\u0435, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043f\u043e\u0433\u0438\u0431\u043b\u0430 \u0436\u0430\u0442\u0432\u0430 \u0432 \u043f\u043e\u043b\u0435,","notes":[]},{"id":"JOL.1.12","number":"12","text":"\u0437\u0430\u0441\u043e\u0445\u043b\u0430 \u0432\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043d\u0430\u044f \u043b\u043e\u0437\u0430 \u0438 \u0441\u043c\u043e\u043a\u043e\u0432\u043d\u0438\u0446\u0430 \u0437\u0430\u0432\u044f\u043b\u0430; \u0433\u0440\u0430\u043d\u0430\u0442\u043e\u0432\u043e\u0435 \u0434\u0435\u0440\u0435\u0432\u043e, \u043f\u0430\u043b\u044c\u043c\u0430 \u0438 \u044f\u0431\u043b\u043e\u043d\u044f, \u0432\u0441\u0435 \u0434\u0435\u0440\u0435\u0432\u0430 \u0432 \u043f\u043e\u043b\u0435 \u043f\u043e\u0441\u043e\u0445\u043b\u0438; \u043f\u043e\u0442\u043e\u043c\u0443 \u0438 \u0432\u0435\u0441\u0435\u043b\u044c\u0435 \u0443 \u0441\u044b\u043d\u043e\u0432 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u0438\u0445 \u0438\u0441\u0447\u0435\u0437\u043b\u043e.","notes":[]},{"id":"JOL.1.13","number":"13","text":"\u041f\u0440\u0435\u043f\u043e\u044f\u0448\u044c\u0442\u0435\u0441\u044c \u0432\u0440\u0435\u0442\u0438\u0449\u0435\u043c \u0438 \u043f\u043b\u0430\u0447\u044c\u0442\u0435, \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u043a\u0438! \u0440\u044b\u0434\u0430\u0439\u0442\u0435, \u0441\u043b\u0443\u0436\u0438\u0442\u0435\u043b\u0438 \u0430\u043b\u0442\u0430\u0440\u044f! \u0432\u043e\u0439\u0434\u0438\u0442\u0435, \u043d\u043e\u0447\u0443\u0439\u0442\u0435 \u0432\u043e \u0432\u0440\u0435\u0442\u0438\u0449\u0430\u0445, \u0441\u043b\u0443\u0436\u0438\u0442\u0435\u043b\u0438 \u0411\u043e\u0433\u0430 \u043c\u043e\u0435\u0433\u043e! \u0438\u0431\u043e \u043d\u0435 \u0441\u0442\u0430\u043b\u043e \u0432 \u0434\u043e\u043c\u0435 \u0411\u043e\u0433\u0430 \u0432\u0430\u0448\u0435\u0433\u043e \u0445\u043b\u0435\u0431\u043d\u043e\u0433\u043e \u043f\u0440\u0438\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0438 \u0432\u043e\u0437\u043b\u0438\u044f\u043d\u0438\u044f.","notes":[]},{"id":"JOL.1.14","number":"14","text":"\u041d\u0430\u0437\u043d\u0430\u0447\u044c\u0442\u0435 \u043f\u043e\u0441\u0442, \u043e\u0431\u044a\u044f\u0432\u0438\u0442\u0435 \u0442\u043e\u0440\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435 \u0441\u043e\u0431\u0440\u0430\u043d\u0438\u0435, \u0441\u043e\u0437\u043e\u0432\u0438\u0442\u0435 \u0441\u0442\u0430\u0440\u0446\u0435\u0432 \u0438 \u0432\u0441\u0435\u0445 \u0436\u0438\u0442\u0435\u043b\u0435\u0439 \u0441\u0442\u0440\u0430\u043d\u044b \u0441\u0435\u0439 \u0432 \u0434\u043e\u043c \u0413\u043e\u0441\u043f\u043e\u0434\u0430 \u0411\u043e\u0433\u0430 \u0432\u0430\u0448\u0435\u0433\u043e \u0438 \u0432\u0437\u044b\u0432\u0430\u0439\u0442\u0435 \u043a \u0413\u043e\u0441\u043f\u043e\u0434\u0443.","notes":[]},{"id":"JOL.1.15","number":"15","text":"\u041e, \u043a\u0430\u043a\u043e\u0439 \u0434\u0435\u043d\u044c! \u0438\u0431\u043e \u0434\u0435\u043d\u044c \u0413\u043e\u0441\u043f\u043e\u0434\u0435\u043d\u044c \u0431\u043b\u0438\u0437\u043e\u043a; \u043a\u0430\u043a \u043e\u043f\u0443\u0441\u0442\u043e\u0448\u0435\u043d\u0438\u0435 \u043e\u0442 \u0412\u0441\u0435\u043c\u043e\u0433\u0443\u0449\u0435\u0433\u043e \u043f\u0440\u0438\u0434\u0435\u0442 \u043e\u043d.","notes":[]},{"id":"JOL.1.16","number":"16","text":"\u041d\u0435 \u043f\u0440\u0435\u0434 \u043d\u0430\u0448\u0438\u043c\u0438 \u043b\u0438 \u0433\u043b\u0430\u0437\u0430\u043c\u0438 \u043e\u0442\u043d\u0438\u043c\u0430\u0435\u0442\u0441\u044f \u043f\u0438\u0449\u0430, \u043e\u0442 \u0434\u043e\u043c\u0430 \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0435\u0433\u043e - \u0432\u0435\u0441\u0435\u043b\u044c\u0435 \u0438 \u0440\u0430\u0434\u043e\u0441\u0442\u044c?","notes":[]},{"id":"JOL.1.17","number":"17","text":"\u0418\u0441\u0442\u043b\u0435\u043b\u0438 \u0437\u0435\u0440\u043d\u0430 \u043f\u043e\u0434 \u0433\u043b\u044b\u0431\u0430\u043c\u0438 \u0441\u0432\u043e\u0438\u043c\u0438, \u043e\u043f\u0443\u0441\u0442\u0435\u043b\u0438 \u0436\u0438\u0442\u043d\u0438\u0446\u044b, \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043d\u044b \u043a\u043b\u0430\u0434\u043e\u0432\u044b\u0435, \u0438\u0431\u043e \u043d\u0435 \u0441\u0442\u0430\u043b\u043e \u0445\u043b\u0435\u0431\u0430.","notes":[]},{"id":"JOL.1.18","number":"18","text":"\u041a\u0430\u043a \u0441\u0442\u043e\u043d\u0435\u0442 \u0441\u043a\u043e\u0442! \u0443\u043d\u044b\u043b\u043e \u0445\u043e\u0434\u044f\u0442 \u0441\u0442\u0430\u0434\u0430 \u0432\u043e\u043b\u043e\u0432, \u0438\u0431\u043e \u043d\u0435\u0442 \u0434\u043b\u044f \u043d\u0438\u0445 \u043f\u0430\u0436\u0438\u0442\u0438; \u0442\u043e\u043c\u044f\u0442\u0441\u044f \u0438 \u0441\u0442\u0430\u0434\u0430 \u043e\u0432\u0435\u0446.","notes":[]},{"id":"JOL.1.19","number":"19","text":"\u041a \u0422\u0435\u0431\u0435, \u0413\u043e\u0441\u043f\u043e\u0434\u0438, \u0432\u0437\u044b\u0432\u0430\u044e; \u0438\u0431\u043e \u043e\u0433\u043e\u043d\u044c \u043f\u043e\u0436\u0440\u0430\u043b \u0437\u043b\u0430\u0447\u043d\u044b\u0435 \u043f\u0430\u0441\u0442\u0431\u0438\u0449\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0438, \u0438 \u043f\u043b\u0430\u043c\u044f \u043f\u043e\u043f\u0430\u043b\u0438\u043b\u043e \u0432\u0441\u0435 \u0434\u0435\u0440\u0435\u0432\u0430 \u0432 \u043f\u043e\u043b\u0435.","notes":[]},{"id":"JOL.1.20","number":"20","text":"\u0414\u0430\u0436\u0435 \u0438 \u0436\u0438\u0432\u043e\u0442\u043d\u044b\u0435 \u043d\u0430 \u043f\u043e\u043b\u0435 \u0432\u0437\u044b\u0432\u0430\u044e\u0442 \u043a \u0422\u0435\u0431\u0435, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0438\u0441\u0441\u043e\u0445\u043b\u0438 \u043f\u043e\u0442\u043e\u043a\u0438 \u0432\u043e\u0434 \u0438 \u043e\u0433\u043e\u043d\u044c \u0438\u0441\u0442\u0440\u0435\u0431\u0438\u043b \u043f\u0430\u0441\u0442\u0431\u0438\u0449\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0438.","notes":[]}],"2":[{"id":"JOL.2.1","number":"1","text":"\u0422\u0440\u0443\u0431\u0438\u0442\u0435 \u0442\u0440\u0443\u0431\u043e\u044e \u043d\u0430 \u0421\u0438\u043e\u043d\u0435 \u0438 \u0431\u0435\u0439\u0442\u0435 \u0442\u0440\u0435\u0432\u043e\u0433\u0443 \u043d\u0430 \u0441\u0432\u044f\u0442\u043e\u0439 \u0433\u043e\u0440\u0435 \u041c\u043e\u0435\u0439; \u0434\u0430 \u0442\u0440\u0435\u043f\u0435\u0449\u0443\u0442 \u0432\u0441\u0435 \u0436\u0438\u0442\u0435\u043b\u0438 \u0437\u0435\u043c\u043b\u0438, \u0438\u0431\u043e \u043d\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u0442 \u0434\u0435\u043d\u044c \u0413\u043e\u0441\u043f\u043e\u0434\u0435\u043d\u044c, \u0438\u0431\u043e \u043e\u043d \u0431\u043b\u0438\u0437\u043e\u043a -","notes":[]},{"id":"JOL.2.2","number":"2","text":"\u0434\u0435\u043d\u044c \u0442\u044c\u043c\u044b \u0438 \u043c\u0440\u0430\u043a\u0430, \u0434\u0435\u043d\u044c \u043e\u0431\u043b\u0430\u0447\u043d\u044b\u0439 \u0438 \u0442\u0443\u043c\u0430\u043d\u043d\u044b\u0439: \u043a\u0430\u043a \u0443\u0442\u0440\u0435\u043d\u043d\u044f\u044f \u0437\u0430\u0440\u044f, \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u044f\u0435\u0442\u0441\u044f \u043f\u043e \u0433\u043e\u0440\u0430\u043c \u043d\u0430\u0440\u043e\u0434 \u043c\u043d\u043e\u0433\u043e\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0439 \u0438 \u0441\u0438\u043b\u044c\u043d\u044b\u0439, \u043a\u0430\u043a\u043e\u0433\u043e \u043d\u0435 \u0431\u044b\u0432\u0430\u043b\u043e \u043e\u0442 \u0432\u0435\u043a\u0430 \u0438 \u043f\u043e\u0441\u043b\u0435 \u0442\u043e\u0433\u043e \u043d\u0435 \u0431\u0443\u0434\u0435\u0442 \u0432 \u0440\u043e\u0434\u044b \u0440\u043e\u0434\u043e\u0432.","notes":[]},{"id":"JOL.2.3","number":"3","text":"\u041f\u0435\u0440\u0435\u0434 \u043d\u0438\u043c \u043f\u043e\u0436\u0438\u0440\u0430\u0435\u0442 \u043e\u0433\u043e\u043d\u044c, \u0430 \u0437\u0430 \u043d\u0438\u043c \u043f\u0430\u043b\u0438\u0442 \u043f\u043b\u0430\u043c\u044f; \u043f\u0435\u0440\u0435\u0434 \u043d\u0438\u043c \u0437\u0435\u043c\u043b\u044f \u043a\u0430\u043a \u0441\u0430\u0434 \u0415\u0434\u0435\u043c\u0441\u043a\u0438\u0439, \u0430 \u043f\u043e\u0437\u0430\u0434\u0438 \u043d\u0435\u0433\u043e \u0431\u0443\u0434\u0435\u0442 \u043e\u043f\u0443\u0441\u0442\u043e\u0448\u0435\u043d\u043d\u0430\u044f \u0441\u0442\u0435\u043f\u044c, \u0438 \u043d\u0438\u043a\u043e\u043c\u0443 \u043d\u0435 \u0431\u0443\u0434\u0435\u0442 \u0441\u043f\u0430\u0441\u0435\u043d\u0438\u044f \u043e\u0442 \u043d\u0435\u0433\u043e.","notes":[]},{"id":"JOL.2.4","number":"4","text":"\u0412\u0438\u0434 \u0435\u0433\u043e \u043a\u0430\u043a \u0432\u0438\u0434 \u043a\u043e\u043d\u0435\u0439, \u0438 \u0441\u043a\u0430\u0447\u0443\u0442 \u043e\u043d\u0438 \u043a\u0430\u043a \u0432\u0441\u0430\u0434\u043d\u0438\u043a\u0438;","notes":[]},{"id":"JOL.2.5","number":"5","text":"\u0441\u043a\u0430\u0447\u0443\u0442 \u043f\u043e \u0432\u0435\u0440\u0448\u0438\u043d\u0430\u043c \u0433\u043e\u0440 \u043a\u0430\u043a \u0431\u044b \u0441\u043e \u0441\u0442\u0443\u043a\u043e\u043c \u043a\u043e\u043b\u0435\u0441\u043d\u0438\u0446, \u043a\u0430\u043a \u0431\u044b \u0441 \u0442\u0440\u0435\u0441\u043a\u043e\u043c \u043e\u0433\u043d\u0435\u043d\u043d\u043e\u0433\u043e \u043f\u043b\u0430\u043c\u0435\u043d\u0438, \u043f\u043e\u0436\u0438\u0440\u0430\u044e\u0449\u0435\u0433\u043e \u0441\u043e\u043b\u043e\u043c\u0443, \u043a\u0430\u043a \u0441\u0438\u043b\u044c\u043d\u044b\u0439 \u043d\u0430\u0440\u043e\u0434, \u0432\u044b\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u044b\u0439 \u043a \u0431\u0438\u0442\u0432\u0435.","notes":[]},{"id":"JOL.2.6","number":"6","text":"\u041f\u0440\u0438 \u0432\u0438\u0434\u0435 \u0435\u0433\u043e \u0437\u0430\u0442\u0440\u0435\u043f\u0435\u0449\u0443\u0442 \u043d\u0430\u0440\u043e\u0434\u044b, \u0443 \u0432\u0441\u0435\u0445 \u043b\u0438\u0446\u0430 \u043f\u043e\u0431\u043b\u0435\u0434\u043d\u0435\u044e\u0442.","notes":[]},{"id":"JOL.2.7","number":"7","text":"\u041a\u0430\u043a \u0431\u043e\u0440\u0446\u044b, \u0431\u0435\u0433\u0443\u0442 \u043e\u043d\u0438 \u0438, \u043a\u0430\u043a \u0445\u0440\u0430\u0431\u0440\u044b\u0435 \u0432\u043e\u0438\u043d\u044b, \u0432\u043b\u0435\u0437\u0430\u044e\u0442 \u043d\u0430 \u0441\u0442\u0435\u043d\u0443, \u0438 \u043a\u0430\u0436\u0434\u044b\u0439 \u0438\u0434\u0435\u0442 \u0441\u0432\u043e\u0435\u044e \u0434\u043e\u0440\u043e\u0433\u043e\u044e \u0438 \u043d\u0435 \u0441\u0431\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0441 \u043f\u0443\u0442\u0435\u0439 \u0441\u0432\u043e\u0438\u0445.","notes":[]},{"id":"JOL.2.8","number":"8","text":"\u041d\u0435 \u0434\u0430\u0432\u044f\u0442 \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430, \u043a\u0430\u0436\u0434\u044b\u0439 \u0438\u0434\u0435\u0442 \u0441\u0432\u043e\u0435\u044e \u0441\u0442\u0435\u0437\u0435\u044e, \u0438 \u043f\u0430\u0434\u0430\u044e\u0442 \u043d\u0430 \u043a\u043e\u043f\u044c\u044f, \u043d\u043e \u043e\u0441\u0442\u0430\u044e\u0442\u0441\u044f \u043d\u0435\u0432\u0440\u0435\u0434\u0438\u043c\u044b.","notes":[]},{"id":"JOL.2.9","number":"9","text":"\u0411\u0435\u0433\u0430\u044e\u0442 \u043f\u043e \u0433\u043e\u0440\u043e\u0434\u0443, \u043f\u043e\u0434\u043d\u0438\u043c\u0430\u044e\u0442\u0441\u044f \u043d\u0430 \u0441\u0442\u0435\u043d\u044b, \u0432\u043b\u0435\u0437\u0430\u044e\u0442 \u043d\u0430 \u0434\u043e\u043c\u0430, \u0432\u0445\u043e\u0434\u044f\u0442 \u0432 \u043e\u043a\u043d\u0430, \u043a\u0430\u043a \u0432\u043e\u0440.","notes":[]},{"id":"JOL.2.10","number":"10","text":"\u041f\u0435\u0440\u0435\u0434 \u043d\u0438\u043c\u0438 \u043f\u043e\u0442\u0440\u044f\u0441\u0435\u0442\u0441\u044f \u0437\u0435\u043c\u043b\u044f, \u043f\u043e\u043a\u043e\u043b\u0435\u0431\u043b\u0435\u0442\u0441\u044f \u043d\u0435\u0431\u043e; \u0441\u043e\u043b\u043d\u0446\u0435 \u0438 \u043b\u0443\u043d\u0430 \u043f\u043e\u043c\u0440\u0430\u0447\u0430\u0442\u0441\u044f, \u0438 \u0437\u0432\u0435\u0437\u0434\u044b \u043f\u043e\u0442\u0435\u0440\u044f\u044e\u0442 \u0441\u0432\u043e\u0439 \u0441\u0432\u0435\u0442.","notes":[]},{"id":"JOL.2.11","number":"11","text":"\u0418 \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u0434\u0430\u0441\u0442 \u0433\u043b\u0430\u0441 \u0421\u0432\u043e\u0439 \u043f\u0440\u0435\u0434 \u0432\u043e\u0438\u043d\u0441\u0442\u0432\u043e\u043c \u0421\u0432\u043e\u0438\u043c, \u0438\u0431\u043e \u0432\u0435\u0441\u044c\u043c\u0430 \u043c\u043d\u043e\u0433\u043e\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u043e \u043f\u043e\u043b\u0447\u0438\u0449\u0435 \u0415\u0433\u043e \u0438 \u043c\u043e\u0433\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d \u0438\u0441\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c \u0441\u043b\u043e\u0432\u0430 \u0415\u0433\u043e; \u0438\u0431\u043e \u0432\u0435\u043b\u0438\u043a \u0434\u0435\u043d\u044c \u0413\u043e\u0441\u043f\u043e\u0434\u0435\u043d\u044c \u0438 \u0432\u0435\u0441\u044c\u043c\u0430 \u0441\u0442\u0440\u0430\u0448\u0435\u043d, \u0438 \u043a\u0442\u043e \u0432\u044b\u0434\u0435\u0440\u0436\u0438\u0442 \u0435\u0433\u043e?","notes":[]},{"id":"JOL.2.12","number":"12","text":"\u041d\u043e \u0438 \u043d\u044b\u043d\u0435 \u0435\u0449\u0435 \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u0413\u043e\u0441\u043f\u043e\u0434\u044c: \u043e\u0431\u0440\u0430\u0442\u0438\u0442\u0435\u0441\u044c \u043a\u043e \u041c\u043d\u0435 \u0432\u0441\u0435\u043c \u0441\u0435\u0440\u0434\u0446\u0435\u043c \u0441\u0432\u043e\u0438\u043c \u0432 \u043f\u043e\u0441\u0442\u0435, \u043f\u043b\u0430\u0447\u0435 \u0438 \u0440\u044b\u0434\u0430\u043d\u0438\u0438.","notes":[]},{"id":"JOL.2.13","number":"13","text":"\u0420\u0430\u0437\u0434\u0438\u0440\u0430\u0439\u0442\u0435 \u0441\u0435\u0440\u0434\u0446\u0430 \u0432\u0430\u0448\u0438, \u0430 \u043d\u0435 \u043e\u0434\u0435\u0436\u0434\u044b \u0432\u0430\u0448\u0438 \u0438 \u043e\u0431\u0440\u0430\u0442\u0438\u0442\u0435\u0441\u044c \u043a \u0413\u043e\u0441\u043f\u043e\u0434\u0443 \u0411\u043e\u0433\u0443 \u0432\u0430\u0448\u0435\u043c\u0443; \u0438\u0431\u043e \u041e\u043d \u0431\u043b\u0430\u0433 \u0438 \u043c\u0438\u043b\u043e\u0441\u0435\u0440\u0434, \u0434\u043e\u043b\u0433\u043e\u0442\u0435\u0440\u043f\u0435\u043b\u0438\u0432 \u0438 \u043c\u043d\u043e\u0433\u043e\u043c\u0438\u043b\u043e\u0441\u0442\u0438\u0432 \u0438 \u0441\u043e\u0436\u0430\u043b\u0435\u0435\u0442 \u043e \u0431\u0435\u0434\u0441\u0442\u0432\u0438\u0438.","notes":[]},{"id":"JOL.2.14","number":"14","text":"\u041a\u0442\u043e \u0437\u043d\u0430\u0435\u0442, \u043d\u0435 \u0441\u0436\u0430\u043b\u0438\u0442\u0441\u044f \u043b\u0438 \u041e\u043d \u0438 \u043d\u0435 \u043e\u0441\u0442\u0430\u0432\u0438\u0442 \u043b\u0438 \u0431\u043b\u0430\u0433\u043e\u0441\u043b\u043e\u0432\u0435\u043d\u0438\u044f, \u0445\u043b\u0435\u0431\u043d\u043e\u0433\u043e \u043f\u0440\u0438\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0438 \u0432\u043e\u0437\u043b\u0438\u044f\u043d\u0438\u044f \u0413\u043e\u0441\u043f\u043e\u0434\u0443 \u0411\u043e\u0433\u0443 \u0432\u0430\u0448\u0435\u043c\u0443?","notes":[]},{"id":"JOL.2.15","number":"15","text":"\u0412\u043e\u0441\u0442\u0440\u0443\u0431\u0438\u0442\u0435 \u0442\u0440\u0443\u0431\u043e\u044e \u043d\u0430 \u0421\u0438\u043e\u043d\u0435, \u043d\u0430\u0437\u043d\u0430\u0447\u044c\u0442\u0435 \u043f\u043e\u0441\u0442 \u0438 \u043e\u0431\u044a\u044f\u0432\u0438\u0442\u0435 \u0442\u043e\u0440\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435 \u0441\u043e\u0431\u0440\u0430\u043d\u0438\u0435.","notes":[]},{"id":"JOL.2.16","number":"16","text":"\u0421\u043e\u0431\u0435\u0440\u0438\u0442\u0435 \u043d\u0430\u0440\u043e\u0434, \u0441\u043e\u0437\u043e\u0432\u0438\u0442\u0435 \u0441\u043e\u0431\u0440\u0430\u043d\u0438\u0435, \u043f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u0442\u0435 \u0441\u0442\u0430\u0440\u0446\u0435\u0432, \u0441\u043e\u0431\u0435\u0440\u0438\u0442\u0435 \u043e\u0442\u0440\u043e\u043a\u043e\u0432 \u0438 \u0433\u0440\u0443\u0434\u043d\u044b\u0445 \u043c\u043b\u0430\u0434\u0435\u043d\u0446\u0435\u0432; \u043f\u0443\u0441\u0442\u044c \u0432\u044b\u0439\u0434\u0435\u0442 \u0436\u0435\u043d\u0438\u0445 \u0438\u0437 \u0447\u0435\u0440\u0442\u043e\u0433\u0430 \u0441\u0432\u043e\u0435\u0433\u043e \u0438 \u043d\u0435\u0432\u0435\u0441\u0442\u0430 \u0438\u0437 \u0441\u0432\u043e\u0435\u0439 \u0433\u043e\u0440\u043d\u0438\u0446\u044b.","notes":[]},{"id":"JOL.2.17","number":"17","text":"\u041c\u0435\u0436\u0434\u0443 \u043f\u0440\u0438\u0442\u0432\u043e\u0440\u043e\u043c \u0438 \u0436\u0435\u0440\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u043c \u0434\u0430 \u043f\u043b\u0430\u0447\u0443\u0442 \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u043a\u0438, \u0441\u043b\u0443\u0436\u0438\u0442\u0435\u043b\u0438 \u0413\u043e\u0441\u043f\u043e\u0434\u043d\u0438, \u0438 \u0433\u043e\u0432\u043e\u0440\u044f\u0442: \u201c\u043f\u043e\u0449\u0430\u0434\u0438, \u0413\u043e\u0441\u043f\u043e\u0434\u0438, \u043d\u0430\u0440\u043e\u0434 \u0422\u0432\u043e\u0439, \u043d\u0435 \u043f\u0440\u0435\u0434\u0430\u0439 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u044f \u0422\u0432\u043e\u0435\u0433\u043e \u043d\u0430 \u043f\u043e\u0440\u0443\u0433\u0430\u043d\u0438\u0435, \u0447\u0442\u043e\u0431\u044b \u043d\u0435 \u0438\u0437\u0434\u0435\u0432\u0430\u043b\u0438\u0441\u044c \u043d\u0430\u0434 \u043d\u0438\u043c \u043d\u0430\u0440\u043e\u0434\u044b; \u0434\u043b\u044f \u0447\u0435\u0433\u043e \u0431\u0443\u0434\u0443\u0442 \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c \u043c\u0435\u0436\u0434\u0443 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0438: \u0433\u0434\u0435 \u0411\u043e\u0433 \u0438\u0445?\u201d","notes":[]},{"id":"JOL.2.18","number":"18","text":"\u0418 \u0442\u043e\u0433\u0434\u0430 \u0432\u043e\u0437\u0440\u0435\u0432\u043d\u0443\u0435\u0442 \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u043e \u0437\u0435\u043c\u043b\u0435 \u0421\u0432\u043e\u0435\u0439, \u0438 \u043f\u043e\u0449\u0430\u0434\u0438\u0442 \u043d\u0430\u0440\u043e\u0434 \u0421\u0432\u043e\u0439.","notes":[]},{"id":"JOL.2.19","number":"19","text":"\u0418 \u043e\u0442\u0432\u0435\u0442\u0438\u0442 \u0413\u043e\u0441\u043f\u043e\u0434\u044c, \u0438 \u0441\u043a\u0430\u0436\u0435\u0442 \u043d\u0430\u0440\u043e\u0434\u0443 \u0421\u0432\u043e\u0435\u043c\u0443: \u0432\u043e\u0442, \u042f \u043f\u043e\u0448\u043b\u044e \u0432\u0430\u043c \u0445\u043b\u0435\u0431 \u0438 \u0432\u0438\u043d\u043e \u0438 \u0435\u043b\u0435\u0439, \u0438 \u0431\u0443\u0434\u0435\u0442\u0435 \u043d\u0430\u0441\u044b\u0449\u0430\u0442\u044c\u0441\u044f \u0438\u043c\u0438, \u0438 \u0431\u043e\u043b\u0435\u0435 \u043d\u0435 \u043e\u0442\u0434\u0430\u043c \u0432\u0430\u0441 \u043d\u0430 \u043f\u043e\u0440\u0443\u0433\u0430\u043d\u0438\u0435 \u043d\u0430\u0440\u043e\u0434\u0430\u043c.","notes":[]},{"id":"JOL.2.20","number":"20","text":"\u0418 \u043f\u0440\u0438\u0448\u0435\u0434\u0448\u0435\u0433\u043e \u043e\u0442 \u0441\u0435\u0432\u0435\u0440\u0430 \u0443\u0434\u0430\u043b\u044e \u043e\u0442 \u0432\u0430\u0441, \u0438 \u0438\u0437\u0433\u043e\u043d\u044e \u0432 \u0437\u0435\u043c\u043b\u044e \u0431\u0435\u0437\u0432\u043e\u0434\u043d\u0443\u044e \u0438 \u043f\u0443\u0441\u0442\u0443\u044e, \u043f\u0435\u0440\u0435\u0434\u043d\u0435\u0435 \u043f\u043e\u043b\u0447\u0438\u0449\u0435 \u0435\u0433\u043e - \u0432 \u043c\u043e\u0440\u0435 \u0432\u043e\u0441\u0442\u043e\u0447\u043d\u043e\u0435, \u0430 \u0437\u0430\u0434\u043d\u0435\u0435 - \u0432 \u043c\u043e\u0440\u0435 \u0437\u0430\u043f\u0430\u0434\u043d\u043e\u0435, \u0438 \u043f\u043e\u0439\u0434\u0435\u0442 \u043e\u0442 \u043d\u0435\u0433\u043e \u0437\u043b\u043e\u0432\u043e\u043d\u0438\u0435, \u0438 \u043f\u043e\u0434\u043d\u0438\u043c\u0435\u0442\u0441\u044f \u043e\u0442 \u043d\u0435\u0433\u043e \u0441\u043c\u0440\u0430\u0434, \u0442\u0430\u043a \u043a\u0430\u043a \u043e\u043d \u043c\u043d\u043e\u0433\u043e \u043d\u0430\u0434\u0435\u043b\u0430\u043b \u0437\u043b\u0430.","notes":[]},{"id":"JOL.2.21","number":"21","text":"\u041d\u0435 \u0431\u043e\u0439\u0441\u044f, \u0437\u0435\u043c\u043b\u044f: \u0440\u0430\u0434\u0443\u0439\u0441\u044f \u0438 \u0432\u0435\u0441\u0435\u043b\u0438\u0441\u044c, \u0438\u0431\u043e \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u0432\u0435\u043b\u0438\u043a, \u0447\u0442\u043e\u0431\u044b \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u0442\u044c \u044d\u0442\u043e.","notes":[]},{"id":"JOL.2.22","number":"22","text":"\u041d\u0435 \u0431\u043e\u0439\u0442\u0435\u0441\u044c, \u0436\u0438\u0432\u043e\u0442\u043d\u044b\u0435, \u0438\u0431\u043e \u043f\u0430\u0441\u0442\u0431\u0438\u0449\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0438 \u043f\u0440\u043e\u0438\u0437\u0440\u0430\u0441\u0442\u044f\u0442 \u0442\u0440\u0430\u0432\u0443, \u0434\u0435\u0440\u0435\u0432\u043e \u043f\u0440\u0438\u043d\u0435\u0441\u0435\u0442 \u043f\u043b\u043e\u0434 \u0441\u0432\u043e\u0439, \u0441\u043c\u043e\u043a\u043e\u0432\u043d\u0438\u0446\u0430 \u0438 \u0432\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043d\u0430\u044f \u043b\u043e\u0437\u0430 \u043e\u043a\u0430\u0436\u0443\u0442 \u0441\u0432\u043e\u044e \u0441\u0438\u043b\u0443.","notes":[]},{"id":"JOL.2.23","number":"23","text":"\u0418 \u0432\u044b, \u0447\u0430\u0434\u0430 \u0421\u0438\u043e\u043d\u0430, \u0440\u0430\u0434\u0443\u0439\u0442\u0435\u0441\u044c \u0438 \u0432\u0435\u0441\u0435\u043b\u0438\u0442\u0435\u0441\u044c \u043e \u0413\u043e\u0441\u043f\u043e\u0434\u0435 \u0411\u043e\u0433\u0435 \u0432\u0430\u0448\u0435\u043c; \u0438\u0431\u043e \u041e\u043d \u0434\u0430\u0441\u0442 \u0432\u0430\u043c \u0434\u043e\u0436\u0434\u044c \u0432 \u043c\u0435\u0440\u0443 \u0438 \u0431\u0443\u0434\u0435\u0442 \u043d\u0438\u0441\u043f\u043e\u0441\u044b\u043b\u0430\u0442\u044c \u0432\u0430\u043c \u0434\u043e\u0436\u0434\u044c, \u0434\u043e\u0436\u0434\u044c \u0440\u0430\u043d\u043d\u0438\u0439 \u0438 \u043f\u043e\u0437\u0434\u043d\u0438\u0439, \u043a\u0430\u043a \u043f\u0440\u0435\u0436\u0434\u0435.","notes":[]},{"id":"JOL.2.24","number":"24","text":"\u0418 \u043d\u0430\u043f\u043e\u043b\u043d\u044f\u0442\u0441\u044f \u0433\u0443\u043c\u043d\u0430 \u0445\u043b\u0435\u0431\u043e\u043c, \u0438 \u043f\u0435\u0440\u0435\u043f\u043e\u043b\u043d\u044f\u0442\u0441\u044f \u043f\u043e\u0434\u0442\u043e\u0447\u0438\u043b\u0438\u044f \u0432\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043d\u044b\u043c \u0441\u043e\u043a\u043e\u043c \u0438 \u0435\u043b\u0435\u0435\u043c.","notes":[]},{"id":"JOL.2.25","number":"25","text":"\u0418 \u0432\u043e\u0437\u0434\u0430\u043c \u0432\u0430\u043c \u0437\u0430 \u0442\u0435 \u0433\u043e\u0434\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u0436\u0438\u0440\u0430\u043b\u0438 \u0441\u0430\u0440\u0430\u043d\u0447\u0430, \u0447\u0435\u0440\u0432\u0438, \u0436\u0443\u043a\u0438 \u0438 \u0433\u0443\u0441\u0435\u043d\u0438\u0446\u0430, \u0432\u0435\u043b\u0438\u043a\u043e\u0435 \u0432\u043e\u0439\u0441\u043a\u043e \u041c\u043e\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043f\u043e\u0441\u043b\u0430\u043b \u042f \u043d\u0430 \u0432\u0430\u0441.","notes":[]},{"id":"JOL.2.26","number":"26","text":"\u0418 \u0434\u043e \u0441\u044b\u0442\u043e\u0441\u0442\u0438 \u0431\u0443\u0434\u0435\u0442\u0435 \u0435\u0441\u0442\u044c \u0438 \u043d\u0430\u0441\u044b\u0449\u0430\u0442\u044c\u0441\u044f \u0438 \u0441\u043b\u0430\u0432\u0438\u0442\u044c \u0438\u043c\u044f \u0413\u043e\u0441\u043f\u043e\u0434\u0430 \u0411\u043e\u0433\u0430 \u0432\u0430\u0448\u0435\u0433\u043e, \u041a\u043e\u0442\u043e\u0440\u044b\u0439 \u0434\u0438\u0432\u043d\u043e\u0435 \u0441\u043e\u0434\u0435\u043b\u0430\u043b \u0441 \u0432\u0430\u043c\u0438, \u0438 \u043d\u0435 \u043f\u043e\u0441\u0440\u0430\u043c\u0438\u0442\u0441\u044f \u043d\u0430\u0440\u043e\u0434 \u041c\u043e\u0439 \u0432\u043e\u0432\u0435\u043a\u0438.","notes":[]},{"id":"JOL.2.27","number":"27","text":"\u0418 \u0443\u0437\u043d\u0430\u0435\u0442\u0435, \u0447\u0442\u043e \u042f \u043f\u043e\u0441\u0440\u0435\u0434\u0438 \u0418\u0437\u0440\u0430\u0438\u043b\u044f, \u0438 \u042f - \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u0411\u043e\u0433 \u0432\u0430\u0448, \u0438 \u043d\u0435\u0442 \u0434\u0440\u0443\u0433\u043e\u0433\u043e, \u0438 \u041c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434 \u043d\u0435 \u043f\u043e\u0441\u0440\u0430\u043c\u0438\u0442\u0441\u044f \u0432\u043e\u0432\u0435\u043a\u0438.","notes":[]},{"id":"JOL.2.28","number":"28","text":"\u0418 \u0431\u0443\u0434\u0435\u0442 \u043f\u043e\u0441\u043b\u0435 \u0442\u043e\u0433\u043e, \u0438\u0437\u043b\u0438\u044e \u043e\u0442 \u0414\u0443\u0445\u0430 \u041c\u043e\u0435\u0433\u043e \u043d\u0430 \u0432\u0441\u044f\u043a\u0443\u044e \u043f\u043b\u043e\u0442\u044c, \u0438 \u0431\u0443\u0434\u0443\u0442 \u043f\u0440\u043e\u0440\u043e\u0447\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u0441\u044b\u043d\u044b \u0432\u0430\u0448\u0438 \u0438 \u0434\u043e\u0447\u0435\u0440\u0438 \u0432\u0430\u0448\u0438; \u0441\u0442\u0430\u0440\u0446\u0430\u043c \u0432\u0430\u0448\u0438\u043c \u0431\u0443\u0434\u0443\u0442 \u0441\u043d\u0438\u0442\u044c\u0441\u044f \u0441\u043d\u044b, \u0438 \u044e\u043d\u043e\u0448\u0438 \u0432\u0430\u0448\u0438 \u0431\u0443\u0434\u0443\u0442 \u0432\u0438\u0434\u0435\u0442\u044c \u0432\u0438\u0434\u0435\u043d\u0438\u044f.","notes":[]},{"id":"JOL.2.29","number":"29","text":"\u0418 \u0442\u0430\u043a\u0436\u0435 \u043d\u0430 \u0440\u0430\u0431\u043e\u0432 \u0438 \u043d\u0430 \u0440\u0430\u0431\u044b\u043d\u044c \u0432 \u0442\u0435 \u0434\u043d\u0438 \u0438\u0437\u043b\u0438\u044e \u043e\u0442 \u0414\u0443\u0445\u0430 \u041c\u043e\u0435\u0433\u043e.","notes":[]},{"id":"JOL.2.30","number":"30","text":"\u0418 \u043f\u043e\u043a\u0430\u0436\u0443 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u044f \u043d\u0430 \u043d\u0435\u0431\u0435 \u0438 \u043d\u0430 \u0437\u0435\u043c\u043b\u0435: \u043a\u0440\u043e\u0432\u044c \u0438 \u043e\u0433\u043e\u043d\u044c \u0438 \u0441\u0442\u043e\u043b\u043f\u044b \u0434\u044b\u043c\u0430.","notes":[]},{"id":"JOL.2.31","number":"31","text":"\u0421\u043e\u043b\u043d\u0446\u0435 \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0442\u0441\u044f \u0432\u043e \u0442\u044c\u043c\u0443 \u0438 \u043b\u0443\u043d\u0430 - \u0432 \u043a\u0440\u043e\u0432\u044c, \u043f\u0440\u0435\u0436\u0434\u0435 \u043d\u0435\u0436\u0435\u043b\u0438 \u043d\u0430\u0441\u0442\u0443\u043f\u0438\u0442 \u0434\u0435\u043d\u044c \u0413\u043e\u0441\u043f\u043e\u0434\u0435\u043d\u044c, \u0432\u0435\u043b\u0438\u043a\u0438\u0439 \u0438 \u0441\u0442\u0440\u0430\u0448\u043d\u044b\u0439.","notes":[]},{"id":"JOL.2.32","number":"32","text":"\u0418 \u0431\u0443\u0434\u0435\u0442: \u0432\u0441\u044f\u043a\u0438\u0439, \u043a\u0442\u043e \u043f\u0440\u0438\u0437\u043e\u0432\u0435\u0442 \u0438\u043c\u044f \u0413\u043e\u0441\u043f\u043e\u0434\u043d\u0435, \u0441\u043f\u0430\u0441\u0435\u0442\u0441\u044f; \u0438\u0431\u043e \u043d\u0430 \u0433\u043e\u0440\u0435 \u0421\u0438\u043e\u043d\u0435 \u0438 \u0432 \u0418\u0435\u0440\u0443\u0441\u0430\u043b\u0438\u043c\u0435 \u0431\u0443\u0434\u0435\u0442 \u0441\u043f\u0430\u0441\u0435\u043d\u0438\u0435, \u043a\u0430\u043a \u0441\u043a\u0430\u0437\u0430\u043b \u0413\u043e\u0441\u043f\u043e\u0434\u044c, \u0438 \u0443 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0445, \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043f\u0440\u0438\u0437\u043e\u0432\u0435\u0442 \u0413\u043e\u0441\u043f\u043e\u0434\u044c.","notes":[]}],"3":[{"id":"JOL.3.1","number":"1","text":"\u0418\u0431\u043e \u0432\u043e\u0442, \u0432 \u0442\u0435 \u0434\u043d\u0438 \u0438 \u0432 \u0442\u043e \u0441\u0430\u043c\u043e\u0435 \u0432\u0440\u0435\u043c\u044f, \u043a\u043e\u0433\u0434\u0430 \u042f \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0443 \u043f\u043b\u0435\u043d \u0418\u0443\u0434\u044b \u0438 \u0418\u0435\u0440\u0443\u0441\u0430\u043b\u0438\u043c\u0430,","notes":[]},{"id":"JOL.3.2","number":"2","text":"\u042f \u0441\u043e\u0431\u0435\u0440\u0443 \u0432\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b, \u0438 \u043f\u0440\u0438\u0432\u0435\u0434\u0443 \u0438\u0445 \u0432 \u0434\u043e\u043b\u0438\u043d\u0443 \u0418\u043e\u0441\u0430\u0444\u0430\u0442\u0430, \u0438 \u0442\u0430\u043c \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0443 \u043d\u0430\u0434 \u043d\u0438\u043c\u0438 \u0441\u0443\u0434 \u0437\u0430 \u043d\u0430\u0440\u043e\u0434 \u041c\u043e\u0439 \u0438 \u0437\u0430 \u043d\u0430\u0441\u043b\u0435\u0434\u0438\u0435 \u041c\u043e\u0435, \u0418\u0437\u0440\u0430\u0438\u043b\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u043d\u0438 \u0440\u0430\u0441\u0441\u0435\u044f\u043b\u0438 \u043c\u0435\u0436\u0434\u0443 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0438, \u0438 \u0437\u0435\u043c\u043b\u044e \u041c\u043e\u044e \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u043b\u0438.","notes":[]},{"id":"JOL.3.3","number":"3","text":"\u0418 \u043e \u043d\u0430\u0440\u043e\u0434\u0435 \u041c\u043e\u0435\u043c \u043e\u043d\u0438 \u0431\u0440\u043e\u0441\u0430\u043b\u0438 \u0436\u0440\u0435\u0431\u0438\u0439, \u0438 \u043e\u0442\u0434\u0430\u0432\u0430\u043b\u0438 \u043e\u0442\u0440\u043e\u043a\u0430 \u0437\u0430 \u0431\u043b\u0443\u0434\u043d\u0438\u0446\u0443, \u0438 \u043f\u0440\u043e\u0434\u0430\u0432\u0430\u043b\u0438 \u043e\u0442\u0440\u043e\u043a\u043e\u0432\u0438\u0446\u0443 \u0437\u0430 \u0432\u0438\u043d\u043e, \u0438 \u043f\u0438\u043b\u0438.","notes":[]},{"id":"JOL.3.4","number":"4","text":"\u0418 \u0447\u0442\u043e \u0432\u044b \u041c\u043d\u0435, \u0422\u0438\u0440 \u0438 \u0421\u0438\u0434\u043e\u043d \u0438 \u0432\u0441\u0435 \u043e\u043a\u0440\u0443\u0433\u0438 \u0424\u0438\u043b\u0438\u0441\u0442\u0438\u043c\u0441\u043a\u0438\u0435? \u0425\u043e\u0442\u0438\u0442\u0435 \u043b\u0438 \u0432\u043e\u0437\u0434\u0430\u0442\u044c \u041c\u043d\u0435 \u0432\u043e\u0437\u043c\u0435\u0437\u0434\u0438\u0435? \u0425\u043e\u0442\u0438\u0442\u0435 \u043b\u0438 \u0432\u043e\u0437\u0434\u0430\u0442\u044c \u041c\u043d\u0435? \u041b\u0435\u0433\u043a\u043e \u0438 \u0441\u043a\u043e\u0440\u043e \u042f \u043e\u0431\u0440\u0430\u0449\u0443 \u0432\u043e\u0437\u043c\u0435\u0437\u0434\u0438\u0435 \u0432\u0430\u0448\u0435 \u043d\u0430 \u0433\u043e\u043b\u043e\u0432\u044b \u0432\u0430\u0448\u0438,","notes":[]},{"id":"JOL.3.5","number":"5","text":"\u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0432\u044b \u0432\u0437\u044f\u043b\u0438 \u0441\u0435\u0440\u0435\u0431\u0440\u043e \u041c\u043e\u0435 \u0438 \u0437\u043e\u043b\u043e\u0442\u043e \u041c\u043e\u0435, \u0438 \u043d\u0430\u0438\u043b\u0443\u0447\u0448\u0438\u0435 \u0434\u0440\u0430\u0433\u043e\u0446\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u041c\u043e\u0438 \u0432\u043d\u0435\u0441\u043b\u0438 \u0432 \u043a\u0430\u043f\u0438\u0449\u0430 \u0432\u0430\u0448\u0438,","notes":[]},{"id":"JOL.3.6","number":"6","text":"\u0438 \u0441\u044b\u043d\u043e\u0432 \u0418\u0443\u0434\u044b \u0438 \u0441\u044b\u043d\u043e\u0432 \u0418\u0435\u0440\u0443\u0441\u0430\u043b\u0438\u043c\u0430 \u043f\u0440\u043e\u0434\u0430\u0432\u0430\u043b\u0438 \u0441\u044b\u043d\u0430\u043c \u0415\u043b\u043b\u0438\u043d\u043e\u0432, \u0447\u0442\u043e\u0431\u044b \u0443\u0434\u0430\u043b\u0438\u0442\u044c \u0438\u0445 \u043e\u0442 \u043f\u0440\u0435\u0434\u0435\u043b\u043e\u0432 \u0438\u0445.","notes":[]},{"id":"JOL.3.7","number":"7","text":"\u0412\u043e\u0442, \u042f \u043f\u043e\u0434\u043d\u0438\u043c\u0443 \u0438\u0445 \u0438\u0437 \u0442\u043e\u0433\u043e \u043c\u0435\u0441\u0442\u0430, \u043a\u0443\u0434\u0430 \u0432\u044b \u043f\u0440\u043e\u0434\u0430\u043b\u0438 \u0438\u0445, \u0438 \u043e\u0431\u0440\u0430\u0449\u0443 \u043c\u0437\u0434\u0443 \u0432\u0430\u0448\u0443 \u043d\u0430 \u0433\u043e\u043b\u043e\u0432\u0443 \u0432\u0430\u0448\u0443.","notes":[]},{"id":"JOL.3.8","number":"8","text":"\u0418 \u043f\u0440\u0435\u0434\u0430\u043c \u0441\u044b\u043d\u043e\u0432\u0435\u0439 \u0432\u0430\u0448\u0438\u0445 \u0438 \u0434\u043e\u0447\u0435\u0440\u0435\u0439 \u0432\u0430\u0448\u0438\u0445 \u0432 \u0440\u0443\u043a\u0438 \u0441\u044b\u043d\u043e\u0432 \u0418\u0443\u0434\u044b, \u0438 \u043e\u043d\u0438 \u043f\u0440\u043e\u0434\u0430\u0434\u0443\u0442 \u0438\u0445 \u0421\u0430\u0432\u0435\u044f\u043c, \u043d\u0430\u0440\u043e\u0434\u0443 \u043e\u0442\u0434\u0430\u043b\u0435\u043d\u043d\u043e\u043c\u0443; \u0442\u0430\u043a \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u0441\u043a\u0430\u0437\u0430\u043b.","notes":[]},{"id":"JOL.3.9","number":"9","text":"\u041f\u0440\u043e\u0432\u043e\u0437\u0433\u043b\u0430\u0441\u0438\u0442\u0435 \u043e\u0431 \u044d\u0442\u043e\u043c \u043c\u0435\u0436\u0434\u0443 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0438, \u043f\u0440\u0438\u0433\u043e\u0442\u043e\u0432\u044c\u0442\u0435\u0441\u044c \u043a \u0432\u043e\u0439\u043d\u0435, \u0432\u043e\u0437\u0431\u0443\u0434\u0438\u0442\u0435 \u0445\u0440\u0430\u0431\u0440\u044b\u0445; \u043f\u0443\u0441\u0442\u044c \u0432\u044b\u0441\u0442\u0443\u043f\u044f\u0442, \u043f\u043e\u0434\u043d\u0438\u043c\u0443\u0442\u0441\u044f \u0432\u0441\u0435 \u0440\u0430\u0442\u043e\u0431\u043e\u0440\u0446\u044b.","notes":[]},{"id":"JOL.3.10","number":"10","text":"\u041f\u0435\u0440\u0435\u043a\u0443\u0439\u0442\u0435 \u043e\u0440\u0430\u043b\u0430 \u0432\u0430\u0448\u0438 \u043d\u0430 \u043c\u0435\u0447\u0438 \u0438 \u0441\u0435\u0440\u043f\u044b \u0432\u0430\u0448\u0438 \u043d\u0430 \u043a\u043e\u043f\u044c\u044f; \u0441\u043b\u0430\u0431\u044b\u0439 \u043f\u0443\u0441\u0442\u044c \u0433\u043e\u0432\u043e\u0440\u0438\u0442: \u201c\u044f \u0441\u0438\u043b\u0435\u043d\u201d.","notes":[]},{"id":"JOL.3.11","number":"11","text":"\u0421\u043f\u0435\u0448\u0438\u0442\u0435 \u0438 \u0441\u0445\u043e\u0434\u0438\u0442\u0435\u0441\u044c, \u0432\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b \u043e\u043a\u0440\u0435\u0441\u0442\u043d\u044b\u0435, \u0438 \u0441\u043e\u0431\u0435\u0440\u0438\u0442\u0435\u0441\u044c; \u0442\u0443\u0434\u0430, \u0413\u043e\u0441\u043f\u043e\u0434\u0438, \u0432\u0435\u0434\u0438 \u0422\u0432\u043e\u0438\u0445 \u0433\u0435\u0440\u043e\u0435\u0432.","notes":[]},{"id":"JOL.3.12","number":"12","text":"\u041f\u0443\u0441\u0442\u044c \u0432\u043e\u0441\u043f\u0440\u044f\u043d\u0443\u0442 \u043d\u0430\u0440\u043e\u0434\u044b \u0438 \u043d\u0438\u0437\u043e\u0439\u0434\u0443\u0442 \u0432 \u0434\u043e\u043b\u0438\u043d\u0443 \u0418\u043e\u0441\u0430\u0444\u0430\u0442\u0430; \u0438\u0431\u043e \u0442\u0430\u043c \u042f \u0432\u043e\u0441\u0441\u044f\u0434\u0443, \u0447\u0442\u043e\u0431\u044b \u0441\u0443\u0434\u0438\u0442\u044c \u0432\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b \u043e\u0442\u043e\u0432\u0441\u044e\u0434\u0443.","notes":[]},{"id":"JOL.3.13","number":"13","text":"\u041f\u0443\u0441\u0442\u0438\u0442\u0435 \u0432 \u0434\u0435\u043b\u043e \u0441\u0435\u0440\u043f\u044b, \u0438\u0431\u043e \u0436\u0430\u0442\u0432\u0430 \u0441\u043e\u0437\u0440\u0435\u043b\u0430; \u0438\u0434\u0438\u0442\u0435, \u0441\u043f\u0443\u0441\u0442\u0438\u0442\u0435\u0441\u044c, \u0438\u0431\u043e \u0442\u043e\u0447\u0438\u043b\u043e \u043f\u043e\u043b\u043d\u043e \u0438 \u043f\u043e\u0434\u0442\u043e\u0447\u0438\u043b\u0438\u044f \u043f\u0435\u0440\u0435\u043b\u0438\u0432\u0430\u044e\u0442\u0441\u044f, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0437\u043b\u043e\u0431\u0430 \u0438\u0445 \u0432\u0435\u043b\u0438\u043a\u0430.","notes":[]},{"id":"JOL.3.14","number":"14","text":"\u0422\u043e\u043b\u043f\u044b, \u0442\u043e\u043b\u043f\u044b \u0432 \u0434\u043e\u043b\u0438\u043d\u0435 \u0441\u0443\u0434\u0430! \u0438\u0431\u043e \u0431\u043b\u0438\u0437\u043e\u043a \u0434\u0435\u043d\u044c \u0413\u043e\u0441\u043f\u043e\u0434\u0435\u043d\u044c \u043a \u0434\u043e\u043b\u0438\u043d\u0435 \u0441\u0443\u0434\u0430!","notes":[]},{"id":"JOL.3.15","number":"15","text":"\u0421\u043e\u043b\u043d\u0446\u0435 \u0438 \u043b\u0443\u043d\u0430 \u043f\u043e\u043c\u0435\u0440\u043a\u043d\u0443\u0442, \u0438 \u0437\u0432\u0435\u0437\u0434\u044b \u043f\u043e\u0442\u0435\u0440\u044f\u044e\u0442 \u0431\u043b\u0435\u0441\u043a \u0441\u0432\u043e\u0439.","notes":[]},{"id":"JOL.3.16","number":"16","text":"\u0418 \u0432\u043e\u0437\u0433\u0440\u0435\u043c\u0438\u0442 \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u0441 \u0421\u0438\u043e\u043d\u0430, \u0438 \u0434\u0430\u0441\u0442 \u0433\u043b\u0430\u0441 \u0421\u0432\u043e\u0439 \u0438\u0437 \u0418\u0435\u0440\u0443\u0441\u0430\u043b\u0438\u043c\u0430; \u0441\u043e\u0434\u0440\u043e\u0433\u043d\u0443\u0442\u0441\u044f \u043d\u0435\u0431\u043e \u0438 \u0437\u0435\u043c\u043b\u044f; \u043d\u043e \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u0431\u0443\u0434\u0435\u0442 \u0437\u0430\u0449\u0438\u0442\u043e\u044e \u0434\u043b\u044f \u043d\u0430\u0440\u043e\u0434\u0430 \u0421\u0432\u043e\u0435\u0433\u043e \u0438 \u043e\u0431\u043e\u0440\u043e\u043d\u043e\u044e \u0434\u043b\u044f \u0441\u044b\u043d\u043e\u0432 \u0418\u0437\u0440\u0430\u0438\u043b\u0435\u0432\u044b\u0445.","notes":[]},{"id":"JOL.3.17","number":"17","text":"\u0422\u043e\u0433\u0434\u0430 \u0443\u0437\u043d\u0430\u0435\u0442\u0435, \u0447\u0442\u043e \u042f \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u0411\u043e\u0433 \u0432\u0430\u0448, \u043e\u0431\u0438\u0442\u0430\u044e\u0449\u0438\u0439 \u043d\u0430 \u0421\u0438\u043e\u043d\u0435, \u043d\u0430 \u0441\u0432\u044f\u0442\u043e\u0439 \u0433\u043e\u0440\u0435 \u041c\u043e\u0435\u0439; \u0438 \u0431\u0443\u0434\u0435\u0442 \u0418\u0435\u0440\u0443\u0441\u0430\u043b\u0438\u043c \u0441\u0432\u044f\u0442\u044b\u043d\u0435\u044e, \u0438 \u043d\u0435 \u0431\u0443\u0434\u0443\u0442 \u0443\u0436\u0435 \u0438\u043d\u043e\u043f\u043b\u0435\u043c\u0435\u043d\u043d\u0438\u043a\u0438 \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u0442\u044c \u0447\u0435\u0440\u0435\u0437 \u043d\u0435\u0433\u043e.","notes":[]},{"id":"JOL.3.18","number":"18","text":"\u0418 \u0431\u0443\u0434\u0435\u0442 \u0432 \u0442\u043e\u0442 \u0434\u0435\u043d\u044c: \u0433\u043e\u0440\u044b \u0431\u0443\u0434\u0443\u0442 \u043a\u0430\u043f\u0430\u0442\u044c \u0432\u0438\u043d\u043e\u043c, \u0438 \u0445\u043e\u043b\u043c\u044b \u043f\u043e\u0442\u0435\u043a\u0443\u0442 \u043c\u043e\u043b\u043e\u043a\u043e\u043c, \u0438 \u0432\u0441\u0435 \u0440\u0443\u0441\u043b\u0430 \u0418\u0443\u0434\u0435\u0439\u0441\u043a\u0438\u0435 \u043d\u0430\u043f\u043e\u043b\u043d\u044f\u0442\u0441\u044f \u0432\u043e\u0434\u043e\u044e, \u0430 \u0438\u0437 \u0434\u043e\u043c\u0430 \u0413\u043e\u0441\u043f\u043e\u0434\u043d\u044f \u0432\u044b\u0439\u0434\u0435\u0442 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a \u0438 \u0431\u0443\u0434\u0435\u0442 \u043d\u0430\u043f\u043e\u044f\u0442\u044c \u0434\u043e\u043b\u0438\u043d\u0443 \u0421\u0438\u0442\u0442\u0438\u043c.","notes":[]},{"id":"JOL.3.19","number":"19","text":"\u0415\u0433\u0438\u043f\u0435\u0442 \u0441\u0434\u0435\u043b\u0430\u0435\u0442\u0441\u044f \u043f\u0443\u0441\u0442\u044b\u043d\u0435\u044e \u0438 \u0415\u0434\u043e\u043c \u0431\u0443\u0434\u0435\u0442 \u043f\u0443\u0441\u0442\u043e\u044e \u0441\u0442\u0435\u043f\u044c\u044e \u0437\u0430 \u0442\u043e, \u0447\u0442\u043e \u043e\u043d\u0438 \u043f\u0440\u0438\u0442\u0435\u0441\u043d\u044f\u043b\u0438 \u0441\u044b\u043d\u043e\u0432 \u0418\u0443\u0434\u0438\u043d\u044b\u0445 \u0438 \u043f\u0440\u043e\u043b\u0438\u0432\u0430\u043b\u0438 \u043d\u0435\u0432\u0438\u043d\u043d\u0443\u044e \u043a\u0440\u043e\u0432\u044c \u0432 \u0437\u0435\u043c\u043b\u0435 \u0438\u0445.","notes":[]},{"id":"JOL.3.20","number":"20","text":"\u0410 \u0418\u0443\u0434\u0430 \u0431\u0443\u0434\u0435\u0442 \u0436\u0438\u0442\u044c \u0432\u0435\u0447\u043d\u043e, \u0438 \u0418\u0435\u0440\u0443\u0441\u0430\u043b\u0438\u043c - \u0432 \u0440\u043e\u0434\u044b \u0440\u043e\u0434\u043e\u0432.","notes":[]},{"id":"JOL.3.21","number":"21","text":"\u042f \u0441\u043c\u043e\u044e \u043a\u0440\u043e\u0432\u044c \u0438\u0445, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043d\u0435 \u0441\u043c\u044b\u043b \u0435\u0449\u0435, \u0438 \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u0431\u0443\u0434\u0435\u0442 \u043e\u0431\u0438\u0442\u0430\u0442\u044c \u043d\u0430 \u0421\u0438\u043e\u043d\u0435.","notes":[]}]}}
