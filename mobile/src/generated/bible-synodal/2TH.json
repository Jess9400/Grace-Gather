{"book":{"code":"2TH","name":"\u0412\u0442\u043e\u0440\u043e\u0435 \u043f\u043e\u0441\u043b\u0430\u043d\u0438\u0435 \u043a \u0424\u0435\u0441\u0441\u0430\u043b\u043e\u043d\u0438\u043a\u0438\u0439\u0446\u0430\u043c","chapters":3,"verses":47,"sourceBaseUrl":"https://ebible.org/russyn/","sourceChapterDigits":2,"sourceEdition":"\u0421\u0438\u043d\u043e\u0434\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u0435\u0440\u0435\u0432\u043e\u0434","sourceAttribution":"\u0421\u0438\u043d\u043e\u0434\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u0435\u0440\u0435\u0432\u043e\u0434 (Russian Synodal translation). Public domain. Text supplied by eBible.org. Six New Testament selections only.","sourceLicenseUrl":"https://ebible.org/russyn/copyright.htm"},"chapters":{"1":[{"id":"2TH.1.1","number":"1","text":"\u041f\u0430\u0432\u0435\u043b \u0438 \u0421\u0438\u043b\u0443\u0430\u043d \u0438 \u0422\u0438\u043c\u043e\u0444\u0435\u0439 - \u0424\u0435\u0441\u0441\u0430\u043b\u043e\u043d\u0438\u043a\u0441\u043a\u043e\u0439 \u0446\u0435\u0440\u043a\u0432\u0438 \u0432 \u0411\u043e\u0433\u0435 \u041e\u0442\u0446\u0435 \u043d\u0430\u0448\u0435\u043c \u0438 \u0413\u043e\u0441\u043f\u043e\u0434\u0435 \u0418\u0438\u0441\u0443\u0441\u0435 \u0425\u0440\u0438\u0441\u0442\u0435:","notes":[]},{"id":"2TH.1.2","number":"2","text":"\u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0442\u044c \u0432\u0430\u043c \u0438 \u043c\u0438\u0440 \u043e\u0442 \u0411\u043e\u0433\u0430 \u041e\u0442\u0446\u0430 \u043d\u0430\u0448\u0435\u0433\u043e \u0438 \u0413\u043e\u0441\u043f\u043e\u0434\u0430 \u0418\u0438\u0441\u0443\u0441\u0430 \u0425\u0440\u0438\u0441\u0442\u0430.","notes":[]},{"id":"2TH.1.3","number":"3","text":"\u0412\u0441\u0435\u0433\u0434\u0430 \u043f\u043e \u0441\u043f\u0440\u0430\u0432\u0435\u0434\u043b\u0438\u0432\u043e\u0441\u0442\u0438 \u043c\u044b \u0434\u043e\u043b\u0436\u043d\u044b \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u0438\u0442\u044c \u0411\u043e\u0433\u0430 \u0437\u0430 \u0432\u0430\u0441, \u0431\u0440\u0430\u0442\u0438\u044f, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430\u0435\u0442 \u0432\u0435\u0440\u0430 \u0432\u0430\u0448\u0430 \u0438 \u0443\u043c\u043d\u043e\u0436\u0430\u0435\u0442\u0441\u044f \u043b\u044e\u0431\u043e\u0432\u044c \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u0434\u0440\u0443\u0433 \u043a \u0434\u0440\u0443\u0433\u0443 \u043c\u0435\u0436\u0434\u0443 \u0432\u0441\u0435\u043c\u0438 \u0432\u0430\u043c\u0438,","notes":[]},{"id":"2TH.1.4","number":"4","text":"\u0442\u0430\u043a \u0447\u0442\u043e \u043c\u044b \u0441\u0430\u043c\u0438 \u0445\u0432\u0430\u043b\u0438\u043c\u0441\u044f \u0432\u0430\u043c\u0438 \u0432 \u0446\u0435\u0440\u043a\u0432\u0430\u0445 \u0411\u043e\u0436\u0438\u0438\u0445, \u0442\u0435\u0440\u043f\u0435\u043d\u0438\u0435\u043c \u0432\u0430\u0448\u0438\u043c \u0438 \u0432\u0435\u0440\u043e\u044e \u0432\u043e \u0432\u0441\u0435\u0445 \u0433\u043e\u043d\u0435\u043d\u0438\u044f\u0445 \u0438 \u0441\u043a\u043e\u0440\u0431\u044f\u0445, \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u043c\u044b\u0445 \u0432\u0430\u043c\u0438","notes":[]},{"id":"2TH.1.5","number":"5","text":"\u0432 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u0431\u0443\u0434\u0435\u0442 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u044b\u0439 \u0441\u0443\u0434 \u0411\u043e\u0436\u0438\u0439, \u0447\u0442\u043e\u0431\u044b \u0432\u0430\u043c \u0443\u0434\u043e\u0441\u0442\u043e\u0438\u0442\u044c\u0441\u044f \u0426\u0430\u0440\u0441\u0442\u0432\u0438\u044f \u0411\u043e\u0436\u0438\u044f, \u0434\u043b\u044f \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0438 \u0441\u0442\u0440\u0430\u0434\u0430\u0435\u0442\u0435.","notes":[]},{"id":"2TH.1.6","number":"6","text":"\u0418\u0431\u043e \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u043e \u043f\u0440\u0435\u0434 \u0411\u043e\u0433\u043e\u043c - \u043e\u0441\u043a\u043e\u0440\u0431\u043b\u044f\u044e\u0449\u0438\u043c \u0432\u0430\u0441 \u0432\u043e\u0437\u0434\u0430\u0442\u044c \u0441\u043a\u043e\u0440\u0431\u044c\u044e,","notes":[]},{"id":"2TH.1.7","number":"7","text":"\u0430 \u0432\u0430\u043c, \u043e\u0441\u043a\u043e\u0440\u0431\u043b\u044f\u0435\u043c\u044b\u043c, \u043e\u0442\u0440\u0430\u0434\u043e\u044e \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u043d\u0430\u043c\u0438, \u0432 \u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u0413\u043e\u0441\u043f\u043e\u0434\u0430 \u0418\u0438\u0441\u0443\u0441\u0430 \u0441 \u043d\u0435\u0431\u0430, \u0441 \u0410\u043d\u0433\u0435\u043b\u0430\u043c\u0438 \u0441\u0438\u043b\u044b \u0415\u0433\u043e,","notes":[]},{"id":"2TH.1.8","number":"8","text":"\u0432 \u043f\u043b\u0430\u043c\u0435\u043d\u0435\u044e\u0449\u0435\u043c \u043e\u0433\u043d\u0435 \u0441\u043e\u0432\u0435\u0440\u0448\u0430\u044e\u0449\u0435\u0433\u043e \u043e\u0442\u043c\u0449\u0435\u043d\u0438\u0435 \u043d\u0435 \u043f\u043e\u0437\u043d\u0430\u0432\u0448\u0438\u043c \u0411\u043e\u0433\u0430 \u0438 \u043d\u0435 \u043f\u043e\u043a\u043e\u0440\u044f\u044e\u0449\u0438\u043c\u0441\u044f \u0431\u043b\u0430\u0433\u043e\u0432\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044e \u0413\u043e\u0441\u043f\u043e\u0434\u0430 \u043d\u0430\u0448\u0435\u0433\u043e \u0418\u0438\u0441\u0443\u0441\u0430 \u0425\u0440\u0438\u0441\u0442\u0430,","notes":[]},{"id":"2TH.1.9","number":"9","text":"\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u0434\u0432\u0435\u0440\u0433\u043d\u0443\u0442\u0441\u044f \u043d\u0430\u043a\u0430\u0437\u0430\u043d\u0438\u044e, \u0432\u0435\u0447\u043d\u043e\u0439 \u043f\u043e\u0433\u0438\u0431\u0435\u043b\u0438, \u043e\u0442 \u043b\u0438\u0446\u0430 \u0413\u043e\u0441\u043f\u043e\u0434\u0430 \u0438 \u043e\u0442 \u0441\u043b\u0430\u0432\u044b \u043c\u043e\u0433\u0443\u0449\u0435\u0441\u0442\u0432\u0430 \u0415\u0433\u043e,","notes":[]},{"id":"2TH.1.10","number":"10","text":"\u043a\u043e\u0433\u0434\u0430 \u041e\u043d \u043f\u0440\u0438\u0438\u0434\u0435\u0442 \u043f\u0440\u043e\u0441\u043b\u0430\u0432\u0438\u0442\u044c\u0441\u044f \u0432\u043e \u0441\u0432\u044f\u0442\u044b\u0445 \u0421\u0432\u043e\u0438\u0445 \u0438 \u044f\u0432\u0438\u0442\u044c\u0441\u044f \u0434\u0438\u0432\u043d\u044b\u043c \u0432 \u0434\u0435\u043d\u044c \u043e\u043d\u044b\u0439 \u0432\u043e \u0432\u0441\u0435\u0445 \u0432\u0435\u0440\u043e\u0432\u0430\u0432\u0448\u0438\u0445, \u0442\u0430\u043a \u043a\u0430\u043a \u0432\u044b \u043f\u043e\u0432\u0435\u0440\u0438\u043b\u0438 \u043d\u0430\u0448\u0435\u043c\u0443 \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0443.","notes":[]},{"id":"2TH.1.11","number":"11","text":"\u0414\u043b\u044f \u0441\u0435\u0433\u043e \u0438 \u043c\u043e\u043b\u0438\u043c\u0441\u044f \u0432\u0441\u0435\u0433\u0434\u0430 \u0437\u0430 \u0432\u0430\u0441, \u0447\u0442\u043e\u0431\u044b \u0411\u043e\u0433 \u043d\u0430\u0448 \u0441\u043e\u0434\u0435\u043b\u0430\u043b \u0432\u0430\u0441 \u0434\u043e\u0441\u0442\u043e\u0439\u043d\u044b\u043c\u0438 \u0437\u0432\u0430\u043d\u0438\u044f \u0438 \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u0432\u0441\u044f\u043a\u043e\u0435 \u0431\u043b\u0430\u0433\u043e\u0432\u043e\u043b\u0435\u043d\u0438\u0435 \u0431\u043b\u0430\u0433\u043e\u0441\u0442\u0438 \u0438 \u0434\u0435\u043b\u043e \u0432\u0435\u0440\u044b \u0432 \u0441\u0438\u043b\u0435,","notes":[]},{"id":"2TH.1.12","number":"12","text":"\u0434\u0430 \u043f\u0440\u043e\u0441\u043b\u0430\u0432\u0438\u0442\u0441\u044f \u0438\u043c\u044f \u0413\u043e\u0441\u043f\u043e\u0434\u0430 \u043d\u0430\u0448\u0435\u0433\u043e \u0418\u0438\u0441\u0443\u0441\u0430 \u0425\u0440\u0438\u0441\u0442\u0430 \u0432 \u0432\u0430\u0441, \u0438 \u0432\u044b \u0432 \u041d\u0435\u043c, \u043f\u043e \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0442\u0438 \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0435\u0433\u043e \u0438 \u0413\u043e\u0441\u043f\u043e\u0434\u0430 \u0418\u0438\u0441\u0443\u0441\u0430 \u0425\u0440\u0438\u0441\u0442\u0430.","notes":[]}],"2":[{"id":"2TH.2.1","number":"1","text":"\u041c\u043e\u043b\u0438\u043c \u0432\u0430\u0441, \u0431\u0440\u0430\u0442\u0438\u044f, \u043e \u043f\u0440\u0438\u0448\u0435\u0441\u0442\u0432\u0438\u0438 \u0413\u043e\u0441\u043f\u043e\u0434\u0430 \u043d\u0430\u0448\u0435\u0433\u043e \u0418\u0438\u0441\u0443\u0441\u0430 \u0425\u0440\u0438\u0441\u0442\u0430 \u0438 \u043d\u0430\u0448\u0435\u043c \u0441\u043e\u0431\u0440\u0430\u043d\u0438\u0438 \u043a \u041d\u0435\u043c\u0443,","notes":[]},{"id":"2TH.2.2","number":"2","text":"\u043d\u0435 \u0441\u043f\u0435\u0448\u0438\u0442\u044c \u043a\u043e\u043b\u0435\u0431\u0430\u0442\u044c\u0441\u044f \u0443\u043c\u043e\u043c \u0438 \u0441\u043c\u0443\u0449\u0430\u0442\u044c\u0441\u044f \u043d\u0438 \u043e\u0442 \u0434\u0443\u0445\u0430, \u043d\u0438 \u043e\u0442 \u0441\u043b\u043e\u0432\u0430, \u043d\u0438 \u043e\u0442 \u043f\u043e\u0441\u043b\u0430\u043d\u0438\u044f, \u043a\u0430\u043a \u0431\u044b \u043d\u0430\u043c\u0438 \u043f\u043e\u0441\u043b\u0430\u043d\u043d\u043e\u0433\u043e, \u0431\u0443\u0434\u0442\u043e \u0443\u0436\u0435 \u043d\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u0442 \u0434\u0435\u043d\u044c \u0425\u0440\u0438\u0441\u0442\u043e\u0432.","notes":[]},{"id":"2TH.2.3","number":"3","text":"\u0414\u0430 \u043d\u0435 \u043e\u0431\u043e\u043b\u044c\u0441\u0442\u0438\u0442 \u0432\u0430\u0441 \u043d\u0438\u043a\u0442\u043e \u043d\u0438\u043a\u0430\u043a: \u0438\u0431\u043e \u0434\u0435\u043d\u044c \u0442\u043e\u0442 \u043d\u0435 \u043f\u0440\u0438\u0434\u0435\u0442, \u0434\u043e\u043a\u043e\u043b\u0435 \u043d\u0435 \u043f\u0440\u0438\u0434\u0435\u0442 \u043f\u0440\u0435\u0436\u0434\u0435 \u043e\u0442\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u0435 \u0438 \u043d\u0435 \u043e\u0442\u043a\u0440\u043e\u0435\u0442\u0441\u044f \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0433\u0440\u0435\u0445\u0430, \u0441\u044b\u043d \u043f\u043e\u0433\u0438\u0431\u0435\u043b\u0438,","notes":[]},{"id":"2TH.2.4","number":"4","text":"\u043f\u0440\u043e\u0442\u0438\u0432\u044f\u0449\u0438\u0439\u0441\u044f \u0438 \u043f\u0440\u0435\u0432\u043e\u0437\u043d\u043e\u0441\u044f\u0449\u0438\u0439\u0441\u044f \u0432\u044b\u0448\u0435 \u0432\u0441\u0435\u0433\u043e, \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c\u043e\u0433\u043e \u0411\u043e\u0433\u043e\u043c \u0438\u043b\u0438 \u0441\u0432\u044f\u0442\u044b\u043d\u0435\u044e, \u0442\u0430\u043a \u0447\u0442\u043e \u0432 \u0445\u0440\u0430\u043c\u0435 \u0411\u043e\u0436\u0438\u0435\u043c \u0441\u044f\u0434\u0435\u0442 \u043e\u043d, \u043a\u0430\u043a \u0411\u043e\u0433, \u0432\u044b\u0434\u0430\u0432\u0430\u044f \u0441\u0435\u0431\u044f \u0437\u0430 \u0411\u043e\u0433\u0430.","notes":[]},{"id":"2TH.2.5","number":"5","text":"\u041d\u0435 \u043f\u043e\u043c\u043d\u0438\u0442\u0435 \u043b\u0438, \u0447\u0442\u043e \u044f, \u0435\u0449\u0435 \u043d\u0430\u0445\u043e\u0434\u044f\u0441\u044c \u0443 \u0432\u0430\u0441, \u0433\u043e\u0432\u043e\u0440\u0438\u043b \u0432\u0430\u043c \u044d\u0442\u043e?","notes":[]},{"id":"2TH.2.6","number":"6","text":"\u0418 \u043d\u044b\u043d\u0435 \u0432\u044b \u0437\u043d\u0430\u0435\u0442\u0435, \u0447\u0442\u043e \u043d\u0435 \u0434\u043e\u043f\u0443\u0441\u043a\u0430\u0435\u0442 \u043e\u0442\u043a\u0440\u044b\u0442\u044c\u0441\u044f \u0435\u043c\u0443 \u0432 \u0441\u0432\u043e\u0435 \u0432\u0440\u0435\u043c\u044f.","notes":[]},{"id":"2TH.2.7","number":"7","text":"\u0418\u0431\u043e \u0442\u0430\u0439\u043d\u0430 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u0438\u044f \u0443\u0436\u0435 \u0432 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0438, \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0435 \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u0442\u0441\u044f \u0434\u043e \u0442\u0435\u0445 \u043f\u043e\u0440, \u043f\u043e\u043a\u0430 \u043d\u0435 \u0431\u0443\u0434\u0435\u0442 \u0432\u0437\u044f\u0442 \u043e\u0442 \u0441\u0440\u0435\u0434\u044b \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0449\u0438\u0439 \u0442\u0435\u043f\u0435\u0440\u044c.","notes":[]},{"id":"2TH.2.8","number":"8","text":"\u0418 \u0442\u043e\u0433\u0434\u0430 \u043e\u0442\u043a\u0440\u043e\u0435\u0442\u0441\u044f \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0438\u043a, \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u0418\u0438\u0441\u0443\u0441 \u0443\u0431\u044c\u0435\u0442 \u0434\u0443\u0445\u043e\u043c \u0443\u0441\u0442 \u0421\u0432\u043e\u0438\u0445 \u0438 \u0438\u0441\u0442\u0440\u0435\u0431\u0438\u0442 \u044f\u0432\u043b\u0435\u043d\u0438\u0435\u043c \u043f\u0440\u0438\u0448\u0435\u0441\u0442\u0432\u0438\u044f \u0421\u0432\u043e\u0435\u0433\u043e","notes":[]},{"id":"2TH.2.9","number":"9","text":"\u0442\u043e\u0433\u043e, \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043f\u0440\u0438\u0448\u0435\u0441\u0442\u0432\u0438\u0435, \u043f\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044e \u0441\u0430\u0442\u0430\u043d\u044b, \u0431\u0443\u0434\u0435\u0442 \u0441\u043e \u0432\u0441\u044f\u043a\u043e\u044e \u0441\u0438\u043b\u043e\u044e \u0438 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u044f\u043c\u0438 \u0438 \u0447\u0443\u0434\u0435\u0441\u0430\u043c\u0438 \u043b\u043e\u0436\u043d\u044b\u043c\u0438,","notes":[]},{"id":"2TH.2.10","number":"10","text":"\u0438 \u0441\u043e \u0432\u0441\u044f\u043a\u0438\u043c \u043d\u0435\u043f\u0440\u0430\u0432\u0435\u0434\u043d\u044b\u043c \u043e\u0431\u043e\u043b\u044c\u0449\u0435\u043d\u0438\u0435\u043c \u043f\u043e\u0433\u0438\u0431\u0430\u044e\u0449\u0438\u0445 \u0437\u0430 \u0442\u043e, \u0447\u0442\u043e \u043e\u043d\u0438 \u043d\u0435 \u043f\u0440\u0438\u043d\u044f\u043b\u0438 \u043b\u044e\u0431\u0432\u0438 \u0438\u0441\u0442\u0438\u043d\u044b \u0434\u043b\u044f \u0441\u0432\u043e\u0435\u0433\u043e \u0441\u043f\u0430\u0441\u0435\u043d\u0438\u044f.","notes":[]},{"id":"2TH.2.11","number":"11","text":"\u0418 \u0437\u0430 \u0441\u0438\u0435 \u043f\u043e\u0448\u043b\u0435\u0442 \u0438\u043c \u0411\u043e\u0433 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0437\u0430\u0431\u043b\u0443\u0436\u0434\u0435\u043d\u0438\u044f, \u0442\u0430\u043a \u0447\u0442\u043e \u043e\u043d\u0438 \u0431\u0443\u0434\u0443\u0442 \u0432\u0435\u0440\u0438\u0442\u044c \u043b\u0436\u0438,","notes":[]},{"id":"2TH.2.12","number":"12","text":"\u0434\u0430 \u0431\u0443\u0434\u0443\u0442 \u043e\u0441\u0443\u0436\u0434\u0435\u043d\u044b \u0432\u0441\u0435, \u043d\u0435\u0432\u0435\u0440\u043e\u0432\u0430\u0432\u0448\u0438\u0435 \u0438\u0441\u0442\u0438\u043d\u0435, \u043d\u043e \u0432\u043e\u0437\u043b\u044e\u0431\u0438\u0432\u0448\u0438\u0435 \u043d\u0435\u043f\u0440\u0430\u0432\u0434\u0443.","notes":[]},{"id":"2TH.2.13","number":"13","text":"\u041c\u044b \u0436\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u0434\u043e\u043b\u0436\u043d\u044b \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u0438\u0442\u044c \u0411\u043e\u0433\u0430 \u0437\u0430 \u0432\u0430\u0441, \u0432\u043e\u0437\u043b\u044e\u0431\u043b\u0435\u043d\u043d\u044b\u0435 \u0413\u043e\u0441\u043f\u043e\u0434\u043e\u043c \u0431\u0440\u0430\u0442\u0438\u044f, \u0447\u0442\u043e \u0411\u043e\u0433 \u043e\u0442 \u043d\u0430\u0447\u0430\u043b\u0430, \u0447\u0435\u0440\u0435\u0437 \u043e\u0441\u0432\u044f\u0449\u0435\u043d\u0438\u0435 \u0414\u0443\u0445\u0430 \u0438 \u0432\u0435\u0440\u0443 \u0438\u0441\u0442\u0438\u043d\u0435, \u0438\u0437\u0431\u0440\u0430\u043b \u0432\u0430\u0441 \u043a\u043e \u0441\u043f\u0430\u0441\u0435\u043d\u0438\u044e,","notes":[]},{"id":"2TH.2.14","number":"14","text":"\u043a \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443 \u0438 \u043f\u0440\u0438\u0437\u0432\u0430\u043b \u0432\u0430\u0441 \u0431\u043b\u0430\u0433\u043e\u0432\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u043d\u0430\u0448\u0438\u043c, \u0434\u043b\u044f \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0441\u043b\u0430\u0432\u044b \u0413\u043e\u0441\u043f\u043e\u0434\u0430 \u043d\u0430\u0448\u0435\u0433\u043e \u0418\u0438\u0441\u0443\u0441\u0430 \u0425\u0440\u0438\u0441\u0442\u0430.","notes":[]},{"id":"2TH.2.15","number":"15","text":"\u0418\u0442\u0430\u043a, \u0431\u0440\u0430\u0442\u0438\u044f, \u0441\u0442\u043e\u0439\u0442\u0435 \u0438 \u0434\u0435\u0440\u0436\u0438\u0442\u0435 \u043f\u0440\u0435\u0434\u0430\u043d\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u043c \u0432\u044b \u043d\u0430\u0443\u0447\u0435\u043d\u044b \u0438\u043b\u0438 \u0441\u043b\u043e\u0432\u043e\u043c \u0438\u043b\u0438 \u043f\u043e\u0441\u043b\u0430\u043d\u0438\u0435\u043c \u043d\u0430\u0448\u0438\u043c.","notes":[]},{"id":"2TH.2.16","number":"16","text":"\u0421\u0430\u043c \u0436\u0435 \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u043d\u0430\u0448 \u0418\u0438\u0441\u0443\u0441 \u0425\u0440\u0438\u0441\u0442\u043e\u0441 \u0438 \u0411\u043e\u0433 \u0438 \u041e\u0442\u0435\u0446 \u043d\u0430\u0448, \u0432\u043e\u0437\u043b\u044e\u0431\u0438\u0432\u0448\u0438\u0439 \u043d\u0430\u0441 \u0438 \u0434\u0430\u0432\u0448\u0438\u0439 \u0443\u0442\u0435\u0448\u0435\u043d\u0438\u0435 \u0432\u0435\u0447\u043d\u043e\u0435 \u0438 \u043d\u0430\u0434\u0435\u0436\u0434\u0443 \u0431\u043b\u0430\u0433\u0443\u044e \u0432\u043e \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0442\u0438,","notes":[]},{"id":"2TH.2.17","number":"17","text":"\u0434\u0430 \u0443\u0442\u0435\u0448\u0438\u0442 \u0432\u0430\u0448\u0438 \u0441\u0435\u0440\u0434\u0446\u0430 \u0438 \u0434\u0430 \u0443\u0442\u0432\u0435\u0440\u0434\u0438\u0442 \u0432\u0430\u0441 \u0432\u043e \u0432\u0441\u044f\u043a\u043e\u043c \u0441\u043b\u043e\u0432\u0435 \u0438 \u0434\u0435\u043b\u0435 \u0431\u043b\u0430\u0433\u043e\u043c.","notes":[]}],"3":[{"id":"2TH.3.1","number":"1","text":"\u0418\u0442\u0430\u043a \u043c\u043e\u043b\u0438\u0442\u0435\u0441\u044c \u0437\u0430 \u043d\u0430\u0441, \u0431\u0440\u0430\u0442\u0438\u044f, \u0447\u0442\u043e\u0431\u044b \u0441\u043b\u043e\u0432\u043e \u0413\u043e\u0441\u043