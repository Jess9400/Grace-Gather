{"book":{"code":"MAL","name":"\u041a\u043d\u0438\u0433\u0430 \u043f\u0440\u043e\u0440\u043e\u043a\u0430 \u041c\u0430\u043b\u0430\u0445\u0438\u0438","chapters":4,"verses":55,"sourceBaseUrl":"https://ebible.org/russyn/","sourceChapterDigits":2,"sourceEdition":"\u0421\u0438\u043d\u043e\u0434\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u0435\u0440\u0435\u0432\u043e\u0434","sourceAttribution":"\u0421\u0438\u043d\u043e\u0434\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u0435\u0440\u0435\u0432\u043e\u0434 (Russian Synodal translation). Public domain. Text supplied by eBible.org. Six New Testament selections only.","sourceLicenseUrl":"https://ebible.org/russyn/copyright.htm"},"chapters":{"1":[{"id":"MAL.1.1","number":"1","text":"\u041f\u0440\u043e\u0440\u043e\u0447\u0435\u0441\u043a\u043e\u0435 \u0441\u043b\u043e\u0432\u043e \u0413\u043e\u0441\u043f\u043e\u0434\u0430 \u043a \u0418\u0437\u0440\u0430\u0438\u043b\u044e \u0447\u0435\u0440\u0435\u0437 \u041c\u0430\u043b\u0430\u0445\u0438\u044e.","notes":[]},{"id":"MAL.1.2","number":"2","text":"\u042f \u0432\u043e\u0437\u043b\u044e\u0431\u0438\u043b \u0432\u0430\u0441, \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u0413\u043e\u0441\u043f\u043e\u0434\u044c. \u0410 \u0432\u044b \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u0435: \u201c\u0432 \u0447\u0435\u043c \u044f\u0432\u0438\u043b \u0422\u044b \u043b\u044e\u0431\u043e\u0432\u044c \u043a \u043d\u0430\u043c?\u201d \u041d\u0435 \u0431\u0440\u0430\u0442 \u043b\u0438 \u0418\u0441\u0430\u0432 \u0418\u0430\u043a\u043e\u0432\u0443?- \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u0413\u043e\u0441\u043f\u043e\u0434\u044c; \u0438 \u043e\u0434\u043d\u0430\u043a\u043e \u0436\u0435 \u042f \u0432\u043e\u0437\u043b\u044e\u0431\u0438\u043b \u0418\u0430\u043a\u043e\u0432\u0430,","notes":[]},{"id":"MAL.1.3","number":"3","text":"\u0430 \u0418\u0441\u0430\u0432\u0430 \u0432\u043e\u0437\u043d\u0435\u043d\u0430\u0432\u0438\u0434\u0435\u043b \u0438 \u043f\u0440\u0435\u0434\u0430\u043b \u0433\u043e\u0440\u044b \u0435\u0433\u043e \u043e\u043f\u0443\u0441\u0442\u043e\u0448\u0435\u043d\u0438\u044e \u0438 \u0432\u043b\u0430\u0434\u0435\u043d\u0438\u044f \u0435\u0433\u043e - \u0448\u0430\u043a\u0430\u043b\u0430\u043c \u043f\u0443\u0441\u0442\u044b\u043d\u0438.","notes":[]},{"id":"MAL.1.4","number":"4","text":"\u0415\u0441\u043b\u0438 \u0415\u0434\u043e\u043c \u0441\u043a\u0430\u0436\u0435\u0442: \u201c\u043c\u044b \u0440\u0430\u0437\u043e\u0440\u0435\u043d\u044b, \u043d\u043e \u043c\u044b \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043c \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043d\u043d\u043e\u0435\u201d, \u0442\u043e \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u0421\u0430\u0432\u0430\u043e\u0444 \u0433\u043e\u0432\u043e\u0440\u0438\u0442: \u043e\u043d\u0438 \u043f\u043e\u0441\u0442\u0440\u043e\u044f\u0442, \u0430 \u042f \u0440\u0430\u0437\u0440\u0443\u0448\u0443, \u0438 \u043f\u0440\u043e\u0437\u043e\u0432\u0443\u0442 \u0438\u0445 \u043e\u0431\u043b\u0430\u0441\u0442\u044c\u044e \u043d\u0435\u0447\u0435\u0441\u0442\u0438\u0432\u043e\u044e, \u043d\u0430\u0440\u043e\u0434\u043e\u043c, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u043f\u0440\u043e\u0433\u043d\u0435\u0432\u0430\u043b\u0441\u044f \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430.","notes":[]},{"id":"MAL.1.5","number":"5","text":"\u0418 \u0443\u0432\u0438\u0434\u044f\u0442 \u044d\u0442\u043e \u0433\u043b\u0430\u0437\u0430 \u0432\u0430\u0448\u0438, \u0438 \u0432\u044b \u0441\u043a\u0430\u0436\u0435\u0442\u0435: \u201c\u0432\u043e\u0437\u0432\u0435\u043b\u0438\u0447\u0438\u043b\u0441\u044f \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u043d\u0430\u0434 \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u043c\u0438 \u0418\u0437\u0440\u0430\u0438\u043b\u044f!\u201d","notes":[]},{"id":"MAL.1.6","number":"6","text":"\u0421\u044b\u043d \u0447\u0442\u0438\u0442 \u043e\u0442\u0446\u0430 \u0438 \u0440\u0430\u0431 - \u0433\u043e\u0441\u043f\u043e\u0434\u0438\u043d\u0430 \u0441\u0432\u043e\u0435\u0433\u043e; \u0435\u0441\u043b\u0438 \u042f \u043e\u0442\u0435\u0446, \u0442\u043e \u0433\u0434\u0435 \u043f\u043e\u0447\u0442\u0435\u043d\u0438\u0435 \u043a\u043e \u041c\u043d\u0435? \u0438 \u0435\u0441\u043b\u0438 \u042f \u0413\u043e\u0441\u043f\u043e\u0434\u044c, \u0442\u043e \u0433\u0434\u0435 \u0431\u043b\u0430\u0433\u043e\u0433\u043e\u0432\u0435\u043d\u0438\u0435 \u043f\u0440\u0435\u0434\u043e \u041c\u043d\u043e\u044e? - \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u0421\u0430\u0432\u0430\u043e\u0444 \u0432\u0430\u043c, \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u043a\u0438, \u0431\u0435\u0441\u0441\u043b\u0430\u0432\u044f\u0449\u0438\u0435 \u0438\u043c\u044f \u041c\u043e\u0435. \u0412\u044b \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u0435: \u201c\u0447\u0435\u043c \u043c\u044b \u0431\u0435\u0441\u0441\u043b\u0430\u0432\u0438\u043c \u0438\u043c\u044f \u0422\u0432\u043e\u0435?\u201d","notes":[]},{"id":"MAL.1.7","number":"7","text":"\u0412\u044b \u043f\u0440\u0438\u043d\u043e\u0441\u0438\u0442\u0435 \u043d\u0430 \u0436\u0435\u0440\u0442\u0432\u0435\u043d\u043d\u0438\u043a \u041c\u043e\u0439 \u043d\u0435\u0447\u0438\u0441\u0442\u044b\u0439 \u0445\u043b\u0435\u0431, \u0430 \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u0435: \u201c\u0447\u0435\u043c \u043c\u044b \u0431\u0435\u0441\u0441\u043b\u0430\u0432\u0438\u043c \u0422\u0435\u0431\u044f?\u201d - \u0422\u0435\u043c, \u0447\u0442\u043e \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u0435: \u201c\u0442\u0440\u0430\u043f\u0435\u0437\u0430 \u0413\u043e\u0441\u043f\u043e\u0434\u043d\u044f \u043d\u0435 \u0441\u0442\u043e\u0438\u0442 \u0443\u0432\u0430\u0436\u0435\u043d\u0438\u044f\u201d.","notes":[]},{"id":"MAL.1.8","number":"8","text":"\u0418 \u043a\u043e\u0433\u0434\u0430 \u043f\u0440\u0438\u043d\u043e\u0441\u0438\u0442\u0435 \u0432 \u0436\u0435\u0440\u0442\u0432\u0443 \u0441\u043b\u0435\u043f\u043e\u0435, \u043d\u0435 \u0445\u0443\u0434\u043e \u043b\u0438 \u044d\u0442\u043e? \u0438\u043b\u0438 \u043a\u043e\u0433\u0434\u0430 \u043f\u0440\u0438\u043d\u043e\u0441\u0438\u0442\u0435 \u0445\u0440\u043e\u043c\u043e\u0435 \u0438 \u0431\u043e\u043b\u044c\u043d\u043e\u0435, \u043d\u0435 \u0445\u0443\u0434\u043e \u043b\u0438 \u044d\u0442\u043e? \u041f\u043e\u0434\u043d\u0435\u0441\u0438 \u044d\u0442\u043e \u0442\u0432\u043e\u0435\u043c\u0443 \u043a\u043d\u044f\u0437\u044e; \u0431\u0443\u0434\u0435\u0442 \u043b\u0438 \u043e\u043d \u0434\u043e\u0432\u043e\u043b\u0435\u043d \u0442\u043e\u0431\u043e\u044e \u0438 \u0431\u043b\u0430\u0433\u043e\u0441\u043a\u043b\u043e\u043d\u043d\u043e \u043b\u0438 \u043f\u0440\u0438\u043c\u0435\u0442 \u0442\u0435\u0431\u044f? - \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u0421\u0430\u0432\u0430\u043e\u0444.","notes":[]},{"id":"MAL.1.9","number":"9","text":"\u0418\u0442\u0430\u043a, \u043c\u043e\u043b\u0438\u0442\u0435\u0441\u044c \u0411\u043e\u0433\u0443, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043c\u0438\u043b\u043e\u0432\u0430\u043b \u043d\u0430\u0441; \u0430 \u043a\u043e\u0433\u0434\u0430 \u0442\u0430\u043a\u043e\u0435 \u0438\u0441\u0445\u043e\u0434\u0438\u0442 \u0438\u0437 \u0440\u0443\u043a \u0432\u0430\u0448\u0438\u0445, \u0442\u043e \u043c\u043e\u0436\u0435\u0442 \u043b\u0438 \u041e\u043d \u043c\u0438\u043b\u043e\u0441\u0442\u0438\u0432\u043e \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u044c \u0432\u0430\u0441? - \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u0421\u0430\u0432\u0430\u043e\u0444.","notes":[]},{"id":"MAL.1.10","number":"10","text":"\u041b\u0443\u0447\u0448\u0435 \u043a\u0442\u043e-\u043d\u0438\u0431\u0443\u0434\u044c \u0438\u0437 \u0432\u0430\u0441 \u0437\u0430\u043f\u0435\u0440 \u0431\u044b \u0434\u0432\u0435\u0440\u0438, \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u043f\u0440\u0430\u0441\u043d\u043e \u043d\u0435 \u0434\u0435\u0440\u0436\u0430\u043b\u0438 \u043e\u0433\u043d\u044f \u043d\u0430 \u0436\u0435\u0440\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u0435 \u041c\u043e\u0435\u043c. \u041d\u0435\u0442 \u041c\u043e\u0435\u0433\u043e \u0431\u043b\u0430\u0433\u043e\u0432\u043e\u043b\u0435\u043d\u0438\u044f \u043a \u0432\u0430\u043c, \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u0421\u0430\u0432\u0430\u043e\u0444, \u0438 \u043f\u0440\u0438\u043d\u043e\u0448\u0435\u043d\u0438\u0435 \u0438\u0437 \u0440\u0443\u043a \u0432\u0430\u0448\u0438\u0445 \u043d\u0435 \u0431\u043b\u0430\u0433\u043e\u0443\u0433\u043e\u0434\u043d\u043e \u041c\u043d\u0435.","notes":[]},{"id":"MAL.1.11","number":"11","text":"\u0418\u0431\u043e \u043e\u0442 \u0432\u043e\u0441\u0445\u043e\u0434\u0430 \u0441\u043e\u043b\u043d\u0446\u0430 \u0434\u043e \u0437\u0430\u043f\u0430\u0434\u0430 \u0432\u0435\u043b\u0438\u043a\u043e \u0431\u0443\u0434\u0435\u0442 \u0438\u043c\u044f \u041c\u043e\u0435 \u043c\u0435\u0436\u0434\u0443 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0438, \u0438 \u043d\u0430 \u0432\u0441\u044f\u043a\u043e\u043c \u043c\u0435\u0441\u0442\u0435 \u0431\u0443\u0434\u0443\u0442 \u043f\u0440\u0438\u043d\u043e\u0441\u0438\u0442\u044c \u0444\u0438\u043c\u0438\u0430\u043c \u0438\u043c\u0435\u043d\u0438 \u041c\u043e\u0435\u043c\u0443, \u0447\u0438\u0441\u0442\u0443\u044e \u0436\u0435\u0440\u0442\u0432\u0443; \u0432\u0435\u043b\u0438\u043a\u043e \u0431\u0443\u0434\u0435\u0442 \u0438\u043c\u044f \u041c\u043e\u0435 \u043c\u0435\u0436\u0434\u0443 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0438, \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u0421\u0430\u0432\u0430\u043e\u0444.","notes":[]},{"id":"MAL.1.12","number":"12","text":"\u0410 \u0432\u044b \u0445\u0443\u043b\u0438\u0442\u0435 \u0435\u0433\u043e \u0442\u0435\u043c, \u0447\u0442\u043e \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u0435: \u201c\u0442\u0440\u0430\u043f\u0435\u0437\u0430 \u0413\u043e\u0441\u043f\u043e\u0434\u043d\u044f \u043d\u0435 \u0441\u0442\u043e\u0438\u0442 \u0443\u0432\u0430\u0436\u0435\u043d\u0438\u044f, \u0438 \u0434\u043e\u0445\u043e\u0434 \u043e\u0442 \u043d\u0435\u0435 - \u043f\u0438\u0449\u0430 \u043d\u0438\u0447\u0442\u043e\u0436\u043d\u0430\u044f\u201d.","notes":[]},{"id":"MAL.1.13","number":"13","text":"\u041f\u0440\u0438\u0442\u043e\u043c \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u0435: \u201c\u0432\u043e\u0442 \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0442\u0440\u0443\u0434\u0430!\u201d - \u0438 \u043f\u0440\u0435\u043d\u0435\u0431\u0440\u0435\u0433\u0430\u0435\u0442\u0435 \u0435\u044e, \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u0421\u0430\u0432\u0430\u043e\u0444, \u0438 \u043f\u0440\u0438\u043d\u043e\u0441\u0438\u0442\u0435 \u0443\u043a\u0440\u0430\u0434\u0435\u043d\u043d\u043e\u0435, \u0445\u0440\u043e\u043c\u043e\u0435 \u0438 \u0431\u043e\u043b\u044c\u043d\u043e\u0435, \u0438 \u0442\u0430\u043a\u043e\u0433\u043e \u0436\u0435 \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430 \u043f\u0440\u0438\u043d\u043e\u0441\u0438\u0442\u0435 \u0445\u043b\u0435\u0431\u043d\u044b\u0439 \u0434\u0430\u0440: \u043c\u043e\u0433\u0443 \u043b\u0438 \u0441 \u0431\u043b\u0430\u0433\u043e\u0432\u043e\u043b\u0435\u043d\u0438\u0435\u043c \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u044c \u044d\u0442\u043e \u0438\u0437 \u0440\u0443\u043a \u0432\u0430\u0448\u0438\u0445? - \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u0413\u043e\u0441\u043f\u043e\u0434\u044c.","notes":[]},{"id":"MAL.1.14","number":"14","text":"\u041f\u0440\u043e\u043a\u043b\u044f\u0442 \u043b\u0436\u0438\u0432\u044b\u0439, \u0443 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0432 \u0441\u0442\u0430\u0434\u0435 \u0435\u0441\u0442\u044c \u043d\u0435\u0438\u0441\u043f\u043e\u0440\u0447\u0435\u043d\u043d\u044b\u0439 \u0441\u0430\u043c\u0435\u0446, \u0438 \u043e\u043d \u0434\u0430\u043b \u043e\u0431\u0435\u0442, \u0430 \u043f\u0440\u0438\u043d\u043e\u0441\u0438\u0442 \u0432 \u0436\u0435\u0440\u0442\u0432\u0443 \u0413\u043e\u0441\u043f\u043e\u0434\u0443 \u043f\u043e\u0432\u0440\u0435\u0436\u0434\u0435\u043d\u043d\u043e\u0435: \u0438\u0431\u043e \u042f \u0426\u0430\u0440\u044c \u0432\u0435\u043b\u0438\u043a\u0438\u0439, \u0438 \u0438\u043c\u044f \u041c\u043e\u0435 \u0441\u0442\u0440\u0430\u0448\u043d\u043e \u0443 \u043d\u0430\u0440\u043e\u0434\u043e\u0432.","notes":[]}],"2":[{"id":"MAL.2.1","number":"1","text":"\u0418\u0442\u0430\u043a, \u0434\u043b\u044f \u0432\u0430\u0441, \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u043a\u0438, \u044d\u0442\u0430 \u0437\u0430\u043f\u043e\u0432\u0435\u0434\u044c:","notes":[]},{"id":"MAL.2.2","number":"2","text":"\u0435\u0441\u043b\u0438 \u0432\u044b \u043d\u0435 \u043f\u043e\u0441\u043b\u0443\u0448\u0430\u0435\u0442\u0435\u0441\u044c \u0438 \u0435\u0441\u043b\u0438 \u043d\u0435 \u043f\u0440\u0438\u043c\u0435\u0442\u0435 \u043a \u0441\u0435\u0440\u0434\u0446\u0443, \u0447\u0442\u043e\u0431\u044b \u0432\u043e\u0437\u0434\u0430\u0432\u0430\u0442\u044c \u0441\u043b\u0430\u0432\u0443 \u0438\u043c\u0435\u043d\u0438 \u041c\u043e\u0435\u043c\u0443, \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u0421\u0430\u0432\u0430\u043e\u0444, \u0442\u043e \u042f \u043f\u043e\u0448\u043b\u044e \u043d\u0430 \u0432\u0430\u0441 \u043f\u0440\u043e\u043a\u043b\u044f\u0442\u0438\u0435 \u0438 \u043f\u0440\u043e\u043a\u043b\u044f\u043d\u0443 \u0432\u0430\u0448\u0438 \u0431\u043b\u0430\u0433\u043e\u0441\u043b\u043e\u0432\u0435\u043d\u0438\u044f, \u0438 \u0443\u0436\u0435 \u043f\u0440\u043e\u043a\u043b\u0438\u043d\u0430\u044e, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0432\u044b \u043d\u0435 \u0445\u043e\u0442\u0438\u0442\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0438\u0442\u044c \u043a \u0442\u043e\u043c\u0443 \u0441\u0435\u0440\u0434\u0446\u0430.","notes":[]},{"id":"MAL.2.3","number":"3","text":"\u0412\u043e\u0442, \u042f \u043e\u0442\u043d\u0438\u043c\u0443 \u0443 \u0432\u0430\u0441 \u043f\u043b\u0435\u0447\u043e, \u0438 \u043f\u043e\u043c\u0435\u0442 \u0440\u0430\u0441\u043a\u0438\u0434\u0430\u044e \u043d\u0430 \u043b\u0438\u0446\u0430 \u0432\u0430\u0448\u0438, \u043f\u043e\u043c\u0435\u0442 \u043f\u0440\u0430\u0437\u0434\u043d\u0438\u0447\u043d\u044b\u0445 \u0436\u0435\u0440\u0442\u0432 \u0432\u0430\u0448\u0438\u0445, \u0438 \u0432\u044b\u0431\u0440\u043e\u0441\u044f\u0442 \u0432\u0430\u0441 \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u043d\u0438\u043c.","notes":[]},{"id":"MAL.2.4","number":"4","text":"\u0418 \u0432\u044b \u0443\u0437\u043d\u0430\u0435\u0442\u0435, \u0447\u0442\u043e \u042f \u0434\u0430\u043b \u044d\u0442\u0443 \u0437\u0430\u043f\u043e\u0432\u0435\u0434\u044c \u0434\u043b\u044f \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f \u0437\u0430\u0432\u0435\u0442\u0430 \u041c\u043e\u0435\u0433\u043e \u0441 \u041b\u0435\u0432\u0438\u0435\u043c, \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u0421\u0430\u0432\u0430\u043e\u0444.","notes":[]},{"id":"MAL.2.5","number":"5","text":"\u0417\u0430\u0432\u0435\u0442 \u041c\u043e\u0439 \u0441 \u043d\u0438\u043c \u0431\u044b\u043b \u0437\u0430\u0432\u0435\u0442 \u0436\u0438\u0437\u043d\u0438 \u0438 \u043c\u0438\u0440\u0430, \u0438 \u042f \u0434\u0430\u043b \u0435\u0433\u043e \u0435\u043c\u0443 \u0434\u043b\u044f \u0441\u0442\u0440\u0430\u0445\u0430, \u0438 \u043e\u043d \u0431\u043e\u044f\u043b\u0441\u044f \u041c\u0435\u043d\u044f \u0438 \u0431\u043b\u0430\u0433\u043e\u0433\u043e\u0432\u0435\u043b \u043f\u0440\u0435\u0434 \u0438\u043c\u0435\u043d\u0435\u043c \u041c\u043e\u0438\u043c.","notes":[]},{"id":"MAL.2.6","number":"6","text":"\u0417\u0430\u043a\u043e\u043d \u0438\u0441\u0442\u0438\u043d\u044b \u0431\u044b\u043b \u0432 \u0443\u0441\u0442\u0430\u0445 \u0435\u0433\u043e, \u0438 \u043d\u0435\u043f\u0440\u0430\u0432\u0434\u044b \u043d\u0435 \u043e\u0431\u0440\u0435\u0442\u0430\u043b\u043e\u0441\u044c \u043d\u0430 \u044f\u0437\u044b\u043a\u0435 \u0435\u0433\u043e; \u0432 \u043c\u0438\u0440\u0435 \u0438 \u043f\u0440\u0430\u0432\u0434\u0435 \u043e\u043d \u0445\u043e\u0434\u0438\u043b \u0441\u043e \u041c\u043d\u043e\u044e \u0438 \u043c\u043d\u043e\u0433\u0438\u0445 \u043e\u0442\u0432\u0440\u0430\u0442\u0438\u043b \u043e\u0442 \u0433\u0440\u0435\u0445\u0430.","notes":[]},{"id":"MAL.2.7","number":"7","text":"\u0418\u0431\u043e \u0443\u0441\u0442\u0430 \u0441\u0432\u044f\u0449\u0435\u043d\u043d\u0438\u043a\u0430 \u0434\u043e\u043b\u0436\u043d\u044b \u0445\u0440\u0430\u043d\u0438\u0442\u044c \u0432\u0435\u0434\u0435\u043d\u0438\u0435, \u0438 \u0437\u0430\u043a\u043e\u043d\u0430 \u0438\u0449\u0443\u0442 \u043e\u0442 \u0443\u0441\u0442 \u0435\u0433\u043e, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043e\u043d \u0432\u0435\u0441\u0442\u043d\u0438\u043a \u0413\u043e\u0441\u043f\u043e\u0434\u0430 \u0421\u0430\u0432\u0430\u043e\u0444\u0430.","notes":[]},{"id":"MAL.2.8","number":"8","text":"\u041d\u043e \u0432\u044b \u0443\u043a\u043b\u043e\u043d\u0438\u043b\u0438\u0441\u044c \u043e\u0442 \u043f\u0443\u0442\u0438 \u0441\u0435\u0433\u043e, \u0434\u043b\u044f \u043c\u043d\u043e\u0433\u0438\u0445 \u043f\u043e\u0441\u043b\u0443\u0436\u0438\u043b\u0438 \u0441\u043e\u0431\u043b\u0430\u0437\u043d\u043e\u043c \u0432 \u0437\u0430\u043a\u043e\u043d\u0435, \u0440\u0430\u0437\u0440\u0443\u0448\u0438\u043b\u0438 \u0437\u0430\u0432\u0435\u0442 \u041b\u0435\u0432\u0438\u044f, \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u0421\u0430\u0432\u0430\u043e\u0444.","notes":[]},{"id":"MAL.2.9","number":"9","text":"\u0417\u0430 \u0442\u043e \u0438 \u042f \u0441\u0434\u0435\u043b\u0430\u044e \u0432\u0430\u0441 \u043f\u0440\u0435\u0437\u0440\u0435\u043d\u043d\u044b\u043c\u0438 \u0438 \u0443\u043d\u0438\u0436\u0435\u043d\u043d\u044b\u043c\u0438 \u043f\u0435\u0440\u0435\u0434 \u0432\u0441\u0435\u043c \u043d\u0430\u0440\u043e\u0434\u043e\u043c, \u0442\u0430\u043a \u043a\u0430\u043a \u0432\u044b \u043d\u0435 \u0441\u043e\u0431\u043b\u044e\u0434\u0430\u0435\u0442\u0435 \u043f\u0443\u0442\u0435\u0439 \u041c\u043e\u0438\u0445, \u043b\u0438\u0446\u0435\u043f\u0440\u0438\u044f\u0442\u0441\u0442\u0432\u0443\u0435\u0442\u0435 \u0432 \u0434\u0435\u043b\u0430\u0445 \u0437\u0430\u043a\u043e\u043d\u0430.","notes":[]},{"id":"MAL.2.10","number":"10","text":"\u041d\u0435 \u043e\u0434\u0438\u043d \u043b\u0438 \u0443 \u0432\u0441\u0435\u0445 \u043d\u0430\u0441 \u041e\u0442\u0435\u0446? \u041d\u0435 \u043e\u0434\u0438\u043d \u043b\u0438 \u0411\u043e\u0433 \u0441\u043e\u0442\u0432\u043e\u0440\u0438\u043b \u043d\u0430\u0441? \u041f\u043e\u0447\u0435\u043c\u0443 \u0436\u0435 \u043c\u044b \u0432\u0435\u0440\u043e\u043b\u043e\u043c\u043d\u043e \u043f\u043e\u0441\u0442\u0443\u043f\u0430\u0435\u043c \u0434\u0440\u0443\u0433 \u043f\u0440\u043e\u0442\u0438\u0432 \u0434\u0440\u0443\u0433\u0430, \u043d\u0430\u0440\u0443\u0448\u0430\u044f \u0442\u0435\u043c \u0437\u0430\u0432\u0435\u0442 \u043e\u0442\u0446\u043e\u0432 \u043d\u0430\u0448\u0438\u0445?","notes":[]},{"id":"MAL.2.11","number":"11","text":"\u0412\u0435\u0440\u043e\u043b\u043e\u043c\u043d\u043e \u043f\u043e\u0441\u0442\u0443\u043f\u0430\u0435\u0442 \u0418\u0443\u0434\u0430, \u0438 \u043c\u0435\u0440\u0437\u043e\u0441\u0442\u044c \u0441\u043e\u0432\u0435\u0440\u0448\u0430\u0435\u0442\u0441\u044f \u0432 \u0418\u0437\u0440\u0430\u0438\u043b\u0435 \u0438 \u0432 \u0418\u0435\u0440\u0443\u0441\u0430\u043b\u0438\u043c\u0435; \u0438\u0431\u043e \u0443\u043d\u0438\u0437\u0438\u043b \u0418\u0443\u0434\u0430 \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u0413\u043e\u0441\u043f\u043e\u0434\u043d\u044e, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043b\u044e\u0431\u0438\u043b, \u0438 \u0436\u0435\u043d\u0438\u043b\u0441\u044f \u043d\u0430 \u0434\u043e\u0447\u0435\u0440\u0438 \u0447\u0443\u0436\u043e\u0433\u043e \u0431\u043e\u0433\u0430.","notes":[]},{"id":"MAL.2.12","number":"12","text":"\u0423 \u0442\u043e\u0433\u043e, \u043a\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442 \u044d\u0442\u043e, \u0438\u0441\u0442\u0440\u0435\u0431\u0438\u0442 \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u0438\u0437 \u0448\u0430\u0442\u0440\u043e\u0432 \u0418\u0430\u043a\u043e\u0432\u043b\u0435\u0432\u044b\u0445 \u0431\u0434\u044f\u0449\u0435\u0433\u043e \u043d\u0430 \u0441\u0442\u0440\u0430\u0436\u0435 \u0438 \u043e\u0442\u0432\u0435\u0447\u0430\u044e\u0449\u0435\u0433\u043e, \u0438 \u043f\u0440\u0438\u043d\u043e\u0441\u044f\u0449\u0435\u0433\u043e \u0436\u0435\u0440\u0442\u0432\u0443 \u0413\u043e\u0441\u043f\u043e\u0434\u0443 \u0421\u0430\u0432\u0430\u043e\u0444\u0443.","notes":[]},{"id":"MAL.2.13","number":"13","text":"\u0418 \u0432\u043e\u0442 \u0435\u0449\u0435 \u0447\u0442\u043e \u0432\u044b \u0434\u0435\u043b\u0430\u0435\u0442\u0435: \u0432\u044b \u0437\u0430\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442\u0435 \u043e\u0431\u043b\u0438\u0432\u0430\u0442\u044c \u0441\u043b\u0435\u0437\u0430\u043c\u0438 \u0436\u0435\u0440\u0442\u0432\u0435\u043d\u043d\u0438\u043a \u0413\u043e\u0441\u043f\u043e\u0434\u0430 \u0441 \u0440\u044b\u0434\u0430\u043d\u0438\u0435\u043c \u0438 \u0432\u043e\u043f\u043b\u0435\u043c, \u0442\u0430\u043a \u0447\u0442\u043e \u041e\u043d \u0443\u0436\u0435 \u043d\u0435 \u043f\u0440\u0438\u0437\u0438\u0440\u0430\u0435\u0442 \u0431\u043e\u043b\u0435\u0435 \u043d\u0430 \u043f\u0440\u0438\u043d\u043e\u0448\u0435\u043d\u0438\u0435 \u0438 \u043d\u0435 \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442 \u0443\u043c\u0438\u043b\u043e\u0441\u0442\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0436\u0435\u0440\u0442\u0432\u044b \u0438\u0437 \u0440\u0443\u043a \u0432\u0430\u0448\u0438\u0445.","notes":[]},{"id":"MAL.2.14","number":"14","text":"\u0412\u044b \u0441\u043a\u0430\u0436\u0435\u0442\u0435: \u201c\u0437\u0430 \u0447\u0442\u043e?\u201d \u0417\u0430 \u0442\u043e, \u0447\u0442\u043e \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u0431\u044b\u043b \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u0435\u043c \u043c\u0435\u0436\u0434\u0443 \u0442\u043e\u0431\u043e\u044e \u0438 \u0436\u0435\u043d\u043e\u044e \u044e\u043d\u043e\u0441\u0442\u0438 \u0442\u0432\u043e\u0435\u0439, \u043f\u0440\u043e\u0442\u0438\u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0442\u044b \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0432\u0435\u0440\u043e\u043b\u043e\u043c\u043d\u043e, \u043c\u0435\u0436\u0434\u0443 \u0442\u0435\u043c \u043a\u0430\u043a \u043e\u043d\u0430 \u043f\u043e\u0434\u0440\u0443\u0433\u0430 \u0442\u0432\u043e\u044f \u0438 \u0437\u0430\u043a\u043e\u043d\u043d\u0430\u044f \u0436\u0435\u043d\u0430 \u0442\u0432\u043e\u044f.","notes":[]},{"id":"MAL.2.15","number":"15","text":"\u041d\u043e \u043d\u0435 \u0441\u0434\u0435\u043b\u0430\u043b \u043b\u0438 \u0442\u043e\u0433\u043e \u0436\u0435 \u043e\u0434\u0438\u043d, \u0438 \u0432 \u043d\u0435\u043c \u043f\u0440\u0435\u0431\u044b\u0432\u0430\u043b \u043f\u0440\u0435\u0432\u043e\u0441\u0445\u043e\u0434\u043d\u044b\u0439 \u0434\u0443\u0445? \u0427\u0442\u043e \u0436\u0435 \u0441\u0434\u0435\u043b\u0430\u043b \u044d\u0442\u043e\u0442 \u043e\u0434\u0438\u043d? \u041e\u043d \u0436\u0435\u043b\u0430\u043b \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u043e\u0442 \u0411\u043e\u0433\u0430 \u043f\u043e\u0442\u043e\u043c\u0441\u0442\u0432\u043e. \u0418\u0442\u0430\u043a, \u0431\u0435\u0440\u0435\u0433\u0438\u0442\u0435 \u0434\u0443\u0445 \u0432\u0430\u0448, \u0438 \u043d\u0438\u043a\u0442\u043e \u043d\u0435 \u043f\u043e\u0441\u0442\u0443\u043f\u0430\u0439 \u0432\u0435\u0440\u043e\u043b\u043e\u043c\u043d\u043e \u043f\u0440\u043e\u0442\u0438\u0432 \u0436\u0435\u043d\u044b \u044e\u043d\u043e\u0441\u0442\u0438 \u0441\u0432\u043e\u0435\u0439.","notes":[]},{"id":"MAL.2.16","number":"16","text":"\u0415\u0441\u043b\u0438 \u0442\u044b \u043d\u0435\u043d\u0430\u0432\u0438\u0434\u0438\u0448\u044c \u0435\u0435, \u043e\u0442\u043f\u0443\u0441\u0442\u0438, \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u0411\u043e\u0433 \u0418\u0437\u0440\u0430\u0438\u043b\u0435\u0432; \u043e\u0431\u0438\u0434\u0430 \u043f\u043e\u043a\u0440\u043e\u0435\u0442 \u043e\u0434\u0435\u0436\u0434\u0443 \u0435\u0433\u043e, \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u0421\u0430\u0432\u0430\u043e\u0444; \u043f\u043e\u0441\u0435\u043c\u0443 \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0439\u0442\u0435 \u0437\u0430 \u0434\u0443\u0445\u043e\u043c \u0432\u0430\u0448\u0438\u043c \u0438 \u043d\u0435 \u043f\u043e\u0441\u0442\u0443\u043f\u0430\u0439\u0442\u0435 \u0432\u0435\u0440\u043e\u043b\u043e\u043c\u043d\u043e.","notes":[]},{"id":"MAL.2.17","number":"17","text":"\u0412\u044b \u043f\u0440\u043e\u0433\u043d\u0435\u0432\u043b\u044f\u0435\u0442\u0435 \u0413\u043e\u0441\u043f\u043e\u0434\u0430 \u0441\u043b\u043e\u0432\u0430\u043c\u0438 \u0432\u0430\u0448\u0438\u043c\u0438 \u0438 \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u0435: \u201c\u0447\u0435\u043c \u043f\u0440\u043e\u0433\u043d\u0435\u0432\u043b\u044f\u0435\u043c \u043c\u044b \u0415\u0433\u043e?\u201d \u0422\u0435\u043c, \u0447\u0442\u043e \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u0435: \u201c\u0432\u0441\u044f\u043a\u0438\u0439, \u0434\u0435\u043b\u0430\u044e\u0449\u0438\u0439 \u0437\u043b\u043e, \u0445\u043e\u0440\u043e\u0448 \u043f\u0440\u0435\u0434 \u043e\u0447\u0430\u043c\u0438 \u0413\u043e\u0441\u043f\u043e\u0434\u0430, \u0438 \u043a \u0442\u0430\u043a\u0438\u043c \u041e\u043d \u0431\u043b\u0430\u0433\u043e\u0432\u043e\u043b\u0438\u0442\u201d, \u0438\u043b\u0438: \u201c\u0433\u0434\u0435 \u0411\u043e\u0433 \u043f\u0440\u0430\u0432\u043e\u0441\u0443\u0434\u0438\u044f?\u201d","notes":[]}],"3":[{"id":"MAL.3.1","number":"1","text":"\u0412\u043e\u0442, \u042f \u043f\u043e\u0441\u044b\u043b\u0430\u044e \u0410\u043d\u0433\u0435\u043b\u0430 \u041c\u043e\u0435\u0433\u043e, \u0438 \u043e\u043d \u043f\u0440\u0438\u0433\u043e\u0442\u043e\u0432\u0438\u0442 \u043f\u0443\u0442\u044c \u043f\u0440\u0435\u0434\u043e \u041c\u043d\u043e\u044e, \u0438 \u0432\u043d\u0435\u0437\u0430\u043f\u043d\u043e \u043f\u0440\u0438\u0434\u0435\u0442 \u0432 \u0445\u0440\u0430\u043c \u0421\u0432\u043e\u0439 \u0413\u043e\u0441\u043f\u043e\u0434\u044c, \u041a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0432\u044b \u0438\u0449\u0435\u0442\u0435, \u0438 \u0410\u043d\u0433\u0435\u043b \u0437\u0430\u0432\u0435\u0442\u0430, \u041a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0432\u044b \u0436\u0435\u043b\u0430\u0435\u0442\u0435; \u0432\u043e\u0442, \u041e\u043d \u0438\u0434\u0435\u0442, \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u0421\u0430\u0432\u0430\u043e\u0444.","notes":[]},{"id":"MAL.3.2","number":"2","text":"\u0418 \u043a\u0442\u043e \u0432\u044b\u0434\u0435\u0440\u0436\u0438\u0442 \u0434\u0435\u043d\u044c \u043f\u0440\u0438\u0448\u0435\u0441\u0442\u0432\u0438\u044f \u0415\u0433\u043e, \u0438 \u043a\u0442\u043e \u0443\u0441\u0442\u043e\u0438\u0442, \u043a\u043e\u0433\u0434\u0430 \u041e\u043d \u044f\u0432\u0438\u0442\u0441\u044f? \u0418\u0431\u043e \u041e\u043d \u043a\u0430\u043a \u043e\u0433\u043e\u043d\u044c \u0440\u0430\u0441\u043f\u043b\u0430\u0432\u043b\u044f\u044e\u0449\u0438\u0439 \u0438 \u043a\u0430\u043a \u0449\u0435\u043b\u043e\u043a \u043e\u0447\u0438\u0449\u0430\u044e\u0449\u0438\u0439,","notes":[]},{"id":"MAL.3.3","number":"3","text":"\u0438 \u0441\u044f\u0434\u0435\u0442 \u043f\u0435\u0440\u0435\u043f\u043b\u0430\u0432\u043b\u044f\u0442\u044c \u0438 \u043e\u0447\u0438\u0449\u0430\u0442\u044c \u0441\u0435\u0440\u0435\u0431\u0440\u043e, \u0438 \u043e\u0447\u0438\u0441\u0442\u0438\u0442 \u0441\u044b\u043d\u043e\u0432 \u041b\u0435\u0432\u0438\u044f \u0438 \u043f\u0435\u0440\u0435\u043f\u043b\u0430\u0432\u0438\u0442 \u0438\u0445, \u043a\u0430\u043a \u0437\u043e\u043b\u043e\u0442\u043e \u0438 \u043a\u0430\u043a \u0441\u0435\u0440\u0435\u0431\u0440\u043e, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u0438\u043d\u043e\u0441\u0438\u043b\u0438 \u0436\u0435\u0440\u0442\u0432\u0443 \u0413\u043e\u0441\u043f\u043e\u0434\u0443 \u0432 \u043f\u0440\u0430\u0432\u0434\u0435.","notes":[]},{"id":"MAL.3.4","number":"4","text":"\u0422\u043e\u0433\u0434\u0430 \u0431\u043b\u0430\u0433\u043e\u043f\u0440\u0438\u044f\u0442\u043d\u0430 \u0431\u0443\u0434\u0435\u0442 \u0413\u043e\u0441\u043f\u043e\u0434\u0443 \u0436\u0435\u0440\u0442\u0432\u0430 \u0418\u0443\u0434\u044b \u0438 \u0418\u0435\u0440\u0443\u0441\u0430\u043b\u0438\u043c\u0430, \u043a\u0430\u043a \u0432\u043e \u0434\u043d\u0438 \u0434\u0440\u0435\u0432\u043d\u0438\u0435 \u0438 \u043a\u0430\u043a \u0432 \u043b\u0435\u0442\u0430 \u043f\u0440\u0435\u0436\u043d\u0438\u0435.","notes":[]},{"id":"MAL.3.5","number":"5","text":"\u0418 \u043f\u0440\u0438\u0434\u0443 \u043a \u0432\u0430\u043c \u0434\u043b\u044f \u0441\u0443\u0434\u0430 \u0438 \u0431\u0443\u0434\u0443 \u0441\u043a\u043e\u0440\u044b\u043c \u043e\u0431\u043b\u0438\u0447\u0438\u0442\u0435\u043b\u0435\u043c \u0447\u0430\u0440\u043e\u0434\u0435\u0435\u0432 \u0438 \u043f\u0440\u0435\u043b\u044e\u0431\u043e\u0434\u0435\u0435\u0432 \u0438 \u0442\u0435\u0445, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043a\u043b\u044f\u043d\u0443\u0442\u0441\u044f \u043b\u043e\u0436\u043d\u043e \u0438 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0442 \u043f\u043b\u0430\u0442\u0443 \u0443 \u043d\u0430\u0435\u043c\u043d\u0438\u043a\u0430, \u043f\u0440\u0438\u0442\u0435\u0441\u043d\u044f\u044e\u0442 \u0432\u0434\u043e\u0432\u0443 \u0438 \u0441\u0438\u0440\u043e\u0442\u0443, \u0438 \u043e\u0442\u0442\u0430\u043b\u043a\u0438\u0432\u0430\u044e\u0442 \u043f\u0440\u0438\u0448\u0435\u043b\u044c\u0446\u0430, \u0438 \u041c\u0435\u043d\u044f \u043d\u0435 \u0431\u043e\u044f\u0442\u0441\u044f, \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u0421\u0430\u0432\u0430\u043e\u0444.","notes":[]},{"id":"MAL.3.6","number":"6","text":"\u0418\u0431\u043e \u042f - \u0413\u043e\u0441\u043f\u043e\u0434\u044c, \u042f \u043d\u0435 \u0438\u0437\u043c\u0435\u043d\u044f\u044e\u0441\u044c; \u043f\u043e\u0441\u0435\u043c\u0443 \u0432\u044b, \u0441\u044b\u043d\u044b \u0418\u0430\u043a\u043e\u0432\u0430, \u043d\u0435 \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0438\u043b\u0438\u0441\u044c.","notes":[]},{"id":"MAL.3.7","number":"7","text":"\u0421\u043e \u0434\u043d\u0435\u0439 \u043e\u0442\u0446\u043e\u0432 \u0432\u0430\u0448\u0438\u0445 \u0432\u044b \u043e\u0442\u0441\u0442\u0443\u043f\u0438\u043b\u0438 \u043e\u0442 \u0443\u0441\u0442\u0430\u0432\u043e\u0432 \u041c\u043e\u0438\u0445 \u0438 \u043d\u0435 \u0441\u043e\u0431\u043b\u044e\u0434\u0430\u0435\u0442\u0435 \u0438\u0445; \u043e\u0431\u0440\u0430\u0442\u0438\u0442\u0435\u0441\u044c \u043a\u043e \u041c\u043d\u0435, \u0438 \u044f \u043e\u0431\u0440\u0430\u0449\u0443\u0441\u044c \u043a \u0432\u0430\u043c, \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u0421\u0430\u0432\u0430\u043e\u0444. \u0412\u044b \u0441\u043a\u0430\u0436\u0435\u0442\u0435: \u201c\u043a\u0430\u043a \u043d\u0430\u043c \u043e\u0431\u0440\u0430\u0442\u0438\u0442\u044c\u0441\u044f?\u201d","notes":[]},{"id":"MAL.3.8","number":"8","text":"\u041c\u043e\u0436\u043d\u043e \u043b\u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0443 \u043e\u0431\u043a\u0440\u0430\u0434\u044b\u0432\u0430\u0442\u044c \u0411\u043e\u0433\u0430? \u0410 \u0432\u044b \u043e\u0431\u043a\u0440\u0430\u0434\u044b\u0432\u0430\u0435\u0442\u0435 \u041c\u0435\u043d\u044f. \u0421\u043a\u0430\u0436\u0435\u0442\u0435: \u201c\u0447\u0435\u043c \u043e\u0431\u043a\u0440\u0430\u0434\u044b\u0432\u0430\u0435\u043c \u043c\u044b \u0422\u0435\u0431\u044f?\u201d \u0414\u0435\u0441\u044f\u0442\u0438\u043d\u043e\u044e \u0438 \u043f\u0440\u0438\u043d\u043e\u0448\u0435\u043d\u0438\u044f\u043c\u0438.","notes":[]},{"id":"MAL.3.9","number":"9","text":"\u041f\u0440\u043e\u043a\u043b\u044f\u0442\u0438\u0435\u043c \u0432\u044b \u043f\u0440\u043e\u043a\u043b\u044f\u0442\u044b, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0432\u044b - \u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434 - \u043e\u0431\u043a\u0440\u0430\u0434\u044b\u0432\u0430\u0435\u0442\u0435 \u041c\u0435\u043d\u044f.","notes":[]},{"id":"MAL.3.10","number":"10","text":"\u041f\u0440\u0438\u043d\u0435\u0441\u0438\u0442\u0435 \u0432\u0441\u0435 \u0434\u0435\u0441\u044f\u0442\u0438\u043d\u044b \u0432 \u0434\u043e\u043c \u0445\u0440\u0430\u043d\u0438\u043b\u0438\u0449\u0430, \u0447\u0442\u043e\u0431\u044b \u0432 \u0434\u043e\u043c\u0435 \u041c\u043e\u0435\u043c \u0431\u044b\u043b\u0430 \u043f\u0438\u0449\u0430, \u0438 \u0445\u043e\u0442\u044f \u0432 \u044d\u0442\u043e\u043c \u0438\u0441\u043f\u044b\u0442\u0430\u0439\u0442\u0435 \u041c\u0435\u043d\u044f, \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u0421\u0430\u0432\u0430\u043e\u0444: \u043d\u0435 \u043e\u0442\u043a\u0440\u043e\u044e \u043b\u0438 \u042f \u0434\u043b\u044f \u0432\u0430\u0441 \u043e\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u0439 \u043d\u0435\u0431\u0435\u0441\u043d\u044b\u0445 \u0438 \u043d\u0435 \u0438\u0437\u043e\u043b\u044c\u044e \u043b\u0438 \u043d\u0430 \u0432\u0430\u0441 \u0431\u043b\u0430\u0433\u043e\u0441\u043b\u043e\u0432\u0435\u043d\u0438\u044f \u0434\u043e \u0438\u0437\u0431\u044b\u0442\u043a\u0430?","notes":[]},{"id":"MAL.3.11","number":"11","text":"\u042f \u0434\u043b\u044f \u0432\u0430\u0441 \u0437\u0430\u043f\u0440\u0435\u0449\u0443 \u043f\u043e\u0436\u0438\u0440\u0430\u044e\u0449\u0438\u043c \u0438\u0441\u0442\u0440\u0435\u0431\u043b\u044f\u0442\u044c \u0443 \u0432\u0430\u0441 \u043f\u043b\u043e\u0434\u044b \u0437\u0435\u043c\u043d\u044b\u0435, \u0438 \u0432\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043d\u0430\u044f \u043b\u043e\u0437\u0430 \u043d\u0430 \u043f\u043e\u043b\u0435 \u0443 \u0432\u0430\u0441 \u043d\u0435 \u043b\u0438\u0448\u0438\u0442\u0441\u044f \u043f\u043b\u043e\u0434\u043e\u0432 \u0441\u0432\u043e\u0438\u0445, \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u0421\u0430\u0432\u0430\u043e\u0444.","notes":[]},{"id":"MAL.3.12","number":"12","text":"\u0418 \u0431\u043b\u0430\u0436\u0435\u043d\u043d\u044b\u043c\u0438 \u043d\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0431\u0443\u0434\u0443\u0442 \u0432\u0430\u0441 \u0432\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0432\u044b \u0431\u0443\u0434\u0435\u0442\u0435 \u0437\u0435\u043c\u043b\u0435\u044e \u0432\u043e\u0436\u0434\u0435\u043b\u0435\u043d\u043d\u043e\u044e, \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u0421\u0430\u0432\u0430\u043e\u0444.","notes":[]},{"id":"MAL.3.13","number":"13","text":"\u0414\u0435\u0440\u0437\u043e\u0441\u0442\u043d\u044b \u043f\u0440\u0435\u0434\u043e \u041c\u043d\u043e\u044e \u0441\u043b\u043e\u0432\u0430 \u0432\u0430\u0448\u0438, \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u0413\u043e\u0441\u043f\u043e\u0434\u044c. \u0412\u044b \u0441\u043a\u0430\u0436\u0435\u0442\u0435: \u201c\u0447\u0442\u043e \u043c\u044b \u0433\u043e\u0432\u043e\u0440\u0438\u043c \u043f\u0440\u043e\u0442\u0438\u0432 \u0422\u0435\u0431\u044f?\u201d","notes":[]},{"id":"MAL.3.14","number":"14","text":"\u0412\u044b \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u0435: \u201c\u0442\u0449\u0435\u0442\u043d\u043e \u0441\u043b\u0443\u0436\u0435\u043d\u0438\u0435 \u0411\u043e\u0433\u0443, \u0438 \u0447\u0442\u043e \u043f\u043e\u043b\u044c\u0437\u044b, \u0447\u0442\u043e \u043c\u044b \u0441\u043e\u0431\u043b\u044e\u0434\u0430\u043b\u0438 \u043f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f \u0415\u0433\u043e \u0438 \u0445\u043e\u0434\u0438\u043b\u0438 \u0432 \u043f\u0435\u0447\u0430\u043b\u044c\u043d\u043e\u0439 \u043e\u0434\u0435\u0436\u0434\u0435 \u043f\u0440\u0435\u0434 \u043b\u0438\u0446o\u043c \u0413\u043e\u0441\u043f\u043e\u0434\u0430 \u0421\u0430\u0432\u0430\u043e\u0444\u0430?","notes":[]},{"id":"MAL.3.15","number":"15","text":"\u0418 \u043d\u044b\u043d\u0435 \u043c\u044b \u0441\u0447\u0438\u0442\u0430\u0435\u043c \u043d\u0430\u0434\u043c\u0435\u043d\u043d\u044b\u0445 \u0441\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u044b\u043c\u0438: \u043b\u0443\u0447\u0448\u0435 \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u044e\u0442 \u0441\u0435\u0431\u044f \u0434\u0435\u043b\u0430\u044e\u0449\u0438\u0435 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u0438\u044f, \u0438 \u0445\u043e\u0442\u044f \u0438\u0441\u043a\u0443\u0448\u0430\u044e\u0442 \u0411\u043e\u0433\u0430, \u043d\u043e \u043e\u0441\u0442\u0430\u044e\u0442\u0441\u044f \u0446\u0435\u043b\u044b\u201d.","notes":[]},{"id":"MAL.3.16","number":"16","text":"\u041d\u043e \u0431\u043e\u044f\u0449\u0438\u0435\u0441\u044f \u0411\u043e\u0433\u0430 \u0433\u043e\u0432\u043e\u0440\u044f\u0442 \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0443: \u201c\u0432\u043d\u0438\u043c\u0430\u0435\u0442 \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u0438 \u0441\u043b\u044b\u0448\u0438\u0442 \u044d\u0442\u043e, \u0438 \u043f\u0440\u0435\u0434 \u043b\u0438\u0446o\u043c \u0415\u0433\u043e \u043f\u0438\u0448\u0435\u0442\u0441\u044f \u043f\u0430\u043c\u044f\u0442\u043d\u0430\u044f \u043a\u043d\u0438\u0433\u0430 \u043e \u0431\u043e\u044f\u0449\u0438\u0445\u0441\u044f \u0413\u043e\u0441\u043f\u043e\u0434\u0430 \u0438 \u0447\u0442\u0443\u0449\u0438\u0445 \u0438\u043c\u044f \u0415\u0433\u043e\u201d.","notes":[]},{"id":"MAL.3.17","number":"17","text":"\u0418 \u043e\u043d\u0438 \u0431\u0443\u0434\u0443\u0442 \u041c\u043e\u0438\u043c\u0438, \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u0421\u0430\u0432\u0430\u043e\u0444, \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u044c\u044e \u041c\u043e\u0435\u044e \u0432 \u0442\u043e\u0442 \u0434\u0435\u043d\u044c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u042f \u0441\u043e\u0434\u0435\u043b\u0430\u044e, \u0438 \u0431\u0443\u0434\u0443 \u043c\u0438\u043b\u043e\u0432\u0430\u0442\u044c \u0438\u0445, \u043a\u0430\u043a \u043c\u0438\u043b\u0443\u0435\u0442 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0441\u044b\u043d\u0430 \u0441\u0432\u043e\u0435\u0433\u043e, \u0441\u043b\u0443\u0436\u0430\u0449\u0435\u0433\u043e \u0435\u043c\u0443.","notes":[]},{"id":"MAL.3.18","number":"18","text":"\u0418 \u0442\u043e\u0433\u0434\u0430 \u0441\u043d\u043e\u0432\u0430 \u0443\u0432\u0438\u0434\u0438\u0442\u0435 \u0440\u0430\u0437\u043b\u0438\u0447\u0438\u0435 \u043c\u0435\u0436\u0434\u0443 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0438\u043a\u043e\u043c \u0438 \u043d\u0435\u0447\u0435\u0441\u0442\u0438\u0432\u044b\u043c, \u043c\u0435\u0436\u0434\u0443 \u0441\u043b\u0443\u0436\u0430\u0449\u0438\u043c \u0411\u043e\u0433\u0443 \u0438 \u043d\u0435 \u0441\u043b\u0443\u0436\u0430\u0449\u0438\u043c \u0415\u043c\u0443.","notes":[]}],"4":[{"id":"MAL.4.1","number":"1","text":"\u0418\u0431\u043e \u0432\u043e\u0442, \u043f\u0440\u0438\u0434\u0435\u0442 \u0434\u0435\u043d\u044c, \u043f\u044b\u043b\u0430\u044e\u0449\u0438\u0439 \u043a\u0430\u043a \u043f\u0435\u0447\u044c; \u0442\u043e\u0433\u0434\u0430 \u0432\u0441\u0435 \u043d\u0430\u0434\u043c\u0435\u043d\u043d\u044b\u0435 \u0438 \u043f\u043e\u0441\u0442\u0443\u043f\u0430\u044e\u0449\u0438\u0435 \u043d\u0435\u0447\u0435\u0441\u0442\u0438\u0432\u043e \u0431\u0443\u0434\u0443\u0442 \u043a\u0430\u043a \u0441\u043e\u043b\u043e\u043c\u0430, \u0438 \u043f\u043e\u043f\u0430\u043b\u0438\u0442 \u0438\u0445 \u0433\u0440\u044f\u0434\u0443\u0449\u0438\u0439 \u0434\u0435\u043d\u044c, \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u0421\u0430\u0432\u0430\u043e\u0444, \u0442\u0430\u043a \u0447\u0442\u043e \u043d\u0435 \u043e\u0441\u0442\u0430\u0432\u0438\u0442 \u0443 \u043d\u0438\u0445 \u043d\u0438 \u043a\u043e\u0440\u043d\u044f, \u043d\u0438 \u0432\u0435\u0442\u0432\u0435\u0439.","notes":[]},{"id":"MAL.4.2","number":"2","text":"\u0410 \u0434\u043b\u044f \u0432\u0430\u0441, \u0431\u043b\u0430\u0433\u043e\u0433\u043e\u0432\u0435\u044e\u0449\u0438\u0435 \u043f\u0440\u0435\u0434 \u0438\u043c\u0435\u043d\u0435\u043c \u041c\u043e\u0438\u043c, \u0432\u0437\u043e\u0439\u0434\u0435\u0442 \u0421\u043e\u043b\u043d\u0446\u0435 \u043f\u0440\u0430\u0432\u0434\u044b \u0438 \u0438\u0441\u0446\u0435\u043b\u0435\u043d\u0438\u0435 \u0432 \u043b\u0443\u0447\u0430\u0445 \u0415\u0433\u043e, \u0438 \u0432\u044b \u0432\u044b\u0439\u0434\u0435\u0442\u0435 \u0438 \u0432\u0437\u044b\u0433\u0440\u0430\u0435\u0442\u0435, \u043a\u0430\u043a \u0442\u0435\u043b\u044c\u0446\u044b \u0443\u043f\u0438\u0442\u0430\u043d\u043d\u044b\u0435,","notes":[]},{"id":"MAL.4.3","number":"3","text":"\u0438 \u0431\u0443\u0434\u0435\u0442\u0435 \u043f\u043e\u043f\u0438\u0440\u0430\u0442\u044c \u043d\u0435\u0447\u0435\u0441\u0442\u0438\u0432\u044b\u0445, \u0438\u0431\u043e \u043e\u043d\u0438 \u0431\u0443\u0434\u0443\u0442 \u043f\u0440\u0430\u0445\u043e\u043c \u043f\u043e\u0434 \u0441\u0442\u043e\u043f\u0430\u043c\u0438 \u043d\u043e\u0433 \u0432\u0430\u0448\u0438\u0445 \u0432 \u0442\u043e\u0442 \u0434\u0435\u043d\u044c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u042f \u0441\u043e\u0434\u0435\u043b\u0430\u044e, \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u0421\u0430\u0432\u0430\u043e\u0444.","notes":[]},{"id":"MAL.4.4","number":"4","text":"\u041f\u043e\u043c\u043d\u0438\u0442\u0435 \u0437\u0430\u043a\u043e\u043d \u041c\u043e\u0438\u0441\u0435\u044f, \u0440\u0430\u0431\u0430 \u041c\u043e\u0435\u0433\u043e, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u042f \u0437\u0430\u043f\u043e\u0432\u0435\u0434\u0430\u043b \u0435\u043c\u0443 \u043d\u0430 \u0425\u043e\u0440\u0438\u0432\u0435 \u0434\u043b\u044f \u0432\u0441\u0435\u0433\u043e \u0418\u0437\u0440\u0430\u0438\u043b\u044f, \u0440\u0430\u0432\u043d\u043e \u043a\u0430\u043a \u0438 \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u0438 \u0443\u0441\u0442\u0430\u0432\u044b.","notes":[]},{"id":"MAL.4.5","number":"5","text":"\u0412\u043e\u0442, \u042f \u043f\u043e\u0448\u043b\u044e \u043a \u0432\u0430\u043c \u0418\u043b\u0438\u044e, \u043f\u0440\u043e\u0440\u043e\u043a\u0430, \u043f\u0440\u0435\u0434 \u043d\u0430\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u0435\u043c \u0434\u043d\u044f \u0413\u043e\u0441\u043f\u043e\u0434\u043d\u044f, \u0432\u0435\u043b\u0438\u043a\u043e\u0433\u043e \u0438 \u0441\u0442\u0440\u0430\u0448\u043d\u043e\u0433\u043e.","notes":[]},{"id":"MAL.4.6","number":"6","text":"\u0418 \u043e\u043d \u043e\u0431\u0440\u0430\u0442\u0438\u0442 \u0441\u0435\u0440\u0434\u0446\u0430 \u043e\u0442\u0446\u043e\u0432 \u043a \u0434\u0435\u0442\u044f\u043c \u0438 \u0441\u0435\u0440\u0434\u0446\u0430 \u0434\u0435\u0442\u0435\u0439 \u043a \u043e\u0442\u0446\u0430\u043c \u0438\u0445, \u0447\u0442\u043e\u0431\u044b \u042f, \u043f\u0440\u0438\u0434\u044f, \u043d\u0435 \u043f\u043e\u0440\u0430\u0437\u0438\u043b \u0437\u0435\u043c\u043b\u0438 \u043f\u0440\u043e\u043a\u043b\u044f\u0442\u0438\u0435\u043c","notes":[]}]}}
