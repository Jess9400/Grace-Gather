{
  "name": "grace-gather",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // The app is one index.html; without this, addresses holding an encoded
    // character (such as an old "/verse/web:GEN.1.1" link) redirect in a loop.
    "html_handling": "none"
  },
  "previews": {}
}
