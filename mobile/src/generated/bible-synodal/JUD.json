{"book":{"code":"JUD","name":"\u041f\u043e\u0441\u043b\u0430\u043d\u0438\u0435 \u0418\u0443\u0434\u044b","chapters":1,"verses":25,"sourceBaseUrl":"https://ebible.org/russyn/","sourceChapterDigits":2,"sourceEdition":"\u0421\u0438\u043d\u043e\u0434\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u0435\u0440\u0435\u0432\u043e\u0434","sourceAttribution":"\u0421\u0438\u043d\u043e\u0434\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u0435\u0440\u0435\u0432\u043e\u0434 (Russian Synodal translation). Public domain. Text supplied by eBible.org. Six New Testament selections only.","sourceLicenseUrl":"https://ebible.org/russyn/copyright.htm"},"chapters":{"1":[{"id":"JUD.1.1","number":"1","text":"\u0418\u0443\u0434\u0430, \u0440\u0430\u0431 \u0418\u0438\u0441\u0443\u0441\u0430 \u0425\u0440\u0438\u0441\u0442\u0430, \u0431\u0440\u0430\u0442 \u0418\u0430\u043a\u043e\u0432\u0430, \u043f\u0440\u0438\u0437\u0432\u0430\u043d\u043d\u044b\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u0441\u0432\u044f\u0449\u0435\u043d\u044b \u0411\u043e\u0433\u043e\u043c \u041e\u0442\u0446\u043e\u043c \u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u044b \u0418\u0438\u0441\u0443\u0441\u043e\u043c \u0425\u0440\u0438\u0441\u0442\u043e\u043c:","notes":[]},{"id":"JUD.1.2","number":"2","text":"\u043c\u0438\u043b\u043e\u0441\u0442\u044c \u0432\u0430\u043c \u0438 \u043c\u0438\u0440 \u0438 \u043b\u044e\u0431\u043e\u0432\u044c \u0434\u0430 \u0443\u043c\u043d\u043e\u0436\u0430\u0442\u0441\u044f.","notes":[]},{"id":"JUD.1.3","number":"3","text":"\u0412\u043e\u0437\u043b\u044e\u0431\u043b\u0435\u043d\u043d\u044b\u0435! \u0418\u043c\u0435\u044f \u0432\u0441\u0435 \u0443\u0441\u0435\u0440\u0434\u0438\u0435 \u043f\u0438\u0441\u0430\u0442\u044c \u0432\u0430\u043c \u043e\u0431 \u043e\u0431\u0449\u0435\u043c \u0441\u043f\u0430\u0441\u0435\u043d\u0438\u0438, \u044f \u043f\u043e\u0447\u0435\u043b \u0437\u0430 \u043d\u0443\u0436\u043d\u043e\u0435 \u043d\u0430\u043f\u0438\u0441\u0430\u0442\u044c \u0432\u0430\u043c \u0443\u0432\u0435\u0449\u0430\u043d\u0438\u0435 - \u043f\u043e\u0434\u0432\u0438\u0437\u0430\u0442\u044c\u0441\u044f \u0437\u0430 \u0432\u0435\u0440\u0443, \u043e\u0434\u043d\u0430\u0436\u0434\u044b \u043f\u0440\u0435\u0434\u0430\u043d\u043d\u0443\u044e \u0441\u0432\u044f\u0442\u044b\u043c.","notes":[]},{"id":"JUD.1.4","number":"4","text":"\u0418\u0431\u043e \u0432\u043a\u0440\u0430\u043b\u0438\u0441\u044c \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043b\u044e\u0434\u0438, \u0438\u0437\u0434\u0440\u0435\u0432\u043b\u0435 \u043f\u0440\u0435\u0434\u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044b\u0435 \u043a \u0441\u0435\u043c\u0443 \u043e\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u044e, \u043d\u0435\u0447\u0435\u0441\u0442\u0438\u0432\u044b\u0435, \u043e\u0431\u0440\u0430\u0449\u0430\u044e\u0449\u0438\u0435 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0442\u044c \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0435\u0433\u043e \u0432 \u043f\u043e\u0432\u043e\u0434 \u043a \u0440\u0430\u0441\u043f\u0443\u0442\u0441\u0442\u0432\u0443 \u0438 \u043e\u0442\u0432\u0435\u0440\u0433\u0430\u044e\u0449\u0438\u0435\u0441\u044f \u0435\u0434\u0438\u043d\u043e\u0433\u043e \u0412\u043b\u0430\u0434\u044b\u043a\u0438 \u0411\u043e\u0433\u0430 \u0438 \u0413\u043e\u0441\u043f\u043e\u0434\u0430 \u043d\u0430\u0448\u0435\u0433\u043e \u0418\u0438\u0441\u0443\u0441\u0430 \u0425\u0440\u0438\u0441\u0442\u0430.","notes":[]},{"id":"JUD.1.5","number":"5","text":"\u042f \u0445\u043e\u0447\u0443 \u043d\u0430\u043f\u043e\u043c\u043d\u0438\u0442\u044c \u0432\u0430\u043c, \u0443\u0436\u0435 \u0437\u043d\u0430\u044e\u0449\u0438\u043c \u044d\u0442\u043e, \u0447\u0442\u043e \u0413\u043e\u0441\u043f\u043e\u0434\u044c, \u0438\u0437\u0431\u0430\u0432\u0438\u0432 \u043d\u0430\u0440\u043e\u0434 \u0438\u0437 \u0437\u0435\u043c\u043b\u0438 \u0415\u0433\u0438\u043f\u0435\u0442\u0441\u043a\u043e\u0439, \u043f\u043e\u0442\u043e\u043c \u043d\u0435\u0432\u0435\u0440\u043e\u0432\u0430\u0432\u0448\u0438\u0445 \u043f\u043e\u0433\u0443\u0431\u0438\u043b,","notes":[]},{"id":"JUD.1.6","number":"6","text":"\u0438 \u0430\u043d\u0433\u0435\u043b\u043e\u0432, \u043d\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0432\u0448\u0438\u0445 \u0441\u0432\u043e\u0435\u0433\u043e \u0434\u043e\u0441\u0442\u043e\u0438\u043d\u0441\u0442\u0432\u0430, \u043d\u043e \u043e\u0441\u0442\u0430\u0432\u0438\u0432\u0448\u0438\u0445 \u0441\u0432\u043e\u0435 \u0436\u0438\u043b\u0438\u0449\u0435, \u0441\u043e\u0431\u043b\u044e\u0434\u0430\u0435\u0442 \u0432 \u0432\u0435\u0447\u043d\u044b\u0445 \u0443\u0437\u0430\u0445, \u043f\u043e\u0434 \u043c\u0440\u0430\u043a\u043e\u043c, \u043d\u0430 \u0441\u0443\u0434 \u0432\u0435\u043b\u0438\u043a\u043e\u0433\u043e \u0434\u043d\u044f.","notes":[]},{"id":"JUD.1.7","number":"7","text":"\u041a\u0430\u043a \u0421\u043e\u0434\u043e\u043c \u0438 \u0413\u043e\u043c\u043e\u0440\u0440\u0430 \u0438 \u043e\u043a\u0440\u0435\u0441\u0442\u043d\u044b\u0435 \u0433\u043e\u0440\u043e\u0434\u0430, \u043f\u043e\u0434\u043e\u0431\u043d\u043e \u0438\u043c \u0431\u043b\u0443\u0434\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u043e\u0432\u0430\u0432\u0448\u0438\u0435 \u0438 \u0445\u043e\u0434\u0438\u0432\u0448\u0438\u0435 \u0437\u0430 \u0438\u043d\u043e\u044e \u043f\u043b\u043e\u0442\u0438\u044e, \u043f\u043e\u0434\u0432\u0435\u0440\u0433\u0448\u0438\u0441\u044c \u043a\u0430\u0437\u043d\u0438 \u043e\u0433\u043d\u044f \u0432\u0435\u0447\u043d\u043e\u0433\u043e, \u043f\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u044b \u0432 \u043f\u0440\u0438\u043c\u0435\u0440, -","notes":[]},{"id":"JUD.1.8","number":"8","text":"\u0442\u0430\u043a \u0442\u043e\u0447\u043d\u043e \u0431\u0443\u0434\u0435\u0442 \u0438 \u0441 \u0441\u0438\u043c\u0438 \u043c\u0435\u0447\u0442\u0430\u0442\u0435\u043b\u044f\u043c\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u0441\u043a\u0432\u0435\u0440\u043d\u044f\u044e\u0442 \u043f\u043b\u043e\u0442\u044c, \u043e\u0442\u0432\u0435\u0440\u0433\u0430\u044e\u0442 \u043d\u0430\u0447\u0430\u043b\u044c\u0441\u0442\u0432\u0430 \u0438 \u0437\u043b\u043e\u0441\u043b\u043e\u0432\u044f\u0442 \u0432\u044b\u0441\u043e\u043a\u0438\u0435 \u0432\u043b\u0430\u0441\u0442\u0438.","notes":[]},{"id":"JUD.1.9","number":"9","text":"\u041c\u0438\u0445\u0430\u0438\u043b \u0410\u0440\u0445\u0430\u043d\u0433\u0435\u043b, \u043a\u043e\u0433\u0434\u0430 \u0433\u043e\u0432\u043e\u0440\u0438\u043b \u0441 \u0434\u0438\u0430\u0432\u043e\u043b\u043e\u043c, \u0441\u043f\u043e\u0440\u044f \u043e \u041c\u043e\u0438\u0441\u0435\u0435\u0432\u043e\u043c \u0442\u0435\u043b\u0435, \u043d\u0435 \u0441\u043c\u0435\u043b \u043f\u0440\u043e\u0438\u0437\u043d\u0435\u0441\u0442\u0438 \u0443\u043a\u043e\u0440\u0438\u0437\u043d\u0435\u043d\u043d\u043e\u0433\u043e \u0441\u0443\u0434\u0430, \u043d\u043e \u0441\u043a\u0430\u0437\u0430\u043b: \u201c\u0414\u0430 \u0437\u0430\u043f\u0440\u0435\u0442\u0438\u0442 \u0442\u0435\u0431\u0435 \u0413\u043e\u0441\u043f\u043e\u0434\u044c\u201d.","notes":[]},{"id":"JUD.1.10","number":"10","text":"\u0410 \u0441\u0438\u0438 \u0437\u043b\u043e\u0441\u043b\u043e\u0432\u044f\u0442 \u0442\u043e, \u0447\u0435\u0433\u043e \u043d\u0435 \u0437\u043d\u0430\u044e\u0442; \u0447\u0442\u043e \u0436\u0435 \u043f\u043e \u043f\u0440\u0438\u0440\u043e\u0434\u0435, \u043a\u0430\u043a \u0431\u0435\u0441\u0441\u043b\u043e\u0432\u0435\u0441\u043d\u044b\u0435 \u0436\u0438\u0432\u043e\u0442\u043d\u044b\u0435, \u0437\u043d\u0430\u044e\u0442, \u0442\u0435\u043c \u0440\u0430\u0441\u0442\u043b\u0435\u0432\u0430\u044e\u0442 \u0441\u0435\u0431\u044f.","notes":[]},{"id":"JUD.1.11","number":"11","text":"\u0413\u043e\u0440\u0435 \u0438\u043c, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0438\u0434\u0443\u0442 \u043f\u0443\u0442\u0435\u043c \u041a\u0430\u0438\u043d\u043e\u0432\u044b\u043c, \u043f\u0440\u0435\u0434\u0430\u044e\u0442\u0441\u044f \u043e\u0431\u043e\u043b\u044c\u0449\u0435\u043d\u0438\u044e \u043c\u0437\u0434\u044b, \u043a\u0430\u043a \u0412\u0430\u043b\u0430\u0430\u043c, \u0438 \u0432 \u0443\u043f\u043e\u0440\u0441\u0442\u0432\u0435 \u043f\u043e\u0433\u0438\u0431\u0430\u044e\u0442, \u043a\u0430\u043a \u041a\u043e\u0440\u0435\u0439.","notes":[]},{"id":"JUD.1.12","number":"12","text":"\u0422\u0430\u043a\u043e\u0432\u044b\u0435 \u0431\u044b\u0432\u0430\u044e\u0442 \u0441\u043e\u0431\u043b\u0430\u0437\u043d\u043e\u043c \u043d\u0430 \u0432\u0430\u0448\u0438\u0445 \u0432\u0435\u0447\u0435\u0440\u044f\u0445 \u043b\u044e\u0431\u0432\u0438; \u043f\u0438\u0440\u0448\u0435\u0441\u0442\u0432\u0443\u044f \u0441 \u0432\u0430\u043c\u0438, \u0431\u0435\u0437 \u0441\u0442\u0440\u0430\u0445\u0430 \u0443\u0442\u0443\u0447\u043d\u044f\u044e\u0442 \u0441\u0435\u0431\u044f. \u042d\u0442\u043e \u0431\u0435\u0437\u0432\u043e\u0434\u043d\u044b\u0435 \u043e\u0431\u043b\u0430\u043a\u0430, \u043d\u043e\u0441\u0438\u043c\u044b\u0435 \u0432\u0435\u0442\u0440\u043e\u043c; \u043e\u0441\u0435\u043d\u043d\u0438\u0435 \u0434\u0435\u0440\u0435\u0432\u044c\u044f, \u0431\u0435\u0441\u043f\u043b\u043e\u0434\u043d\u044b\u0435, \u0434\u0432\u0430\u0436\u0434\u044b \u0443\u043c\u0435\u0440\u0448\u0438\u0435, \u0438\u0441\u0442\u043e\u0440\u0433\u043d\u0443\u0442\u044b\u0435;","notes":[]},{"id":"JUD.1.13","number":"13","text":"\u0441\u0432\u0438\u0440\u0435\u043f\u044b\u0435 \u043c\u043e\u0440\u0441\u043a\u0438\u0435 \u0432\u043e\u043b\u043d\u044b, \u043f\u0435\u043d\u044f\u0449\u0438\u0435\u0441\u044f \u0441\u0440\u0430\u043c\u043e\u0442\u0430\u043c\u0438 \u0441\u0432\u043e\u0438\u043c\u0438; \u0437\u0432\u0435\u0437\u0434\u044b \u0431\u043b\u0443\u0436\u0434\u0430\u044e\u0449\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u043c \u0431\u043b\u044e\u0434\u0435\u0442\u0441\u044f \u043c\u0440\u0430\u043a \u0442\u044c\u043c\u044b \u043d\u0430 \u0432\u0435\u043a\u0438.","notes":[]},{"id":"JUD.1.14","number":"14","text":"\u041e \u043d\u0438\u0445 \u043f\u0440\u043e\u0440\u043e\u0447\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u0438 \u0415\u043d\u043e\u0445, \u0441\u0435\u0434\u044c\u043c\u043e\u0439 \u043e\u0442 \u0410\u0434\u0430\u043c\u0430, \u0433\u043e\u0432\u043e\u0440\u044f: \u201c\u0421\u0435, \u0438\u0434\u0435\u0442 \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u0441\u043e \u0442\u044c\u043c\u0430\u043c\u0438 \u0441\u0432\u044f\u0442\u044b\u0445 \u0410\u043d\u0433\u0435\u043b\u043e\u0432 \u0421\u0432\u043e\u0438\u0445 -","notes":[]},{"id":"JUD.1.15","number":"15","text":"\u0441\u043e\u0442\u0432\u043e\u0440\u0438\u0442\u044c \u0441\u0443\u0434 \u043d\u0430\u0434 \u0432\u0441\u0435\u043c\u0438 \u0438 \u043e\u0431\u043b\u0438\u0447\u0438\u0442\u044c \u0432\u0441\u0435\u0445 \u043c\u0435\u0436\u0434\u0443 \u043d\u0438\u043c\u0438 \u043d\u0435\u0447\u0435\u0441\u0442\u0438\u0432\u044b\u0445 \u0432\u043e \u0432\u0441\u0435\u0445 \u0434\u0435\u043b\u0430\u0445, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u043b\u043e \u0438\u0445 \u043d\u0435\u0447\u0435\u0441\u0442\u0438\u0435, \u0438 \u0432\u043e \u0432\u0441\u0435\u0445 \u0436\u0435\u0441\u0442\u043e\u043a\u0438\u0445 \u0441\u043b\u043e\u0432\u0430\u0445, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u0440\u043e\u0438\u0437\u043d\u043e\u0441\u0438\u043b\u0438 \u043d\u0430 \u041d\u0435\u0433\u043e \u043d\u0435\u0447\u0435\u0441\u0442\u0438\u0432\u044b\u0435 \u0433\u0440\u0435\u0448\u043d\u0438\u043a\u0438\u201d.","notes":[]},{"id":"JUD.1.16","number":"16","text":"\u042d\u0442\u043e \u0440\u043e\u043f\u043e\u0442\u043d\u0438\u043a\u0438, \u043d\u0438\u0447\u0435\u043c \u043d\u0435 \u0434\u043e\u0432\u043e\u043b\u044c\u043d\u044b\u0435, \u043f\u043e\u0441\u0442\u0443\u043f\u0430\u044e\u0449\u0438\u0435 \u043f\u043e \u0441\u0432\u043e\u0438\u043c \u043f\u043e\u0445\u043e\u0442\u044f\u043c \u043d\u0435\u0447\u0435\u0441\u0442\u0438\u0432\u043e \u0438 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u043e; \u0443\u0441\u0442\u0430 \u0438\u0445 \u043f\u0440\u043e\u0438\u0437\u043d\u043e\u0441\u044f\u0442 \u043d\u0430\u0434\u0443\u0442\u044b\u0435 \u0441\u043b\u043e\u0432\u0430; \u043e\u043d\u0438 \u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u043b\u0438\u0446\u0435\u043f\u0440\u0438\u044f\u0442\u0438\u0435 \u0434\u043b\u044f \u043a\u043e\u0440\u044b\u0441\u0442\u0438.","notes":[]},{"id":"JUD.1.17","number":"17","text":"\u041d\u043e \u0432\u044b, \u0432\u043e\u0437\u043b\u044e\u0431\u043b\u0435\u043d\u043d\u044b\u0435, \u043f\u043e\u043c\u043d\u0438\u0442\u0435 \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u043d\u043d\u043e\u0435 \u0410\u043f\u043e\u0441\u0442\u043e\u043b\u0430\u043c\u0438 \u0413\u043e\u0441\u043f\u043e\u0434\u0430 \u043d\u0430\u0448\u0435\u0433\u043e \u0418\u0438\u0441\u0443\u0441\u0430 \u0425\u0440\u0438\u0441\u0442\u0430.","notes":[]},{"id":"JUD.1.18","number":"18","text":"\u041e\u043d\u0438 \u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0438 \u0432\u0430\u043c, \u0447\u0442\u043e \u0432 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0435 \u0432\u0440\u0435\u043c\u044f \u043f\u043e\u044f\u0432\u044f\u0442\u0441\u044f \u0440\u0443\u0433\u0430\u0442\u0435\u043b\u0438, \u043f\u043e\u0441\u0442\u0443\u043f\u0430\u044e\u0449\u0438\u0435 \u043f\u043e \u0441\u0432\u043e\u0438\u043c \u043d\u0435\u0447\u0435\u0441\u0442\u0438\u0432\u044b\u043c \u043f\u043e\u0445\u043e\u0442\u044f\u043c.","notes":[]},{"id":"JUD.1.19","number":"19","text":"\u042d\u0442\u043e \u043b\u044e\u0434\u0438, \u043e\u0442\u0434\u0435\u043b\u044f\u044e\u0449\u0438\u0435 \u0441\u0435\u0431\u044f \u043e\u0442 \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0430 \u0432\u0435\u0440\u044b, \u0434\u0443\u0448\u0435\u0432\u043d\u044b\u0435, \u043d\u0435 \u0438\u043c\u0435\u044e\u0449\u0438\u0435 \u0434\u0443\u0445\u0430.","notes":[]},{"id":"JUD.1.20","number":"20","text":"\u0410 \u0432\u044b, \u0432\u043e\u0437\u043b\u044e\u0431\u043b\u0435\u043d\u043d\u044b\u0435, \u043d\u0430\u0437\u0438\u0434\u0430\u044f \u0441\u0435\u0431\u044f \u043d\u0430 \u0441\u0432\u044f\u0442\u0435\u0439\u0448\u0435\u0439 \u0432\u0435\u0440\u0435 \u0432\u0430\u0448\u0435\u0439, \u043c\u043e\u043b\u044f\u0441\u044c \u0414\u0443\u0445\u043e\u043c \u0421\u0432\u044f\u0442\u044b\u043c,","notes":[]},{"id":"JUD.1.21","number":"21","text":"\u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0439\u0442\u0435 \u0441\u0435\u0431\u044f \u0432 \u043b\u044e\u0431\u0432\u0438 \u0411\u043e\u0436\u0438\u0435\u0439, \u043e\u0436\u0438\u0434\u0430\u044f \u043c\u0438\u043b\u043e\u0441\u0442\u0438 \u043e\u0442 \u0413\u043e\u0441\u043f\u043e\u0434\u0430 \u043d\u0430\u0448\u0435\u0433\u043e \u0418\u0438\u0441\u0443\u0441\u0430 \u0425\u0440\u0438\u0441\u0442\u0430, \u0434\u043b\u044f \u0432\u0435\u0447\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438.","notes":[]},{"id":"JUD.1.22","number":"22","text":"\u0418 \u043a \u043e\u0434\u043d\u0438\u043c \u0431\u0443\u0434\u044c\u0442\u0435 \u043c\u0438\u043b\u043e\u0441\u0442\u0438\u0432\u044b, \u0441 \u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u043d\u0438\u0435\u043c,","notes":[]},{"id":"JUD.1.23","number":"23","text":"\u0430 \u0434\u0440\u0443\u0433\u0438\u0445 \u0441\u0442\u0440\u0430\u0445\u043e\u043c \u0441\u043f\u0430\u0441\u0430\u0439\u0442\u0435, \u0438\u0441\u0442\u043e\u0440\u0433\u0430\u044f \u0438\u0437 \u043e\u0433\u043d\u044f, \u043e\u0431\u043b\u0438\u0447\u0430\u0439\u0442\u0435 \u0436\u0435 \u0441\u043e \u0441\u0442\u0440\u0430\u0445\u043e\u043c, \u0433\u043d\u0443\u0448\u0430\u044f\u0441\u044c \u0434\u0430\u0436\u0435 \u043e\u0434\u0435\u0436\u0434\u043e\u044e, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043e\u0441\u043a\u0432\u0435\u0440\u043d\u0435\u043d\u0430 \u043f\u043b\u043e\u0442\u044c\u044e.","notes":[]},{"id":"JUD.1.24","number":"24","text":"\u041c\u043e\u0433\u0443\u0449\u0435\u043c\u0443 \u0436\u0435 \u0441\u043e\u0431\u043b\u044e\u0441\u0442\u0438 \u0432\u0430\u0441 \u043e\u0442 \u043f\u0430\u0434\u0435\u043d\u0438\u044f \u0438 \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u043f\u0440\u0435\u0434 \u0441\u043b\u0430\u0432\u043e\u044e \u0421\u0432\u043e\u0435\u044e \u043d\u0435\u043f\u043e\u0440\u043e\u0447\u043d\u044b\u043c\u0438 \u0432 \u0440\u0430\u0434\u043e\u0441\u0442\u0438,","notes":[]},{"id":"JUD.1.25","number":"25","text":"\u0415\u0434\u0438\u043d\u043e\u043c\u0443 \u041f\u0440\u0435\u043c\u0443\u0434\u0440\u043e\u043c\u0443 \u0411\u043e\u0433\u0443, \u0421\u043f\u0430\u0441\u0438\u0442\u0435\u043b\u044e \u043d\u0430\u0448\u0435\u043c\u0443 \u0447\u0440\u0435\u0437 \u0418\u0438\u0441\u0443\u0441\u0430 \u0425\u0440\u0438\u0441\u0442\u0430 \u0413\u043e\u0441\u043f\u043e\u0434\u0430 \u043d\u0430\u0448\u0435\u0433\u043e, \u0441\u043b\u0430\u0432\u0430 \u0438 \u0432\u0435\u043b\u0438\u0447\u0438\u0435, \u0441\u0438\u043b\u0430 \u0438 \u0432\u043b\u0430\u0441\u0442\u044c \u043f\u0440\u0435\u0436\u0434\u0435 \u0432\u0441\u0435\u0445 \u0432\u0435\u043a\u043e\u0432, \u043d\u044b\u043d\u0435 \u0438 \u0432\u043e \u0432\u0441\u0435 \u0432\u0435\u043a\u0438. \u0410\u043c\u0438\u043d\u044c","notes":[]}]}}
