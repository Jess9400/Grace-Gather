:"4","text":"\u0447\u0442\u043e\u0431\u044b \u043a\u0430\u0436\u0434\u044b\u0439 \u0438\u0437 \u0432\u0430\u0441 \u0443\u043c\u0435\u043b \u0441\u043e\u0431\u043b\u044e\u0434\u0430\u0442\u044c \u0441\u0432\u043e\u0439 \u0441\u043e\u0441\u0443\u0434 \u0432 \u0441\u0432\u044f\u0442\u043e\u0441\u0442\u0438 \u0438 \u0447\u0435\u0441\u0442\u0438,","notes":[]},{"id":"1TH.4.5","number":"5","text":"\u0430 \u043d\u0435 \u0432 \u0441\u0442\u0440\u0430\u0441\u0442\u0438 \u043f\u043e\u0445\u043e\u0442\u0435\u043d\u0438\u044f, \u043a\u0430\u043a \u0438 \u044f\u0437\u044b\u0447\u043d\u0438\u043a\u0438, \u043d\u0435 \u0437\u043d\u0430\u044e\u0449\u0438\u0435 \u0411\u043e\u0433\u0430;","notes":[]},{"id":"1TH.4.6","number":"6","text":"\u0447\u0442\u043e\u0431\u044b \u0432\u044b \u043d\u0438 \u0432 \u0447\u0435\u043c \u043d\u0435 \u043f\u043e\u0441\u0442\u0443\u043f\u0430\u043b\u0438 \u0441 \u0431\u0440\u0430\u0442\u043e\u043c \u0441\u0432\u043e\u0438\u043c \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0437\u0430\u043a\u043e\u043d\u043d\u043e \u0438 \u043a\u043e\u0440\u044b\u0441\u0442\u043e\u043b\u044e\u0431\u0438\u0432\u043e: \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0413\u043e\u0441\u043f\u043e\u0434\u044c- \u043c\u0441\u0442\u0438\u0442\u0435\u043b\u044c \u0437\u0430 \u0432\u0441\u0435 \u044d\u0442\u043e, \u043a\u0430\u043a \u0438 \u043f\u0440\u0435\u0436\u0434\u0435 \u043c\u044b \u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0438 \u0432\u0430\u043c \u0438 \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0438.","notes":[]},{"id":"1TH.4.7","number":"7","text":"\u0418\u0431\u043e \u043f\u0440\u0438\u0437\u0432\u0430\u043b \u043d\u0430\u0441 \u0411\u043e\u0433 \u043d\u0435 \u043a \u043d\u0435\u0447\u0438\u0441\u0442\u043e\u0442\u0435, \u043d\u043e \u043a \u0441\u0432\u044f\u0442\u043e\u0441\u0442\u0438.","notes":[]},{"id":"1TH.4.8","number":"8","text":"\u0418\u0442\u0430\u043a \u043d\u0435\u043f\u043e\u043a\u043e\u0440\u043d\u044b\u0439 \u043d\u0435\u043f\u043e\u043a\u043e\u0440\u0435\u043d \u043d\u0435 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0443, \u043d\u043e \u0411\u043e\u0433\u0443, \u041a\u043e\u0442\u043e\u0440\u044b\u0439 \u0438 \u0434\u0430\u043b \u043d\u0430\u043c \u0414\u0443\u0445\u0430 \u0421\u0432\u043e\u0435\u0433\u043e \u0421\u0432\u044f\u0442\u0430\u0433\u043e.","notes":[]},{"id":"1TH.4.9","number":"9","text":"\u041e \u0431\u0440\u0430\u0442\u043e\u043b\u044e\u0431\u0438\u0438 \u0436\u0435 \u043d\u0435\u0442 \u043d\u0443\u0436\u0434\u044b \u043f\u0438\u0441\u0430\u0442\u044c \u043a \u0432\u0430\u043c; \u0438\u0431\u043e \u0432\u044b \u0441\u0430\u043c\u0438 \u043d\u0430\u0443\u0447\u0435\u043d\u044b \u0411\u043e\u0433\u043e\u043c \u043b\u044e\u0431\u0438\u0442\u044c \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430,","notes":[]},{"id":"1TH.4.10","number":"10","text":"\u0438\u0431\u043e \u0432\u044b \u0442\u0430\u043a \u0438 \u043f\u043e\u0441\u0442\u0443\u043f\u0430\u0435\u0442\u0435 \u0441\u043e \u0432\u0441\u0435\u043c\u0438 \u0431\u0440\u0430\u0442\u0438\u044f\u043c\u0438 \u043f\u043e \u0432\u0441\u0435\u0439 \u041c\u0430\u043a\u0435\u0434\u043e\u043d\u0438\u0438. \u0423\u043c\u043e\u043b\u044f\u0435\u043c \u0436\u0435 \u0432\u0430\u0441, \u0431\u0440\u0430\u0442\u0438\u044f, \u0431\u043e\u043b\u0435\u0435 \u043f\u0440\u0435\u0443\u0441\u043f\u0435\u0432\u0430\u0442\u044c","notes":[]},{"id":"1TH.4.11","number":"11","text":"\u0438 \u0443\u0441\u0435\u0440\u0434\u043d\u043e \u0441\u0442\u0430\u0440\u0430\u0442\u044c\u0441\u044f \u043e \u0442\u043e\u043c, \u0447\u0442\u043e\u0431\u044b \u0436\u0438\u0442\u044c \u0442\u0438\u0445\u043e, \u0434\u0435\u043b\u0430\u0442\u044c \u0441\u0432\u043e\u0435 \u0434\u0435\u043b\u043e \u0438 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u0441\u0432\u043e\u0438\u043c\u0438 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c\u0438 \u0440\u0443\u043a\u0430\u043c\u0438, \u043a\u0430\u043a \u043c\u044b \u0437\u0430\u043f\u043e\u0432\u0435\u0434\u044b\u0432\u0430\u043b\u0438 \u0432\u0430\u043c;","notes":[]},{"id":"1TH.4.12","number":"12","text":"\u0447\u0442\u043e\u0431\u044b \u0432\u044b \u043f\u043e\u0441\u0442\u0443\u043f\u0430\u043b\u0438 \u0431\u043b\u0430\u0433\u043e\u043f\u0440\u0438\u043b\u0438\u0447\u043d\u043e \u043f\u0435\u0440\u0435\u0434 \u0432\u043d\u0435\u0448\u043d\u0438\u043c\u0438 \u0438 \u043d\u0438 \u0432 \u0447\u0435\u043c \u043d\u0435 \u043d\u0443\u0436\u0434\u0430\u043b\u0438\u0441\u044c.","notes":[]},{"id":"1TH.4.13","number":"13","text":"\u041d\u0435 \u0445\u043e\u0447\u0443 \u0436\u0435 \u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0432\u0430\u0441, \u0431\u0440\u0430\u0442\u0438\u044f, \u0432 \u043d\u0435\u0432\u0435\u0434\u0435\u043d\u0438\u0438 \u043e\u0431 \u0443\u043c\u0435\u0440\u0448\u0438\u0445, \u0434\u0430\u0431\u044b \u0432\u044b \u043d\u0435 \u0441\u043a\u043e\u0440\u0431\u0435\u043b\u0438, \u043a\u0430\u043a \u043f\u0440\u043e\u0447\u0438\u0435, \u043d\u0435 \u0438\u043c\u0435\u044e\u0449\u0438\u0435 \u043d\u0430\u0434\u0435\u0436\u0434\u044b.","notes":[]},{"id":"1TH.4.14","number":"14","text":"\u0418\u0431\u043e \u0435\u0441\u043b\u0438 \u043c\u044b \u0432\u0435\u0440\u0443\u0435\u043c, \u0447\u0442\u043e \u0418\u0438\u0441\u0443\u0441 \u0443\u043c\u0435\u0440 \u0438 \u0432\u043e\u0441\u043a\u0440\u0435\u0441, \u0442\u043e \u0438 \u0443\u043c\u0435\u0440\u0448\u0438\u0445 \u0432 \u0418\u0438\u0441\u0443\u0441\u0435 \u0411\u043e\u0433 \u043f\u0440\u0438\u0432\u0435\u0434\u0435\u0442 \u0441 \u041d\u0438\u043c.","notes":[]},{"id":"1TH.4.15","number":"15","text":"\u0418\u0431\u043e \u0441\u0438\u0435 \u0433\u043e\u0432\u043e\u0440\u0438\u043c \u0432\u0430\u043c \u0441\u043b\u043e\u0432\u043e\u043c \u0413\u043e\u0441\u043f\u043e\u0434\u043d\u0438\u043c, \u0447\u0442\u043e \u043c\u044b, \u0436\u0438\u0432\u0443\u0449\u0438\u0435, \u043e\u0441\u0442\u0430\u0432\u0448\u0438\u0435\u0441\u044f \u0434\u043e \u043f\u0440\u0438\u0448\u0435\u0441\u0442\u0432\u0438\u044f \u0413\u043e\u0441\u043f\u043e\u0434\u043d\u044f, \u043d\u0435 \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0434\u0438\u043c \u0443\u043c\u0435\u0440\u0448\u0438\u0445,","notes":[]},{"id":"1TH.4.16","number":"16","text":"\u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0421\u0430\u043c \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u043f\u0440\u0438 \u0432\u043e\u0437\u0432\u0435\u0449\u0435\u043d\u0438\u0438, \u043f\u0440\u0438 \u0433\u043b\u0430\u0441\u0435 \u0410\u0440\u0445\u0430\u043d\u0433\u0435\u043b\u0430 \u0438 \u0442\u0440\u0443\u0431\u0435 \u0411\u043e\u0436\u0438\u0435\u0439, \u0441\u043e\u0439\u0434\u0435\u0442 \u0441 \u043d\u0435\u0431\u0430 \u0438 \u043c\u0435\u0440\u0442\u0432\u044b\u0435 \u0432\u043e \u0425\u0440\u0438\u0441\u0442\u0435 \u0432\u043e\u0441\u043a\u0440\u0435\u0441\u043d\u0443\u0442 \u043f\u0440\u0435\u0436\u0434\u0435;","notes":[]},{"id":"1TH.4.17","number":"17","text":"\u043f\u043e\u0442\u043e\u043c \u043c\u044b, \u043e\u0441\u0442\u0430\u0432\u0448\u0438\u0435\u0441\u044f \u0432 \u0436\u0438\u0432\u044b\u0445, \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u043d\u0438\u043c\u0438 \u0432\u043e\u0441\u0445\u0438\u0449\u0435\u043d\u044b \u0431\u0443\u0434\u0435\u043c \u043d\u0430 \u043e\u0431\u043b\u0430\u043a\u0430\u0445 \u0432 \u0441\u0440\u0435\u0442\u0435\u043d\u0438\u0435 \u0413\u043e\u0441\u043f\u043e\u0434\u0443 \u043d\u0430 \u0432\u043e\u0437\u0434\u0443\u0445\u0435, \u0438 \u0442\u0430\u043a \u0432\u0441\u0435\u0433\u0434\u0430 \u0441 \u0413\u043e\u0441\u043f\u043e\u0434\u043e\u043c \u0431\u0443\u0434\u0435\u043c.","notes":[]},{"id":"1TH.4.18","number":"18","text":"\u0418\u0442\u0430\u043a \u0443\u0442\u0435\u0448\u0430\u0439\u0442\u0435 \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430 \u0441\u0438\u043c\u0438 \u0441\u043b\u043e\u0432\u0430\u043c\u0438.","notes":[]}],"5":[{"id":"1TH.5.1","number":"1","text":"\u041e \u0432\u0440\u0435\u043c\u0435\u043d\u0430\u0445 \u0436\u0435 \u0438 \u0441\u0440\u043e\u043a\u0430\u0445 \u043d\u0435\u0442 \u043d\u0443\u0436\u0434\u044b \u043f\u0438\u0441\u0430\u0442\u044c \u043a \u0432\u0430\u043c, \u0431\u0440\u0430\u0442\u0438\u044f,","notes":[]},{"id":"1TH.5.2","number":"2","text":"\u0438\u0431\u043e \u0441\u0430\u043c\u0438 \u0432\u044b \u0434\u043e\u0441\u0442\u043e\u0432\u0435\u0440\u043d\u043e \u0437\u043d\u0430\u0435\u0442\u0435, \u0447\u0442\u043e \u0434\u0435\u043d\u044c \u0413\u043e\u0441\u043f\u043e\u0434\u0435\u043d\u044c \u0442\u0430\u043a \u043f\u0440\u0438\u0434\u0435\u0442, \u043a\u0430\u043a \u0442\u0430\u0442\u044c \u043d\u043e\u0447\u044c\u044e.","notes":[]},{"id":"1TH.5.3","number":"3","text":"\u0418\u0431\u043e, \u043a\u043e\u0433\u0434\u0430 \u0431\u0443\u0434\u0443\u0442 \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c: \u201c\u043c\u0438\u0440 \u0438 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u044c\u201d, \u0442\u043e\u0433\u0434\u0430 \u0432\u043d\u0435\u0437\u0430\u043f\u043d\u043e \u043f\u043e\u0441\u0442\u0438\u0433\u043d\u0435\u0442 \u0438\u0445 \u043f\u0430\u0433\u0443\u0431\u0430, \u043f\u043e\u0434\u043e\u0431\u043d\u043e \u043a\u0430\u043a \u043c\u0443\u043a\u0430 \u0440\u043e\u0434\u0430\u043c\u0438 \u043f\u043e\u0441\u0442\u0438\u0433\u0430\u0435\u0442 \u0438\u043c\u0435\u044e\u0449\u0443\u044e \u0432\u043e \u0447\u0440\u0435\u0432\u0435, \u0438 \u043d\u0435 \u0438\u0437\u0431\u0435\u0433\u043d\u0443\u0442.","notes":[]},{"id":"1TH.5.4","number":"4","text":"\u041d\u043e \u0432\u044b, \u0431\u0440\u0430\u0442\u0438\u044f, \u043d\u0435 \u0432\u043e \u0442\u044c\u043c\u0435, \u0447\u0442\u043e\u0431\u044b \u0434\u0435\u043d\u044c \u0437\u0430\u0441\u0442\u0430\u043b \u0432\u0430\u0441, \u043a\u0430\u043a \u0442\u0430\u0442\u044c.","notes":[]},{"id":"1TH.5.5","number":"5","text":"\u0418\u0431\u043e \u0432\u0441\u0435 \u0432\u044b - \u0441\u044b\u043d\u044b \u0441\u0432\u0435\u0442\u0430 \u0438 \u0441\u044b\u043d\u044b \u0434\u043d\u044f: \u043c\u044b - \u043d\u0435 \u0441\u044b\u043d\u044b \u043d\u043e\u0447\u0438, \u043d\u0438 \u0442\u044c\u043c\u044b.","notes":[]},{"id":"1TH.5.6","number":"6","text":"\u0418\u0442\u0430\u043a, \u043d\u0435 \u0431\u0443\u0434\u0435\u043c \u0441\u043f\u0430\u0442\u044c, \u043a\u0430\u043a \u0438 \u043f\u0440\u043e\u0447\u0438\u0435, \u043d\u043e \u0431\u0443\u0434\u0435\u043c \u0431\u043e\u0434\u0440\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u0438 \u0442\u0440\u0435\u0437\u0432\u0438\u0442\u044c\u0441\u044f.","notes":[]},{"id":"1TH.5.7","number":"7","text":"\u0418\u0431\u043e \u0441\u043f\u044f\u0449\u0438\u0435 \u0441\u043f\u044f\u0442 \u043d\u043e\u0447\u044c\u044e, \u0438 \u0443\u043f\u0438\u0432\u0430\u044e\u0449\u0438\u0435\u0441\u044f \u0443\u043f\u0438\u0432\u0430\u044e\u0442\u0441\u044f \u043d\u043e\u0447\u044c\u044e.","notes":[]},{"id":"1TH.5.8","number":"8","text":"\u041c\u044b \u0436\u0435, \u0431\u0443\u0434\u0443\u0447\u0438 \u0441\u044b\u043d\u0430\u043c\u0438 \u0434\u043d\u044f, \u0434\u0430 \u0442\u0440\u0435\u0437\u0432\u0438\u043c\u0441\u044f, \u043e\u0431\u043b\u0435\u043a\u0448\u0438\u0441\u044c \u0432 \u0431\u0440\u043e\u043d\u044e \u0432\u0435\u0440\u044b \u0438 \u043b\u044e\u0431\u0432\u0438 \u0438 \u0432 \u0448\u043b\u0435\u043c \u043d\u0430\u0434\u0435\u0436\u0434\u044b \u0441\u043f\u0430\u0441\u0435\u043d\u0438\u044f,","notes":[]},{"id":"1TH.5.9","number":"9","text":"\u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0411\u043e\u0433 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b \u043d\u0430\u0441 \u043d\u0435 \u043d\u0430 \u0433\u043d\u0435\u0432, \u043d\u043e \u043a \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044e \u0441\u043f\u0430\u0441\u0435\u043d\u0438\u044f \u0447\u0435\u0440\u0435\u0437 \u0413\u043e\u0441\u043f\u043e\u0434\u0430 \u043d\u0430\u0448\u0435\u0433\u043e \u0418\u0438\u0441\u0443\u0441\u0430 \u0425\u0440\u0438\u0441\u0442\u0430,","notes":[]},{"id":"1TH.5.10","number":"10","text":"\u0443\u043c\u0435\u0440\u0448\u0435\u0433\u043e \u0437\u0430 \u043d\u0430\u0441, \u0447\u0442\u043e\u0431\u044b \u043c\u044b \u0431\u043e\u0434\u0440\u0441\u0442\u0432\u0443\u0435\u043c \u043b\u0438, \u0438\u043b\u0438 \u0441\u043f\u0438\u043c, \u0436\u0438\u043b\u0438 \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u041d\u0438\u043c.","notes":[]},{"id":"1TH.5.11","number":"11","text":"\u041f\u043e\u0441\u0435\u043c\u0443 \u0443\u0432\u0435\u0449\u0435\u0432\u0430\u0439\u0442\u0435 \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430 \u0438 \u043d\u0430\u0437\u0438\u0434\u0430\u0439\u0442\u0435 \u043e\u0434\u0438\u043d \u0434\u0440\u0443\u0433\u043e\u0433\u043e, \u043a\u0430\u043a \u0432\u044b \u0438 \u0434\u0435\u043b\u0430\u0435\u0442\u0435.","notes":[]},{"id":"1TH.5.12","number":"12","text":"\u041f\u0440\u043e\u0441\u0438\u043c \u0436\u0435 \u0432\u0430\u0441, \u0431\u0440\u0430\u0442\u0438\u044f, \u0443\u0432\u0430\u0436\u0430\u0442\u044c \u0442\u0440\u0443\u0434\u044f\u0449\u0438\u0445\u0441\u044f \u0443 \u0432\u0430\u0441, \u0438 \u043f\u0440\u0435\u0434\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u0435\u0439 \u0432\u0430\u0448\u0438\u0445 \u0432 \u0413\u043e\u0441\u043f\u043e\u0434\u0435, \u0438 \u0432\u0440\u0430\u0437\u0443\u043c\u043b\u044f\u044e\u0449\u0438\u0445 \u0432\u0430\u0441,","notes":[]},{"id":"1TH.5.13","number":"13","text":"\u0438 \u043f\u043e\u0447\u0438\u0442\u0430\u0442\u044c \u0438\u0445 \u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u0441 \u043b\u044e\u0431\u043e\u0432\u044c\u044e \u0437\u0430 \u0434\u0435\u043b\u043e \u0438\u0445; \u0431\u0443\u0434\u044c\u0442\u0435 \u0432 \u043c\u0438\u0440\u0435 \u043c\u0435\u0436\u0434\u0443 \u0441\u043e\u0431\u043e\u044e.","notes":[]},{"id":"1TH.5.14","number":"14","text":"\u0423\u043c\u043e\u043b\u044f\u0435\u043c \u0442\u0430\u043a\u0436\u0435 \u0432\u0430\u0441, \u0431\u0440\u0430\u0442\u0438\u044f, \u0432\u0440\u0430\u0437\u0443\u043c\u043b\u044f\u0439\u0442\u0435 \u0431\u0435\u0441\u0447\u0438\u043d\u043d\u044b\u0445, \u0443\u0442\u0435\u0448\u0430\u0439\u0442\u0435 \u043c\u0430\u043b\u043e\u0434\u0443\u0448\u043d\u044b\u0445, \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435 \u0441\u043b\u0430\u0431\u044b\u0445, \u0431\u0443\u0434\u044c\u0442\u0435 \u0434\u043e\u043b\u0433\u043e\u0442\u0435\u0440\u043f\u0435\u043b\u0438\u0432\u044b \u043a\u043e \u0432\u0441\u0435\u043c.","notes":[]},{"id":"1TH.5.15","number":"15","text":"\u0421\u043c\u043e\u0442\u0440\u0438\u0442\u0435, \u0447\u0442\u043e\u0431\u044b \u043a\u0442\u043e \u043a\u043e\u043c\u0443 \u043d\u0435 \u0432\u043e\u0437\u0434\u0430\u0432\u0430\u043b \u0437\u043b\u043e\u043c \u0437\u0430 \u0437\u043b\u043e; \u043d\u043e \u0432\u0441\u0435\u0433\u0434\u0430 \u0438\u0449\u0438\u0442\u0435 \u0434\u043e\u0431\u0440\u0430 \u0438 \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0443 \u0438 \u0432\u0441\u0435\u043c.","notes":[]},{"id":"1TH.5.16","number":"16","text":"\u0412\u0441\u0435\u0433\u0434\u0430 \u0440\u0430\u0434\u0443\u0439\u0442\u0435\u0441\u044c.","notes":[]},{"id":"1TH.5.17","number":"17","text":"\u041d\u0435\u043f\u0440\u0435\u0441\u0442\u0430\u043d\u043d\u043e \u043c\u043e\u043b\u0438\u0442\u0435\u0441\u044c.","notes":[]},{"id":"1TH.5.18","number":"18","text":"\u0417\u0430 \u0432\u0441\u0435 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u0438\u0442\u0435: \u0438\u0431\u043e \u0442\u0430\u043a\u043e\u0432\u0430 \u043e \u0432\u0430\u0441 \u0432\u043e\u043b\u044f \u0411\u043e\u0436\u0438\u044f \u0432\u043e \u0425\u0440\u0438\u0441\u0442\u0435 \u0418\u0438\u0441\u0443\u0441\u0435.","notes":[]},{"id":"1TH.5.19","number":"19","text":"\u0414\u0443\u0445\u0430 \u043d\u0435 \u0443\u0433\u0430\u0448\u0430\u0439\u0442\u0435.","notes":[]},{"id":"1TH.5.20","number":"20","text":"\u041f\u0440\u043e\u0440\u043e\u0447\u0435\u0441\u0442\u0432\u0430 \u043d\u0435 \u0443\u043d\u0438\u0447\u0438\u0436\u0430\u0439\u0442\u0435.","notes":[]},{"id":"1TH.5.21","number":"21","text":"\u0412\u0441\u0435 \u0438\u0441\u043f\u044b\u0442\u044b\u0432\u0430\u0439\u0442\u0435, \u0445\u043e\u0440\u043e\u0448\u0435\u0433\u043e \u0434\u0435\u0440\u0436\u0438\u0442\u0435\u0441\u044c.","notes":[]},{"id":"1TH.5.22","number":"22","text":"\u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435\u0441\u044c \u043e\u0442 \u0432\u0441\u044f\u043a\u043e\u0433\u043e \u0440\u043e\u0434\u0430 \u0437\u043b\u0430.","notes":[]},{"id":"1TH.5.23","number":"23","text":"\u0421\u0430\u043c \u0436\u0435 \u0411\u043e\u0433 \u043c\u0438\u0440\u0430 \u0434\u0430 \u043e\u0441\u0432\u044f\u0442\u0438\u0442 \u0432\u0430\u0441 \u0432\u043e \u0432\u0441\u0435\u0439 \u043f\u043e\u043b\u043d\u043e\u0442\u0435, \u0438 \u0432\u0430\u0448 \u0434\u0443\u0445, \u0438 \u0434\u0443\u0448\u0430, \u0438 \u0442\u0435\u043b\u043e \u0432\u043e \u0432\u0441\u0435\u0439 \u0446\u0435\u043b\u043e\u0441\u0442\u0438 \u0434\u0430 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u0441\u044f \u0431\u0435\u0437 \u043f\u043e\u0440\u043e\u043a\u0430 \u0432 \u043f\u0440\u0438\u0448\u0435\u0441\u0442\u0432\u0438\u0435 \u0413\u043e\u0441\u043f\u043e\u0434\u0430 \u043d\u0430\u0448\u0435\u0433\u043e \u0418\u0438\u0441\u0443\u0441\u0430 \u0425\u0440\u0438\u0441\u0442\u0430.","notes":[]},{"id":"1TH.5.24","number":"24","text":"\u0412\u0435\u0440\u0435\u043d \u041f\u0440\u0438\u0437\u044b\u0432\u0430\u044e\u0449\u0438\u0439 \u0432\u0430\u0441, \u041a\u043e\u0442\u043e\u0440\u044b\u0439 \u0438 \u0441\u043e\u0442\u0432\u043e\u0440\u0438\u0442 \u0441\u0438\u0435.","notes":[]},{"id":"1TH.5.25","number":"25","text":"\u0411\u0440\u0430\u0442\u0438\u044f! \u043c\u043e\u043b\u0438\u0442\u0435\u0441\u044c \u043e \u043d\u0430\u0441.","notes":[]},{"id":"1TH.5.26","number":"26","text":"\u041f\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0439\u0442\u0435 \u0432\u0441\u0435\u0445 \u0431\u0440\u0430\u0442\u044c\u0435\u0432 \u043b\u043e\u0431\u0437\u0430\u043d\u0438\u0435\u043c \u0441\u0432\u044f\u0442\u044b