32\u0430\u0441 \u043f\u0440\u0435\u0434 \u0411\u043e\u0433\u043e\u043c \u043d\u0430\u0448\u0438\u043c,","notes":[]},{"id":"1TH.3.10","number":"10","text":"\u043d\u043e\u0447\u044c \u0438 \u0434\u0435\u043d\u044c \u0432\u0441\u0435\u0443\u0441\u0435\u0440\u0434\u043d\u043e \u043c\u043e\u043b\u044f\u0441\u044c \u043e \u0442\u043e\u043c, \u0447\u0442\u043e\u0431\u044b \u0432\u0438\u0434\u0435\u0442\u044c \u043b\u0438\u0446\u0435 \u0432\u0430\u0448\u0435 \u0438 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u044c, \u0447\u0435\u0433\u043e \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u0430\u043b\u043e \u0432\u0435\u0440\u0435 \u0432\u0430\u0448\u0435\u0439?","notes":[]},{"id":"1TH.3.11","number":"11","text":"\u0421\u0430\u043c \u0436\u0435 \u0411\u043e\u0433 \u0438 \u041e\u0442\u0435\u0446 \u043d\u0430\u0448 \u0438 \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u043d\u0430\u0448 \u0418\u0438\u0441\u0443\u0441 \u0425\u0440\u0438\u0441\u0442\u043e\u0441 \u0434\u0430 \u0443\u043f\u0440\u0430\u0432\u0438\u0442 \u043f\u0443\u0442\u044c \u043d\u0430\u0448 \u043a \u0432\u0430\u043c.","notes":[]},{"id":"1TH.3.12","number":"12","text":"\u0410 \u0432\u0430\u0441 \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u0434\u0430 \u0438\u0441\u043f\u043e\u043b\u043d\u0438\u0442 \u0438 \u043f\u0440\u0435\u0438\u0441\u043f\u043e\u043b\u043d\u0438\u0442 \u043b\u044e\u0431\u043e\u0432\u044c\u044e \u0434\u0440\u0443\u0433 \u043a \u0434\u0440\u0443\u0433\u0443 \u0438 \u043a\u043e \u0432\u0441\u0435\u043c, \u043a\u0430\u043a\u043e\u044e \u043c\u044b \u0438\u0441\u043f\u043e\u043b\u043d\u0435\u043d\u044b \u043a \u0432\u0430\u043c,","notes":[]},{"id":"1TH.3.13","number":"13","text":"\u0447\u0442\u043e\u0431\u044b \u0443\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044c \u0441\u0435\u0440\u0434\u0446\u0430 \u0432\u0430\u0448\u0438 \u043d\u0435\u043f\u043e\u0440\u043e\u0447\u043d\u044b\u043c\u0438 \u0432\u043e \u0441\u0432\u044f\u0442\u044b\u043d\u0435 \u043f\u0440\u0435\u0434 \u0411\u043e\u0433\u043e\u